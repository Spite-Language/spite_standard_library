var _sockets = DynamicLibrary("ws2_32.dll", 'identity', "")
var _memory_library = DynamicLibrary("ucrtbase.dll", 'identity', "")

func _open_handle(family: Integer): Long {
    var opened = _sockets.socket_as_long(family, 2, 17)
    if opened != -1 and family == _ipv6_family() {
        _allow_ipv4_too(opened)
    }
    return opened
}

func _bind(address: Buffer): Boolean {
    var length = _address_length(address)
    return _sockets.bind(handle, address, length) == 0
}

func _send(address: Buffer, room: Buffer, count: Integer): Integer {
    var length = _address_length(address)
    return _sockets.sendto(handle, room, count, 0, address, length)
}

func _receive_from(room: Buffer, count: Integer, sender: Buffer): Integer {
    var length_slot = Buffer(4)
    length_slot.append_integer_little_endian(28)
    return _sockets.recvfrom(handle, room, count, 0, sender, length_slot)
}

func _ready_now(): Boolean {
    var watched = Buffer(16)
    watched.append_long_little_endian(handle)
    watched.append_short_little_endian(768)
    watched.append_short_little_endian(0)
    watched.append_integer_little_endian(0)
    var ready = _sockets.WSAPoll(watched, 1, 0)
    return ready > 0
}

func _close_handle() {
    _sockets.closesocket(handle)
}

func _local_port(): Integer {
    var address = _empty_address()
    var length_slot = Buffer(4)
    length_slot.append_integer_little_endian(28)
    var asked = _sockets.getsockname(handle, address, length_slot)
    crash asked == 0
    return _read_port(address)
}

func _start_sockets() {
    var information = Buffer(512)
    _sockets.WSAStartup(514, information)
}

func _ipv4_family(): Integer {
    return 2
}

func _ipv6_family(): Integer {
    return 23
}

func _allow_ipv4_too(opened: Long) {
    var disabled = _zeroed(4)
    _sockets.setsockopt(opened, 41, 27, disabled, 4)
}

func _resolve_name(host: String, hints: Buffer, found: Buffer): Integer {
    var no_service: Long = 0
    var answer = _sockets.getaddrinfo(host, no_service, hints, found)
    found.take_written(8)
    return answer
}

func _resolved_address_offset(): Integer {
    return 32
}

func _next_entry_offset(): Integer {
    return 40
}

func _read_foreign(place: Long, bytes: Integer): Buffer {
    var room = Buffer(bytes)
    var wanted: Long = bytes
    _memory_library.memcpy(room, place, wanted)
    room.take_written(bytes)
    return room
}

func _free_resolved(first: Long) {
    _sockets.freeaddrinfo(first)
}
