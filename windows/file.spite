var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func exists(): Boolean {
    var wide_path = path._to_wide()
    var attributes = kernel.GetFileAttributesW(wide_path)
    return attributes != -1 and attributes.bits_and(16) == 0
}

func remove(): Boolean {
    var wide_path = path._to_wide()
    var removed = library._wremove(wide_path)
    return removed == 0
}

func _rename_to(new_path: String): Boolean {
    var copy_across_volumes = 2
    var wide_path = path._to_wide()
    var wide_new_path = new_path._to_wide()
    var moved = kernel.MoveFileExW(wide_path, wide_new_path, copy_across_volumes)
    return moved != 0
}

func lock(): LockedFile? {
    var read_and_write = -1073741824
    var share_everything = 7
    var open_always = 4
    var normal = 128
    var nothing: Long = 0
    var wide_path = path._to_wide()
    var handle = kernel.CreateFileW_as_long(wide_path, read_and_write, share_everything, nothing, open_always, normal, nothing)
    fallback handle != -1
    var locked = LockedFile(handle)
    var held = locked._is_held()
    fallback held
    return locked
}

func _open_handle(mode: String): Long {
    var wide_path = path._to_wide()
    var wide_mode = mode._to_wide()
    return library._wfopen_as_long(wide_path, wide_mode)
}

func _close_handle(handle: Long): Integer {
    return library.fclose(handle)
}

func _seek(handle: Long, offset: Long, origin: Integer): Integer {
    return library._fseeki64(handle, offset, origin)
}

func _tell(handle: Long): Long {
    return library._ftelli64_as_long(handle)
}

func _read_into(room: Buffer, bytes: Long, handle: Long): Long {
    var one: Long = 1
    return library.fread_as_long(room, one, bytes, handle)
}

func _write_from(room: Buffer, bytes: Long, handle: Long): Long {
    var one: Long = 1
    return library.fwrite_as_long(room, one, bytes, handle)
}

func _write_text(text: String, handle: Long): Long {
    var one: Long = 1
    var length: Long = text.length()
    return library.fwrite_as_long(text, one, length, handle)
}

func _modified_nanoseconds_since_1970(): Long? {
    var data = Buffer(40)
    var index = 0
    while index < 40 {
        data.append(0)
        index = index + 1
    }
    var standard_information = 0
    var wide_path = path._to_wide()
    var found = kernel.GetFileAttributesExW(wide_path, standard_information, data)
    fallback found != 0
    var written = data.read_long_little_endian_at(20)
    fallback written
    var since_1970 = written - 116444736000000000
    return since_1970 * 100
}
