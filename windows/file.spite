var _hundred_nanoseconds_from_1601_to_1970: Long = 116444736000000000

func exists(): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            var found = place._preloaded_file_index()
            if found {
                return true
            }
            return false
        }
    }
    var wide_path = path._to_wide()
    var attributes = _file_attributes(wide_path)
    return attributes != -1 and attributes.bits_and(16) == 0
}

func remove(): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var wide_path = path._to_wide()
    var removed = _remove_file(wide_path)
    return removed == 0
}

func _rename_to(new_path: String): Boolean {
    var copy_across_volumes = 2
    var wide_path = path._to_wide()
    var wide_new_path = new_path._to_wide()
    var moved = _move_file(wide_path, wide_new_path, copy_across_volumes)
    return moved != 0
}

func lock(): LockedFile? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var read_and_write = -1073741824
    var share_everything = 7
    var open_always = 4
    var normal = 128
    var nothing: Long = 0
    var wide_path = path._to_wide()
    var handle = _create_file(
        wide_path,
        read_and_write,
        share_everything,
        nothing,
        open_always,
        normal,
        nothing,
    )
    fallback handle != -1
    var locked = LockedFile(handle)
    var held = locked._is_held()
    fallback held
    return locked
}

func _open_handle(mode: String): Long {
    var wide_path = path._to_wide()
    var wide_mode = mode._to_wide()
    return _open_file(wide_path, wide_mode)
}

func _close_handle(handle: Long): Integer {
    var call = DynamicLibrary.Call(library.functions["close_handle"])
    call.arguments["handle"] = handle
    return call.call()
}

func _seek(handle: Long, offset: Long, origin: Integer): Integer {
    var call = DynamicLibrary.Call(library.functions["seek"])
    call.arguments["handle"] = handle
    call.arguments["offset"] = offset
    call.arguments["origin"] = origin
    return call.call()
}

func _tell(handle: Long): Long {
    var call = DynamicLibrary.Call(library.functions["tell"])
    call.arguments["handle"] = handle
    return call.call()
}

func _read_bytes(count: Long, handle: Long): Buffer? {
    var call = DynamicLibrary.Call(library.functions["read_bytes"])
    call.arguments["size"] = 1
    call.arguments["count"] = count
    call.arguments["handle"] = handle
    var read = call.call()
    fallback read
    return read.bytes.to_buffer()
}

func _write_from(room: Buffer, bytes: Long, handle: Long): Long {
    var one: Long = 1
    return _write_items(room, one, bytes, handle)
}

func _write_text(text: String, handle: Long): Long {
    var one: Long = 1
    var length: Long = text.length()
    return _write_text_items(text, one, length, handle)
}

func _modified_nanoseconds_since_1970(): Long? {
    var data = Buffer(40)
    var index = 0
    while index < 40 {
        data.append(0)
        index = index + 1
    }
    var standard_information = 0
    var wide_path = path._to_wide()
    var found = _file_attributes_of(wide_path, standard_information, data)
    fallback found != 0
    var written = data.read_long_little_endian_at(20)
    fallback written
    var since_1970 = written - _hundred_nanoseconds_from_1601_to_1970
    return since_1970 * 100
}

