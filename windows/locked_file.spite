var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var _overlapped = Buffer(32)
var _held = false
var _handle: Long

func LockedFile(handle: Long) {
    _handle = handle
    var index = 0
    while index < 32 {
        _overlapped.append(0)
        index = index + 1
    }
    var exclusive = 2
    var reserved = 0
    var every_byte = -1
    var locked = _lock_file(_handle, exclusive, reserved, every_byte, every_byte, _overlapped)
    _held = locked != 0
    if not _held {
        _close_handle(_handle)
        _handle = 0
    }
}

func _is_held(): Boolean {
    return _held
}

func unlock() {
    if _held {
        var reserved = 0
        var every_byte = -1
        _unlock_file(_handle, reserved, every_byte, every_byte, _overlapped)
        _close_handle(_handle)
        _handle = 0
        _held = false
    }
}

func drop() {
    unlock()
}

func _lock_file(
    handle: Long,
    flags: Integer,
    reserved: Integer,
    low_count: Integer,
    high_count: Integer,
    overlapped: Buffer,
): Integer {
    return kernel.LockFileEx(handle, flags, reserved, low_count, high_count, overlapped)
}

func _unlock_file(
    handle: Long,
    reserved: Integer,
    low_count: Integer,
    high_count: Integer,
    overlapped: Buffer,
){
    kernel.UnlockFileEx(handle, reserved, low_count, high_count, overlapped)
}

func _close_handle(handle: Long){
    kernel.CloseHandle(handle)
}
