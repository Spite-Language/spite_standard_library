var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var _handle: Long = 0
var _overlapped = Buffer(32)
var _held = false

func LockedFile(handle: Long) {
    _handle = handle
    var index = 0
    while index < 32 {
        _overlapped.append(0)
        index = index + 1
    }
    var exclusive = 2
    var reserved = 0
    var every_byte = -1
    var locked = kernel.LockFileEx(_handle, exclusive, reserved, every_byte, every_byte, _overlapped)
    _held = locked != 0
    if not _held {
        kernel.CloseHandle(_handle)
        _handle = 0
    }
}

func _is_held(): Boolean {
    return _held
}

func unlock() {
    if _held {
        var reserved = 0
        var every_byte = -1
        kernel.UnlockFileEx(_handle, reserved, every_byte, every_byte, _overlapped)
        kernel.CloseHandle(_handle)
        _handle = 0
        _held = false
    }
}

func drop() {
    unlock()
}
