var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "lock_file": DynamicLibrary.FunctionDeclaration(
            "LockFileEx",
            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("flags", Integer),
                DynamicLibrary.Argument("reserved", Integer),
                DynamicLibrary.Argument("low_count", Integer),
                DynamicLibrary.Argument("high_count", Integer),
                DynamicLibrary.Argument("overlapped", Buffer),
            ],
            Integer,
        ),
        "unlock_file": DynamicLibrary.FunctionDeclaration(
            "UnlockFileEx",
            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("reserved", Integer),
                DynamicLibrary.Argument("low_count", Integer),
                DynamicLibrary.Argument("high_count", Integer),
                DynamicLibrary.Argument("overlapped", Buffer),
            ],
            Nothing,
        ),
        "close_handle": DynamicLibrary.FunctionDeclaration(
            "CloseHandle",
            [
                DynamicLibrary.Argument("handle", Long),
            ],
            Nothing,
        ),
    },
)
var _overlapped = Buffer(32)
var _held = false
var _handle: Long

func LockedFile(handle: Long) {
    _handle = handle
    var index = 0
    while index < 32 {
        _overlapped.append(0)
        index = index + 1
    }
    var exclusive = 2
    var reserved = 0
    var every_byte = -1
    var locked = _lock_file(_handle, exclusive, reserved, every_byte, every_byte, _overlapped)
    _held = locked != 0
    if not _held {
        _close_handle(_handle)
        _handle = 0
    }
}

func _is_held(): Boolean {
    return _held
}

func unlock() {
    if _held {
        var reserved = 0
        var every_byte = -1
        _unlock_file(_handle, reserved, every_byte, every_byte, _overlapped)
        _close_handle(_handle)
        _handle = 0
        _held = false
    }
}

func drop() {
    unlock()
}

func _lock_file(
    handle: Long,
    flags: Integer,
    reserved: Integer,
    low_count: Integer,
    high_count: Integer,
    overlapped: Buffer,
): Integer {
    var call = DynamicLibrary.Call(kernel.functions["lock_file"])
    call.arguments["handle"] = handle
    call.arguments["flags"] = flags
    call.arguments["reserved"] = reserved
    call.arguments["low_count"] = low_count
    call.arguments["high_count"] = high_count
    call.arguments["overlapped"] = overlapped
    return call.call()
}

func _unlock_file(
    handle: Long,
    reserved: Integer,
    low_count: Integer,
    high_count: Integer,
    overlapped: Buffer,
) {
    var call = DynamicLibrary.Call(kernel.functions["unlock_file"])
    call.arguments["handle"] = handle
    call.arguments["reserved"] = reserved
    call.arguments["low_count"] = low_count
    call.arguments["high_count"] = high_count
    call.arguments["overlapped"] = overlapped
    call.call()
}

func _close_handle(handle: Long) {
    var call = DynamicLibrary.Call(kernel.functions["close_handle"])
    call.arguments["handle"] = handle
    call.call()
}
