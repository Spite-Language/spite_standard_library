var _icu = DynamicLibrary(
    "icu.dll",
    "",
    {
        "close_calendar": DynamicLibrary.FunctionDeclaration(
            "ucal_close",
            [
                DynamicLibrary.Argument("calendar", Long),
            ],
            Nothing,
        ),
        "set_milliseconds": DynamicLibrary.FunctionDeclaration(
            "ucal_setMillis",
            [
                DynamicLibrary.Argument("calendar", Long),
                DynamicLibrary.Argument("milliseconds", Double),
                DynamicLibrary.Argument("status", Buffer),
            ],
            Nothing,
        ),
        "calendar_field": DynamicLibrary.FunctionDeclaration(
            "ucal_get",
            [
                DynamicLibrary.Argument("calendar", Long),
                DynamicLibrary.Argument("field", Integer),
                DynamicLibrary.Argument("status", Buffer),
            ],
            Integer,
        ),
        "canonical_time_zone_identifier": DynamicLibrary.FunctionDeclaration(
            "ucal_getCanonicalTimeZoneID",
            [
                DynamicLibrary.Argument("identifier", Buffer),
                DynamicLibrary.Argument("length", Integer),
                DynamicLibrary.Argument("canonical", Buffer),
                DynamicLibrary.Argument("capacity", Integer),
                DynamicLibrary.Argument("is_system", Buffer),
                DynamicLibrary.Argument("status", Buffer),
            ],
            Nothing,
        ),
        "calendar_of": DynamicLibrary.FunctionDeclaration(
            "ucal_open",
            [
                DynamicLibrary.Argument("identifier", Buffer),
                DynamicLibrary.Argument("length", Integer),
                DynamicLibrary.Argument("locale", String),
                DynamicLibrary.Argument("kind", Integer),
                DynamicLibrary.Argument("status", Buffer),
            ],
            Long,
        ),
        "default_time_zone": DynamicLibrary.FunctionDeclaration(
            "ucal_getDefaultTimeZone",
            [
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("capacity", Integer),
                DynamicLibrary.Argument("status", Buffer),
            ],
            Integer,
        ),
    },
)
var _calendar: Long = 0
var _status = Buffer(0)
var _earliest_icu_calendar_second: Long = -184303902528000
var _latest_icu_calendar_second: Long = 183882168921600
var _largest_ascii_code = 127

func _offset_seconds_at_unix(unix_seconds: Long): Integer {
    if _calendar != 0 {
        return _calendar_offset_seconds_at(unix_seconds)
    }
    return _transition_offset_seconds_at(unix_seconds)
}

func _open_calendar(): Boolean {
    _status = Buffer(4)
    _status.append_integer_little_endian(0)
    if _identifier.is_empty() {
        var default_identifier = _default_identifier()
        fallback default_identifier
        _identifier = default_identifier
    }
    _calendar = _opened_calendar()
    return _calendar != 0
}

func drop() {
    if _calendar != 0 {
        _close_calendar(_calendar)
    }
}

func _calendar_offset_seconds_at(unix_seconds: Long): Integer {
    crash _calendar != 0
    crash unix_seconds >= _earliest_icu_calendar_second and unix_seconds <= _latest_icu_calendar_second
    _clear_status()
    var milliseconds: Double = unix_seconds * 1000
    _set_milliseconds(_calendar, milliseconds, _status)
    var zone = _calendar_field(_calendar, 15, _status)
    var daylight = _calendar_field(_calendar, 16, _status)
    var status = _status_value()
    crash status <= 0
    return (zone + daylight) / 1000
}

func _clear_status() {
    _status.write_integer_little_endian_at(0, 0)
}

func _status_value(): Integer {
    var held = _status.read_integer_little_endian_at(0)
    crash held
    return held
}

func _zeroed(size: Integer): Buffer {
    var room = Buffer(size)
    var index = 0
    while index < size {
        room.append(0)
        index = index + 1
    }
    return room
}

func _opened_calendar(): Long {
    var length = _identifier.length()
    var characters = Buffer(length * 2 + 2)
    var index = 0
    while index < length {
        var code = _identifier.byte_at(index)
        fallback code <= _largest_ascii_code
        var unit: UnsignedShort? = code
        crash unit
        characters.append_unsigned_short_little_endian(unit)
        index = index + 1
    }
    var is_system = _zeroed(4)
    var canonical = _zeroed(512)
    _clear_status()
    _canonical_time_zone_identifier(characters, length, canonical, 256, is_system, _status)
    var canonical_status = _status_value()
    var system_flag = is_system[0]
    crash system_flag
    var handle: Long = 0
    if canonical_status <= 0 and system_flag != 0 {
        handle = _calendar_of(characters, length, "", 1, _status)
        var open_status = _status_value()
        if open_status > 0 {
            handle = 0
        }
    }
    return handle
}

func _default_identifier(): String? {
    var characters = _zeroed(512)
    _clear_status()
    var length = _default_time_zone(characters, 256, _status)
    var status = _status_value()
    fallback status <= 0 and length >= 0 and length <= 256
    var identifier = String()
    var index = 0
    while index < length {
        var held = characters.read_unsigned_short_little_endian_at(index * 2)
        crash held
        var code: Integer = held
        identifier.append_code(code)
        index = index + 1
    }
    return identifier
}

func _close_calendar(calendar: Long) {
    var call = DynamicLibrary.Call(_icu.functions["close_calendar"])
    call.arguments["calendar"] = calendar
    call.call()
}

func _set_milliseconds(calendar: Long, milliseconds: Double, status: Buffer) {
    var call = DynamicLibrary.Call(_icu.functions["set_milliseconds"])
    call.arguments["calendar"] = calendar
    call.arguments["milliseconds"] = milliseconds
    call.arguments["status"] = status
    call.call()
}

func _calendar_field(calendar: Long, field: Integer, status: Buffer): Integer {
    var call = DynamicLibrary.Call(_icu.functions["calendar_field"])
    call.arguments["calendar"] = calendar
    call.arguments["field"] = field
    call.arguments["status"] = status
    return call.call()
}

func _canonical_time_zone_identifier(
    identifier: Buffer,
    length: Integer,
    canonical: Buffer,
    capacity: Integer,
    is_system: Buffer,
    status: Buffer,
) {
    var call = DynamicLibrary.Call(_icu.functions["canonical_time_zone_identifier"])
    call.arguments["identifier"] = identifier
    call.arguments["length"] = length
    call.arguments["canonical"] = canonical
    call.arguments["capacity"] = capacity
    call.arguments["is_system"] = is_system
    call.arguments["status"] = status
    call.call()
}

func _calendar_of(identifier: Buffer, length: Integer, locale: String, kind: Integer, status: Buffer): Long {
    var call = DynamicLibrary.Call(_icu.functions["calendar_of"])
    call.arguments["identifier"] = identifier
    call.arguments["length"] = length
    call.arguments["locale"] = locale
    call.arguments["kind"] = kind
    call.arguments["status"] = status
    return call.call()
}

func _default_time_zone(room: Buffer, capacity: Integer, status: Buffer): Integer {
    var call = DynamicLibrary.Call(_icu.functions["default_time_zone"])
    call.arguments["room"] = room
    call.arguments["capacity"] = capacity
    call.arguments["status"] = status
    return call.call()
}
