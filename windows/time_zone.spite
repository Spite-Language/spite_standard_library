var _icu: DynamicLibrary? = null
var _calendar: Long = 0
var _status = Buffer(0)

func _offset_seconds_at_unix(unix_seconds: Long): Integer {
    if _calendar != 0 {
        return _calendar_offset_seconds_at(unix_seconds)
    }
    return _transition_offset_seconds_at(unix_seconds)
}

func _open_calendar(): Boolean {
    var icu = DynamicLibrary("icu.dll", 'identity', "")
    _icu = icu
    _status = Buffer(4)
    _status.append_integer_little_endian(0)
    if _identifier.is_empty() {
        var default_identifier = _default_identifier()
        fallback default_identifier
        _identifier = default_identifier
    }
    _calendar = _opened_calendar()
    return _calendar != 0
}

func drop() {
    var icu = _icu
    if icu and _calendar != 0 {
        icu.ucal_close(_calendar)
    }
}

func _calendar_offset_seconds_at(unix_seconds: Long): Integer {
    var icu = _icu
    crash icu and _calendar != 0
    crash unix_seconds >= -184303902528000 and unix_seconds <= 183882168921600
    _clear_status()
    var milliseconds: Double = unix_seconds * 1000
    icu.ucal_setMillis(_calendar, milliseconds, _status)
    var zone = icu.ucal_get(_calendar, 15, _status)
    var daylight = icu.ucal_get(_calendar, 16, _status)
    var status = _status_value()
    crash status <= 0
    return (zone + daylight) / 1000
}

func _clear_status() {
    _status.write_integer_little_endian_at(0, 0)
}

func _status_value(): Integer {
    var held = _status.read_integer_little_endian_at(0)
    crash held
    return held
}

func _zeroed(size: Integer): Buffer {
    var room = Buffer(size)
    var index = 0
    while index < size {
        room.append(0)
        index = index + 1
    }
    return room
}

func _opened_calendar(): Long {
    var icu = _icu
    crash icu
    var length = _identifier.length()
    var characters = Buffer(length * 2 + 2)
    var index = 0
    while index < length {
        var code = _identifier.byte_at(index)
        fallback code <= 127
        var unit = code.to_unsigned_short()
        characters.append_unsigned_short_little_endian(unit)
        index = index + 1
    }
    var is_system = _zeroed(4)
    var canonical = _zeroed(512)
    _clear_status()
    icu.ucal_getCanonicalTimeZoneID(characters, length, canonical, 256, is_system, _status)
    var canonical_status = _status_value()
    var system_flag = is_system[0]
    crash system_flag
    var handle: Long = 0
    if canonical_status <= 0 and system_flag != 0 {
        handle = icu.ucal_open_as_long(characters, length, "", 1, _status)
        var open_status = _status_value()
        if open_status > 0 {
            handle = 0
        }
    }
    return handle
}

func _default_identifier(): String? {
    var icu = _icu
    crash icu
    var characters = _zeroed(512)
    _clear_status()
    var length = icu.ucal_getDefaultTimeZone(characters, 256, _status)
    var status = _status_value()
    fallback status <= 0 and length >= 0 and length <= 256
    var identifier = String()
    var index = 0
    while index < length {
        var held = characters.read_unsigned_short_little_endian_at(index * 2)
        crash held
        var code: Integer = held
        identifier.append_code(code)
        index = index + 1
    }
    return identifier
}
