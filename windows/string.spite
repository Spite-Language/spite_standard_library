var _winsock_version_2_2 = 514
var _utf8_code_page = 65001

func resolve_ip_addresses(): List<IpAddress> {
    var addresses = List<IpAddress>()
    var information = Buffer(512)
    _start_sockets(_winsock_version_2_2, information)
    var hints = Buffer(48)
    var index = 0
    while index < 48 {
        hints.append(0)
        index = index + 1
    }
    hints.write_integer_little_endian_at(8, 1)
    var found = Buffer(8)
    found.append_long_little_endian(0)
    var no_service: Long = 0
    var answer = _address_information(this, no_service, hints, found)
    var read_first = found.read_long_little_endian_at(0)
    crash read_first
    var first = read_first
    if answer != 0 or first == 0 {
        return addresses
    }
    var ipv4_count = 0
    var entry_place = first
    while entry_place != 0 {
        var entry = Buffer(48)
        var entry_size: Long = 48
        _copy_memory(entry, entry_place, entry_size)
        entry.take_written(48)
        var read_length = entry.read_integer_little_endian_at(16)
        crash read_length
        var resolved_length = read_length
        if resolved_length > 28 {
            resolved_length = 28
        }
        var read_place = entry.read_long_little_endian_at(32)
        crash read_place
        var system_address = Buffer(28)
        var copied: Long = resolved_length
        _copy_memory(system_address, read_place, copied)
        system_address.take_written(resolved_length)
        while system_address.count() < 28 {
            system_address.append(0)
        }
        var address = IpAddress()
        if address._read_system_address(system_address) {
            if address.is_ipv4() {
                addresses.insert(ipv4_count, address)
                ipv4_count = ipv4_count + 1
            } else {
                addresses.append(address)
            }
        }
        var read_next = entry.read_long_little_endian_at(40)
        crash read_next
        entry_place = read_next
    }
    _free_address_information(first)
    return addresses
}

func _to_wide(): Buffer {
    var byte_count = length()
    var no_room: Long = 0
    var characters = _measured_multi_byte_to_wide_character(_utf8_code_page, 0, this, byte_count, no_room, 0)
    var room = Buffer(characters * 2 + 2)
    var written = _multi_byte_to_wide_character(_utf8_code_page, 0, this, byte_count, room, characters)
    crash written == characters
    room.take_written(written * 2)
    room.append(0)
    room.append(0)
    return room
}

func _start_sockets(version: Integer, information: Buffer) {
    var sockets = DynamicLibrary(
        "ws2_32.dll",
        "",
        {
            "start_sockets": DynamicLibrary.FunctionDeclaration(
                "WSAStartup",
                [
                    DynamicLibrary.Argument("version", Integer),
                    DynamicLibrary.Argument("information", Buffer),
                ],
                Nothing,
            ),
        },
    )
    var call = DynamicLibrary.Call(sockets.functions["start_sockets"])
    call.arguments["version"] = version
    call.arguments["information"] = information
    call.call()
}

func _address_information(node: String, service: Long, hints: Buffer, found: Buffer): Integer {
    var sockets = DynamicLibrary(
        "ws2_32.dll",
        "",
        {
            "address_information": DynamicLibrary.FunctionDeclaration(
                "getaddrinfo",
                [
                    DynamicLibrary.Argument("node", String),
                    DynamicLibrary.Argument("service", Long),
                    DynamicLibrary.Argument("hints", Buffer),
                    DynamicLibrary.Argument("found", Buffer),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(sockets.functions["address_information"])
    call.arguments["node"] = node
    call.arguments["service"] = service
    call.arguments["hints"] = hints
    call.arguments["found"] = found
    return call.call()
}

func _copy_memory(destination: Buffer, source: Long, size: Long) {
    var memory_library = DynamicLibrary(
        "ucrtbase.dll",
        "",
        {
            "copy_memory": DynamicLibrary.FunctionDeclaration(
                "memcpy",
                [
                    DynamicLibrary.Argument("destination", Buffer),
                    DynamicLibrary.Argument("source", Long),
                    DynamicLibrary.Argument("size", Long),
                ],
                Nothing,
            ),
        },
    )
    var call = DynamicLibrary.Call(memory_library.functions["copy_memory"])
    call.arguments["destination"] = destination
    call.arguments["source"] = source
    call.arguments["size"] = size
    call.call()
}

func _free_address_information(first: Long) {
    var sockets = DynamicLibrary(
        "ws2_32.dll",
        "",
        {
            "free_address_information": DynamicLibrary.FunctionDeclaration(
                "freeaddrinfo",
                [
                    DynamicLibrary.Argument("first", Long),
                ],
                Nothing,
            ),
        },
    )
    var call = DynamicLibrary.Call(sockets.functions["free_address_information"])
    call.arguments["first"] = first
    call.call()
}

func _measured_multi_byte_to_wide_character(
    code_page: Integer,
    flags: Integer,
    text: String,
    byte_count: Integer,
    no_room: Long,
    size: Integer,
): Integer {
    var kernel = DynamicLibrary(
        "kernel32.dll",
        "",
        {
            "measured_multi_byte_to_wide_character": DynamicLibrary.FunctionDeclaration(
                "MultiByteToWideChar",
                [
                    DynamicLibrary.Argument("code_page", Integer),
                    DynamicLibrary.Argument("flags", Integer),
                    DynamicLibrary.Argument("text", String),
                    DynamicLibrary.Argument("byte_count", Integer),
                    DynamicLibrary.Argument("no_room", Long),
                    DynamicLibrary.Argument("size", Integer),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(kernel.functions["measured_multi_byte_to_wide_character"])
    call.arguments["code_page"] = code_page
    call.arguments["flags"] = flags
    call.arguments["text"] = text
    call.arguments["byte_count"] = byte_count
    call.arguments["no_room"] = no_room
    call.arguments["size"] = size
    return call.call()
}

func _multi_byte_to_wide_character(
    code_page: Integer,
    flags: Integer,
    text: String,
    byte_count: Integer,
    room: Buffer,
    size: Integer,
): Integer {
    var kernel = DynamicLibrary(
        "kernel32.dll",
        "",
        {
            "multi_byte_to_wide_character": DynamicLibrary.FunctionDeclaration(
                "MultiByteToWideChar",
                [
                    DynamicLibrary.Argument("code_page", Integer),
                    DynamicLibrary.Argument("flags", Integer),
                    DynamicLibrary.Argument("text", String),
                    DynamicLibrary.Argument("byte_count", Integer),
                    DynamicLibrary.Argument("room", Buffer),
                    DynamicLibrary.Argument("size", Integer),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(kernel.functions["multi_byte_to_wide_character"])
    call.arguments["code_page"] = code_page
    call.arguments["flags"] = flags
    call.arguments["text"] = text
    call.arguments["byte_count"] = byte_count
    call.arguments["room"] = room
    call.arguments["size"] = size
    return call.call()
}
