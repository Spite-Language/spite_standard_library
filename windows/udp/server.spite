var _sockets = DynamicLibrary(
    "ws2_32.dll",
    "",
    {
        "socket_startup": DynamicLibrary.FunctionDeclaration(
            "WSAStartup",
            [
                DynamicLibrary.Argument("version", Integer),
                DynamicLibrary.Argument("information", Buffer),
            ],
            Nothing,
        ),
        "socket": DynamicLibrary.FunctionDeclaration(
            "socket",
            [
                DynamicLibrary.Argument("family", Integer),
                DynamicLibrary.Argument("kind", Integer),
                DynamicLibrary.Argument("protocol", Integer),
            ],
            Long,
        ),
        "set_socket_option": DynamicLibrary.FunctionDeclaration(
            "setsockopt",
            [
                DynamicLibrary.Argument("socket", Long),
                DynamicLibrary.Argument("level", Integer),
                DynamicLibrary.Argument("option", Integer),
                DynamicLibrary.Argument("value", Buffer),
                DynamicLibrary.Argument("length", Integer),
            ],
            Nothing,
        ),
        "bind_socket": DynamicLibrary.FunctionDeclaration(
            "bind",
            [
                DynamicLibrary.Argument("socket", Long),
                DynamicLibrary.Argument("address", Buffer),
                DynamicLibrary.Argument("length", Integer),
            ],
            Integer,
        ),
        "send_to": DynamicLibrary.FunctionDeclaration(
            "sendto",
            [
                DynamicLibrary.Argument("socket", Long),
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("count", Integer),
                DynamicLibrary.Argument("flags", Integer),
                DynamicLibrary.Argument("address", Buffer),
                DynamicLibrary.Argument("length", Integer),
            ],
            Integer,
        ),
        "receive_from_socket": DynamicLibrary.FunctionDeclaration(
            "recvfrom",
            [
                DynamicLibrary.Argument("socket", Long),
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("count", Integer),
                DynamicLibrary.Argument("flags", Integer),
                DynamicLibrary.Argument("sender", Buffer),
                DynamicLibrary.Argument("length", Buffer),
            ],
            Integer,
        ),
        "close_socket": DynamicLibrary.FunctionDeclaration(
            "closesocket",
            [
                DynamicLibrary.Argument("socket", Long),
            ],
            Nothing,
        ),
        "socket_name": DynamicLibrary.FunctionDeclaration(
            "getsockname",
            [
                DynamicLibrary.Argument("socket", Long),
                DynamicLibrary.Argument("address", Buffer),
                DynamicLibrary.Argument("length", Buffer),
            ],
            Integer,
        ),
    },
)
var _winsock_version_2_2 = 514

func _start_sockets() {
    var information = Buffer(512)
    _socket_startup(_winsock_version_2_2, information)
}

func _open_handle(family: Integer, as_ipv6: Boolean): Long {
    var opened = _socket(family, 2, 17)
    if opened != -1 and as_ipv6 {
        var disabled = Buffer(4)
        disabled.append_integer_little_endian(0)
        _set_socket_option(opened, 41, 27, disabled, 4)
    }
    return opened
}

func _bind(address: Buffer, length: Integer): Boolean {
    return _bind_socket(handle, address, length) == 0
}

func _send(address: Buffer, length: Integer, room: Buffer, count: Integer): Integer {
    return _send_to(handle, room, count, 0, address, length)
}

func _receive_from(room: Buffer, count: Integer, sender: Buffer): Integer {
    var length_slot = Buffer(4)
    length_slot.append_integer_little_endian(28)
    return _receive_from_socket(handle, room, count, 0, sender, length_slot)
}

func _close_handle() {
    _close_socket(handle)
}

func _local_port(): Integer? {
    var address = Buffer(28)
    var index = 0
    while index < 28 {
        address.append(0)
        index = index + 1
    }
    var length_slot = Buffer(4)
    length_slot.append_integer_little_endian(28)
    var asked = _socket_name(handle, address, length_slot)
    fallback asked == 0
    var bound = IpAddress()
    return bound._system_port(address)
}

func _socket_startup(version: Integer, information: Buffer) {
    var call = DynamicLibrary.Call(_sockets.functions["socket_startup"])
    call.arguments["version"] = version
    call.arguments["information"] = information
    call.call()
}

func _socket(family: Integer, kind: Integer, protocol: Integer): Long {
    var call = DynamicLibrary.Call(_sockets.functions["socket"])
    call.arguments["family"] = family
    call.arguments["kind"] = kind
    call.arguments["protocol"] = protocol
    return call.call()
}

func _set_socket_option(socket: Long, level: Integer, option: Integer, value: Buffer, length: Integer) {
    var call = DynamicLibrary.Call(_sockets.functions["set_socket_option"])
    call.arguments["socket"] = socket
    call.arguments["level"] = level
    call.arguments["option"] = option
    call.arguments["value"] = value
    call.arguments["length"] = length
    call.call()
}

func _bind_socket(socket: Long, address: Buffer, length: Integer): Integer {
    var call = DynamicLibrary.Call(_sockets.functions["bind_socket"])
    call.arguments["socket"] = socket
    call.arguments["address"] = address
    call.arguments["length"] = length
    return call.call()
}

func _send_to(socket: Long, room: Buffer, count: Integer, flags: Integer, address: Buffer, length: Integer): Integer {
    var call = DynamicLibrary.Call(_sockets.functions["send_to"])
    call.arguments["socket"] = socket
    call.arguments["room"] = room
    call.arguments["count"] = count
    call.arguments["flags"] = flags
    call.arguments["address"] = address
    call.arguments["length"] = length
    return call.call()
}

func _receive_from_socket(
    socket: Long,
    room: Buffer,
    count: Integer,
    flags: Integer,
    sender: Buffer,
    length: Buffer,
): Integer {
    var call = DynamicLibrary.Call(_sockets.functions["receive_from_socket"])
    call.arguments["socket"] = socket
    call.arguments["room"] = room
    call.arguments["count"] = count
    call.arguments["flags"] = flags
    call.arguments["sender"] = sender
    call.arguments["length"] = length
    return call.call()
}

func _close_socket(socket: Long) {
    var call = DynamicLibrary.Call(_sockets.functions["close_socket"])
    call.arguments["socket"] = socket
    call.call()
}

func _socket_name(socket: Long, address: Buffer, length: Buffer): Integer {
    var call = DynamicLibrary.Call(_sockets.functions["socket_name"])
    call.arguments["socket"] = socket
    call.arguments["address"] = address
    call.arguments["length"] = length
    return call.call()
}
