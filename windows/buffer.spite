# ../../spite_documentation/foreign_libraries.md#rooms
type Utf8Room {
    text: DynamicLibrary.Text
}

var _utf8_code_page = 65001

func _read_wide_string_at(at: Integer, characters: Integer): String? {
    if characters == 0 {
        return ""
    }
    var wide = read_buffer_at(at, characters * 2)
    fallback wide and wide.count() == characters * 2
    var only_valid = 128
    var converted = _utf8_of_wide(_utf8_code_page, only_valid, wide, characters)
    fallback converted
    return converted.text.to_string()
}

func _wide_characters_before_zero(at: Integer, most: Integer): Integer {
    var found = 0
    while found < most {
        var low = this[at + found * 2]
        var high = this[at + found * 2 + 1]
        crash low
        crash high
        if low == 0 and high == 0 {
            return found
        }
        found = found + 1
    }
    return most
}

# ../../spite_documentation/foreign_libraries.md#rooms
func _utf8_of_wide(code_page: Integer, flags: Integer, wide: Buffer, characters: Integer): Utf8Room? {
    var kernel = DynamicLibrary(
        "kernel32.dll",
        "",
        {
            "utf8_of_wide": DynamicLibrary.FunctionDeclaration(
                "WideCharToMultiByte",
                [
                    DynamicLibrary.Argument("code_page", Integer),
                    DynamicLibrary.Argument("flags", Integer),
                    DynamicLibrary.Argument("wide", Buffer),
                    DynamicLibrary.Argument("characters", Integer),
                    DynamicLibrary.Room("room", Utf8Room, 'asked_with_no_room_first'),
                    DynamicLibrary.RoomSize("size", Integer),
                    DynamicLibrary.Argument("default_character", Long),
                    DynamicLibrary.Argument("used_default", Long),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(kernel.functions["utf8_of_wide"])
    call.arguments["code_page"] = code_page
    call.arguments["flags"] = flags
    call.arguments["wide"] = wide
    call.arguments["characters"] = characters
    call.arguments["default_character"] = 0
    call.arguments["used_default"] = 0
    return call.call()
}
