var _utf8_code_page = 65001

func _read_wide_string_at(at: Integer, characters: Integer): String? {
    if characters == 0 {
        return ""
    }
    var wide = read_buffer_at(at, characters * 2)
    fallback wide and wide.count() == characters * 2
    var only_valid = 128
    var no_room: Long = 0
    var no_value: Long = 0
    var size = _measured_wide_character_to_multi_byte(
        _utf8_code_page,
        only_valid,
        wide,
        characters,
        no_room,
        0,
        no_value,
        no_value,
    )
    fallback size > 0
    var text = Buffer(size)
    var written = _wide_character_to_multi_byte(
        _utf8_code_page,
        only_valid,
        wide,
        characters,
        text,
        size,
        no_value,
        no_value,
    )
    fallback written == size
    text.take_written(written)
    return text.read_string_at(0, written)
}

func _wide_characters_before_zero(at: Integer, most: Integer): Integer {
    var found = 0
    while found < most {
        var low = this[at + found * 2]
        var high = this[at + found * 2 + 1]
        crash low
        crash high
        if low == 0 and high == 0 {
            return found
        }
        found = found + 1
    }
    return most
}

func _measured_wide_character_to_multi_byte(
    code_page: Integer,
    flags: Integer,
    wide: Buffer,
    characters: Integer,
    no_room: Long,
    size: Integer,
    default_character: Long,
    used_default: Long,
): Integer {
    var kernel = DynamicLibrary(
        "kernel32.dll",
        "",
        {
            "measured_wide_character_to_multi_byte": DynamicLibrary.FunctionDeclaration(
                "WideCharToMultiByte",
                [
                    DynamicLibrary.Argument("code_page", Integer),
                    DynamicLibrary.Argument("flags", Integer),
                    DynamicLibrary.Argument("wide", Buffer),
                    DynamicLibrary.Argument("characters", Integer),
                    DynamicLibrary.Argument("no_room", Long),
                    DynamicLibrary.Argument("size", Integer),
                    DynamicLibrary.Argument("default_character", Long),
                    DynamicLibrary.Argument("used_default", Long),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(kernel.functions["measured_wide_character_to_multi_byte"])
    call.arguments["code_page"] = code_page
    call.arguments["flags"] = flags
    call.arguments["wide"] = wide
    call.arguments["characters"] = characters
    call.arguments["no_room"] = no_room
    call.arguments["size"] = size
    call.arguments["default_character"] = default_character
    call.arguments["used_default"] = used_default
    return call.call()
}

func _wide_character_to_multi_byte(
    code_page: Integer,
    flags: Integer,
    wide: Buffer,
    characters: Integer,
    room: Buffer,
    size: Integer,
    default_character: Long,
    used_default: Long,
): Integer {
    var kernel = DynamicLibrary(
        "kernel32.dll",
        "",
        {
            "wide_character_to_multi_byte": DynamicLibrary.FunctionDeclaration(
                "WideCharToMultiByte",
                [
                    DynamicLibrary.Argument("code_page", Integer),
                    DynamicLibrary.Argument("flags", Integer),
                    DynamicLibrary.Argument("wide", Buffer),
                    DynamicLibrary.Argument("characters", Integer),
                    DynamicLibrary.Argument("room", Buffer),
                    DynamicLibrary.Argument("size", Integer),
                    DynamicLibrary.Argument("default_character", Long),
                    DynamicLibrary.Argument("used_default", Long),
                ],
                Integer,
            ),
        },
    )
    var call = DynamicLibrary.Call(kernel.functions["wide_character_to_multi_byte"])
    call.arguments["code_page"] = code_page
    call.arguments["flags"] = flags
    call.arguments["wide"] = wide
    call.arguments["characters"] = characters
    call.arguments["room"] = room
    call.arguments["size"] = size
    call.arguments["default_character"] = default_character
    call.arguments["used_default"] = used_default
    return call.call()
}
