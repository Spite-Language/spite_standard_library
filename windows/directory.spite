var path = ""

var kernel = DynamicLibrary("kernel32.dll")

func Directory(directory_path: String) {
    path = directory_path
}

func exists(): Boolean {
    var attributes = kernel.GetFileAttributesA(path)
    return attributes != -1 and attributes.bits_and(16) != 0
}

func create(): Boolean {
    return kernel.CreateDirectoryA(path, 0) != 0 or exists()
}

func rename_to(new_path: String): Boolean {
    return kernel.MoveFileExA(path, new_path, 0) != 0
}
