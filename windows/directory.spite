var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "file_attributes": DynamicLibrary.FunctionDeclaration(
            "GetFileAttributesW",
            [
                DynamicLibrary.Argument("path", Buffer),
            ],
            Integer,
        ),
        "create_directory": DynamicLibrary.FunctionDeclaration(
            "CreateDirectoryW",
            [
                DynamicLibrary.Argument("path", Buffer),
                DynamicLibrary.Argument("security", Long),
            ],
            Integer,
        ),
        "remove_directory": DynamicLibrary.FunctionDeclaration(
            "RemoveDirectoryW",
            [
                DynamicLibrary.Argument("path", Buffer),
            ],
            Integer,
        ),
        "move_file": DynamicLibrary.FunctionDeclaration(
            "MoveFileExW",
            [
                DynamicLibrary.Argument("path", Buffer),
                DynamicLibrary.Argument("new_path", Buffer),
                DynamicLibrary.Argument("flags", Integer),
            ],
            Integer,
        ),
        "find_first_file": DynamicLibrary.FunctionDeclaration(
            "FindFirstFileW",
            [
                DynamicLibrary.Argument("pattern", Buffer),
                DynamicLibrary.Argument("found", Buffer),
            ],
            Long,
        ),
        "find_next_file": DynamicLibrary.FunctionDeclaration(
            "FindNextFileW",
            [
                DynamicLibrary.Argument("search", Long),
                DynamicLibrary.Argument("found", Buffer),
            ],
            Integer,
        ),
        "find_close": DynamicLibrary.FunctionDeclaration(
            "FindClose",
            [
                DynamicLibrary.Argument("search", Long),
            ],
            Nothing,
        ),
    },
)
var _find_data_bytes = 592
var _longest_path_characters = 260
var _reparse_point = 1024

func exists(): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            var found = place._preloaded_folder_index()
            if found {
                return true
            }
            return false
        }
    }
    var wide_path = path._to_wide()
    var attributes = _file_attributes(wide_path)
    return attributes != -1 and attributes.bits_and(16) != 0
}

func create(): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var wide_path = path._to_wide()
    var created = _create_directory(wide_path, 0)
    return created != 0 or exists()
}

func remove(): Boolean {
    var wide_path = path._to_wide()
    var removed = _remove_directory(wide_path)
    return removed != 0
}

func _is_a_link(): Boolean {
    var wide_path = path._to_wide()
    var attributes = _file_attributes(wide_path)
    return attributes != -1 and attributes.bits_and(_reparse_point) != 0
}

func _rename_to(new_path: String): Boolean {
    var wide_path = path._to_wide()
    var wide_new_path = new_path._to_wide()
    var moved = _move_file(wide_path, wide_new_path, 0)
    return moved != 0
}

func _entry_names(want_folders: Boolean): List<String>? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            return place._preloaded_names(want_folders)
        }
    }
    var names = List<String>()
    var found = Buffer(_find_data_bytes)
    var pattern = "{path}/*"
    var wide_pattern = pattern._to_wide()
    var search = _find_first_file(wide_pattern, found)
    fallback search != -1
    var readable = true
    var more = true
    while more and readable {
        found.take_written(_find_data_bytes)
        var attributes = found.read_integer_little_endian_at(0)
        crash attributes
        var is_folder = attributes.bits_and(16) != 0
        var characters = found._wide_characters_before_zero(44, _longest_path_characters)
        var name = found._read_wide_string_at(44, characters)
        if name {
            var listed = name != "." and name != ".."
            if is_folder == want_folders and listed {
                names.append(name)
            }
        } else {
            readable = false
        }
        var next = _find_next_file(search, found)
        more = next != 0
    }
    _find_close(search)
    fallback readable
    return names
}

func _file_attributes(path: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["file_attributes"])
    call.arguments["path"] = path
    return call.call()
}

func _create_directory(path: Buffer, security: Long): Integer {
    var call = DynamicLibrary.Call(kernel.functions["create_directory"])
    call.arguments["path"] = path
    call.arguments["security"] = security
    return call.call()
}

func _remove_directory(path: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["remove_directory"])
    call.arguments["path"] = path
    return call.call()
}

func _move_file(path: Buffer, new_path: Buffer, flags: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["move_file"])
    call.arguments["path"] = path
    call.arguments["new_path"] = new_path
    call.arguments["flags"] = flags
    return call.call()
}

func _find_first_file(pattern: Buffer, found: Buffer): Long {
    var call = DynamicLibrary.Call(kernel.functions["find_first_file"])
    call.arguments["pattern"] = pattern
    call.arguments["found"] = found
    return call.call()
}

func _find_next_file(search: Long, found: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["find_next_file"])
    call.arguments["search"] = search
    call.arguments["found"] = found
    return call.call()
}

func _find_close(search: Long) {
    var call = DynamicLibrary.Call(kernel.functions["find_close"])
    call.arguments["search"] = search
    call.call()
}
