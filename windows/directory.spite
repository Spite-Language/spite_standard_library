var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func exists(): Boolean {
    var wide_path = path._to_wide()
    var attributes = kernel.GetFileAttributesW(wide_path)
    return attributes != -1 and attributes.bits_and(16) != 0
}

func create(): Boolean {
    var wide_path = path._to_wide()
    var created = kernel.CreateDirectoryW(wide_path, 0)
    return created != 0 or exists()
}

func _rename_to(new_path: String): Boolean {
    var wide_path = path._to_wide()
    var wide_new_path = new_path._to_wide()
    var moved = kernel.MoveFileExW(wide_path, wide_new_path, 0)
    return moved != 0
}

func _entry_names(want_folders: Boolean): List<String>? {
    var names = List<String>()
    var found = Buffer(592)
    var pattern = "{path}/*"
    var wide_pattern = pattern._to_wide()
    var search = kernel.FindFirstFileW_as_long(wide_pattern, found)
    assert search != -1
    var readable = true
    var more = true
    while more and readable {
        found.take_written(592)
        var attributes = found.read_integer_little_endian_at(0)
        crash attributes
        var is_folder = attributes.bits_and(16) != 0
        var characters = found._wide_characters_before_zero(44, 260)
        var name = found._read_wide_string_at(44, characters)
        if name {
            var listed = name != "." and name != ".."
            if is_folder == want_folders and listed {
                names.append(name)
            }
        } else {
            readable = false
        }
        var next = kernel.FindNextFileW(search, found)
        more = next != 0
    }
    kernel.FindClose(search)
    assert readable
    return names
}
