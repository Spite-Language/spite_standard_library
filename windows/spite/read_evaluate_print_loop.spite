var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "standard_handle": DynamicLibrary.FunctionDeclaration(
            "GetStdHandle",
            [
                DynamicLibrary.Argument("kind", Integer),
            ],
            Long,
        ),
        "current_process": DynamicLibrary.FunctionDeclaration("GetCurrentProcess", [], Long),
        "duplicate_handle": DynamicLibrary.FunctionDeclaration(
            "DuplicateHandle",
            [
                DynamicLibrary.Argument("source_process", Long),
                DynamicLibrary.Argument("source", Long),
                DynamicLibrary.Argument("target_process", Long),
                DynamicLibrary.Argument("target", Buffer),
                DynamicLibrary.Argument("access", Integer),
                DynamicLibrary.Argument("inherits", Integer),
                DynamicLibrary.Argument("options", Integer),
            ],
            Integer,
        ),
        "file_type": DynamicLibrary.FunctionDeclaration(
            "GetFileType",
            [
                DynamicLibrary.Argument("handle", Long),
            ],
            Integer,
        ),
        "set_console_control_handler": DynamicLibrary.FunctionDeclaration(
            "SetConsoleCtrlHandler",
            [
                DynamicLibrary.Argument("handler", Long),
                DynamicLibrary.Argument("add", Integer),
            ],
            Integer,
        ),
        "terminate_process": DynamicLibrary.FunctionDeclaration(
            "TerminateProcess",
            [
                DynamicLibrary.Argument("process", Long),
                DynamicLibrary.Argument("exit_code", Integer),
            ],
            Integer,
        ),
        "peek_named_pipe": DynamicLibrary.FunctionDeclaration(
            "PeekNamedPipe",
            [
                DynamicLibrary.Argument("pipe", Long),
                DynamicLibrary.Argument("buffer", Long),
                DynamicLibrary.Argument("size", Integer),
                DynamicLibrary.Argument("read", Long),
                DynamicLibrary.Argument("available", Buffer),
                DynamicLibrary.Argument("left", Long),
            ],
            Integer,
        ),
        "number_of_console_input_events": DynamicLibrary.FunctionDeclaration(
            "GetNumberOfConsoleInputEvents",
            [
                DynamicLibrary.Argument("input", Long),
                DynamicLibrary.Argument("count", Buffer),
            ],
            Integer,
        ),
        "peek_console_input": DynamicLibrary.FunctionDeclaration(
            "PeekConsoleInputA",
            [
                DynamicLibrary.Argument("input", Long),
                DynamicLibrary.Argument("records", Buffer),
                DynamicLibrary.Argument("length", Integer),
                DynamicLibrary.Argument("read", Buffer),
            ],
            Integer,
        ),
        "read_file": DynamicLibrary.FunctionDeclaration(
            "ReadFile",
            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("size", Integer),
                DynamicLibrary.Argument("read", Buffer),
                DynamicLibrary.Argument("overlapped", Long),
            ],
            Integer,
        ),
    },
)
var runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "open_file": DynamicLibrary.FunctionDeclaration(
            "_open",
            [
                DynamicLibrary.Argument("path", String),
                DynamicLibrary.Argument("flags", Integer),
            ],
            Integer,
        ),
        "duplicate_file": DynamicLibrary.FunctionDeclaration(
            "_dup2",
            [
                DynamicLibrary.Argument("source", Integer),
                DynamicLibrary.Argument("target", Integer),
            ],
            Integer,
        ),
        "close_file": DynamicLibrary.FunctionDeclaration("_close", [DynamicLibrary.Argument("file", Integer)], Integer),
    },
)
var input: Long = 0
var input_kind = 0
var held = Buffer(0)
var held_callbacks = List<ForeignCallback>()
var _control_c = 0
var _control_break = 1
var _interrupted = 130
var _same_access = 2
var _read_only = 0
var _standard_input = -10
var _disk = 1
var _character = 2
var _pipe = 3
var _room = 4096
var _records = 64
var _record_size = 20
var _key_event = 1
var _return_key = 13

# https://github.com/Spite-Language/spite_documentation/blob/master/repl.md#typing-spite-into-a-running-program
func _start_reading() {
    var standard = _standard_handle(_standard_input)
    input = standard
    var process = _current_process()
    var copied = Buffer(8)
    var duplicated = _duplicate_handle(process, standard, process, copied, 0, 0, _same_access)
    if duplicated != 0 {
        copied._take_written(8)
        var held = copied.read_long_little_endian_at(0)
        crash held
        input = held
        leave_the_program_no_input()
    }
    input_kind = _file_type(input)
    var stopping = ForeignCallback(stop_at_once, 'no_context')
    var handled = _set_console_control_handler(stopping.address, 1)
    if handled != 0 {
        held_callbacks.append(stopping)
    }
}

# https://github.com/Spite-Language/spite_documentation/blob/master/repl.md#input-and-ending
func leave_the_program_no_input() {
    var nothing_to_read = _open_file("NUL", _read_only)
    fallback nothing_to_read >= 0
    var moved = _duplicate_file(nothing_to_read, 0)
    fallback moved == 0
    var closed = _close_file(nothing_to_read)
    crash closed == 0
}

func stop_at_once(kind: Integer): Integer {
    fallback kind == _control_c or kind == _control_break
    var process = _current_process()
    return _terminate_process(process, _interrupted)
}

func _ready_line(): String? {
    var line = _held_line()
    if line {
        return line
    }
    fallback not ended
    fallback _input_waits()
    _read_some()
    return _held_line()
}

func _next_line(): String? {
    var line = _held_line()
    while not line and not ended {
        _read_some()
        line = _held_line()
    }
    if line {
        return line
    }
    return _the_rest()
}

func _input_waits(): Boolean {
    if input_kind == _pipe {
        var available = Buffer(4)
        var peeked = _peek_named_pipe(input, 0, 0, 0, available, 0)
        if peeked == 0 {
            return true
        }
        available._take_written(4)
        var count = available.read_integer_little_endian_at(0)
        crash count
        return count > 0
    }
    if input_kind == _character {
        return _console_holds_a_line()
    }
    return true
}

func _console_holds_a_line(): Boolean {
    var waiting = Buffer(4)
    var counted = _number_of_console_input_events(input, waiting)
    if counted == 0 {
        return true
    }
    var records = Buffer(_records * _record_size)
    var read = Buffer(4)
    var peeked = _peek_console_input(input, records, _records, read)
    fallback peeked != 0
    read._take_written(4)
    var count = read.read_integer_little_endian_at(0)
    crash count
    records._take_written(count * _record_size)
    var index = 0
    while index < count {
        var at = index * _record_size
        var kind = records.read_short_little_endian_at(at)
        var down = records.read_integer_little_endian_at(at + 4)
        var key = records.read_short_little_endian_at(at + 10)
        crash kind and down and key
        var kind_number: Integer = kind
        var key_number: Integer = key
        if kind_number == _key_event and down != 0 and key_number == _return_key {
            return true
        }
        index = index + 1
    }
    return false
}

func _read_some() {
    var room = Buffer(_room)
    var read = Buffer(4)
    var done = _read_file(input, room, _room, read, 0)
    if done == 0 {
        ended = true
        return
    }
    read._take_written(4)
    var count = read.read_integer_little_endian_at(0)
    crash count
    if count == 0 {
        ended = true
        return
    }
    room._take_written(count)
    held.append_buffer(room, 0, count)
}

func _held_line(): String? {
    var index = 0
    while index < held.count() {
        var byte = held[index]
        crash byte
        var code: Integer = byte
        if code == 10 {
            return _taken(index, index + 1)
        }
        index = index + 1
    }
    return null
}

func _the_rest(): String? {
    var count = held.count()
    fallback count > 0
    return _taken(count, count)
}

func _taken(end: Integer, after: Integer): String {
    var length = end
    if length > 0 {
        var byte = held[length - 1]
        crash byte
        var last: Integer = byte
        if last == 13 {
            length = length - 1
        }
    }
    var line = held.read_string_at(0, length)
    crash line
    var rest = Buffer(0)
    var rest_count = held.count() - after
    rest.append_buffer(held, after, rest_count)
    held = rest
    return line
}

func _standard_handle(kind: Integer): Long {
    var call = DynamicLibrary.Call(kernel.functions["standard_handle"])
    call.arguments["kind"] = kind
    return call.call()
}

func _current_process(): Long {
    var call = DynamicLibrary.Call(kernel.functions["current_process"])
    return call.call()
}

func _duplicate_handle(
    source_process: Long,
    source: Long,
    target_process: Long,
    target: Buffer,
    access: Integer,
    inherits: Integer,
    options: Integer,
): Integer {
    var call = DynamicLibrary.Call(kernel.functions["duplicate_handle"])
    call.arguments["source_process"] = source_process
    call.arguments["source"] = source
    call.arguments["target_process"] = target_process
    call.arguments["target"] = target
    call.arguments["access"] = access
    call.arguments["inherits"] = inherits
    call.arguments["options"] = options
    return call.call()
}

func _file_type(handle: Long): Integer {
    var call = DynamicLibrary.Call(kernel.functions["file_type"])
    call.arguments["handle"] = handle
    return call.call()
}

func _set_console_control_handler(handler: Long, add: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["set_console_control_handler"])
    call.arguments["handler"] = handler
    call.arguments["add"] = add
    return call.call()
}

func _open_file(path: String, flags: Integer): Integer {
    var call = DynamicLibrary.Call(runtime.functions["open_file"])
    call.arguments["path"] = path
    call.arguments["flags"] = flags
    return call.call()
}

func _duplicate_file(source: Integer, target: Integer): Integer {
    var call = DynamicLibrary.Call(runtime.functions["duplicate_file"])
    call.arguments["source"] = source
    call.arguments["target"] = target
    return call.call()
}

func _close_file(file: Integer): Integer {
    var call = DynamicLibrary.Call(runtime.functions["close_file"])
    call.arguments["file"] = file
    return call.call()
}

func _terminate_process(process: Long, exit_code: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["terminate_process"])
    call.arguments["process"] = process
    call.arguments["exit_code"] = exit_code
    return call.call()
}

func _peek_named_pipe(pipe: Long, buffer: Long, size: Integer, read: Long, available: Buffer, left: Long): Integer {
    var call = DynamicLibrary.Call(kernel.functions["peek_named_pipe"])
    call.arguments["pipe"] = pipe
    call.arguments["buffer"] = buffer
    call.arguments["size"] = size
    call.arguments["read"] = read
    call.arguments["available"] = available
    call.arguments["left"] = left
    return call.call()
}

func _number_of_console_input_events(input: Long, count: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["number_of_console_input_events"])
    call.arguments["input"] = input
    call.arguments["count"] = count
    return call.call()
}

func _peek_console_input(input: Long, records: Buffer, length: Integer, read: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["peek_console_input"])
    call.arguments["input"] = input
    call.arguments["records"] = records
    call.arguments["length"] = length
    call.arguments["read"] = read
    return call.call()
}

func _read_file(handle: Long, room: Buffer, size: Integer, read: Buffer, overlapped: Long): Integer {
    var call = DynamicLibrary.Call(kernel.functions["read_file"])
    call.arguments["handle"] = handle
    call.arguments["room"] = room
    call.arguments["size"] = size
    call.arguments["read"] = read
    call.arguments["overlapped"] = overlapped
    return call.call()
}
