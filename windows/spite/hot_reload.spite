# https://github.com/Spite-Language/spite_documentation/blob/master/foreign_libraries.md#rooms
type ChunkRoom {
    bytes: DynamicLibrary.Bytes
}

var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "virtual_allocate": DynamicLibrary.FunctionDeclaration(
            "VirtualAlloc",
            [
                DynamicLibrary.Argument("address", Long),
                DynamicLibrary.Argument("size", Long),
                DynamicLibrary.Argument("allocation", Integer),
                DynamicLibrary.Argument("protection", Integer),
            ],
            Long,
        ),
        "move_memory": DynamicLibrary.FunctionDeclaration(
            "RtlMoveMemory",
            [
                DynamicLibrary.Argument("destination", Long),
                DynamicLibrary.Argument("source", Buffer),
                DynamicLibrary.Argument("size", Integer),
            ],
            Nothing,
        ),
        "current_process": DynamicLibrary.FunctionDeclaration("GetCurrentProcess", [], Long),
        "flush_instruction_cache": DynamicLibrary.FunctionDeclaration(
            "FlushInstructionCache",
            [
                DynamicLibrary.Argument("process", Long),
                DynamicLibrary.Argument("address", Long),
                DynamicLibrary.Argument("size", Integer),
            ],
            Nothing,
        ),
        "load_library": DynamicLibrary.FunctionDeclaration(
            "LoadLibraryA",
            [
                DynamicLibrary.Argument("name", String),
            ],
            Long,
        ),
        "procedure_address": DynamicLibrary.FunctionDeclaration(
            "GetProcAddress",
            [
                DynamicLibrary.Argument("module", Long),
                DynamicLibrary.Argument("name", String),
            ],
            Long,
        ),
    },
)
var runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "open_pipe": DynamicLibrary.FunctionDeclaration(
            "_popen",
            [
                DynamicLibrary.Argument("command", String),
                DynamicLibrary.Argument("mode", String),
            ],
            Long,
        ),
        "read_chunk": DynamicLibrary.FunctionDeclaration(
            "fread",
            [
                DynamicLibrary.Room("room", ChunkRoom, 'answer_is_what_arrived'),
                DynamicLibrary.Argument("size", Long),
                DynamicLibrary.RoomSize("count", Integer),
                DynamicLibrary.Argument("handle", Long),
            ],
            Integer,
        ),
        "close_pipe": DynamicLibrary.FunctionDeclaration("_pclose", [DynamicLibrary.Argument("handle", Long)], Integer),
    },
)
var _room_start: Long = 6442450944
var _room_size: Long = 268435456
var _granularity = 65536
var _chunk_size = 4096

func compiler_line(executable: String, address: Long): String {
    return "cd /d \"{working_folder}\" && \"{compiler}\" {arguments} --executable-path=\"{executable}\" --reload-at={address} 2>&1"
}

func reserve_the_room(): Boolean {
    if next_address != 0 {
        return true
    }
    var wanted: Long = _room_start
    var size: Long = _room_size
    var reserved = _virtual_allocate(wanted, size, 8192, 64)
    fallback reserved == wanted
    next_address = wanted
    room_end = wanted + size
    return true
}

func run_the_compiler(line: String): Integer {
    compiler_output = ""
    var handle = _open_pipe(line, "r")
    if handle == 0 {
        compiler_output = "the compiler could not be started: {line}"
        return -1
    }
    var output_text = String()
    var chunk = _read_chunk(handle)
    while chunk {
        var byte_index = 0
        while byte_index < chunk.count() {
            var held = chunk[byte_index]
            crash held
            output_text.append_code(held)
            byte_index = byte_index + 1
        }
        chunk = _read_chunk(handle)
    }
    compiler_output = output_text
    return _close_pipe(handle)
}

func swap_in(path: String, address: Long): String {
    var file_path: Path? = path
    crash file_path
    var file = File(file_path)
    var bytes = file.read_as_buffer()
    if not bytes {
        return "the new code '{path}' cannot be read"
    }
    var loaded_at = bytes.read_long_little_endian_at(0)
    var size = bytes.read_integer_little_endian_at(8)
    var slot_count = bytes.read_integer_little_endian_at(12)
    crash loaded_at
    crash size
    crash slot_count
    var end = address + size
    if loaded_at != address or end > room_end {
        return "the new code '{path}' was compiled for another place than the room kept for it"
    }
    var committed = _virtual_allocate(address, size, 4096, 64)
    if committed != address {
        return "the room for the new code could not be committed (VirtualAlloc at {address} for {size} bytes)"
    }
    var image = bytes.read_buffer_at(16, size)
    crash image
    _move_memory(address, image, size)
    var imports_at = 16 + size + 16 * slot_count
    var resolved = _resolve_the_imports(bytes, imports_at)
    if not resolved.is_empty() {
        return resolved
    }
    var process = _current_process()
    _flush_instruction_cache(process, address, size)
    var pair = 0
    while pair < slot_count {
        var at = 16 + size + 16 * pair
        var slot = bytes.read_long_little_endian_at(at)
        var value = bytes.read_long_little_endian_at(at + 8)
        crash slot
        crash value
        var room = Buffer(8)
        room.append_long_little_endian(value)
        _move_memory(slot, room, 8)
        pair = pair + 1
    }
    var rounded = (size + _granularity - 1) / _granularity * _granularity
    next_address = address + rounded
    return ""
}

# https://github.com/Spite-Language/spite_compiler/blob/master/HOT_RELOAD.md#system-functions-a-reload-adds
func _resolve_the_imports(bytes: Buffer, start: Integer): String {
    var import_count = bytes.read_integer_little_endian_at(start)
    crash import_count
    var at = start + 4
    var index = 0
    while index < import_count {
        var cell = bytes.read_long_little_endian_at(at)
        crash cell
        at = at + 8
        var library_length = bytes.read_integer_little_endian_at(at)
        crash library_length
        var library = bytes.read_string_at(at + 4, library_length)
        crash library
        at = at + 4 + library_length
        var name_length = bytes.read_integer_little_endian_at(at)
        crash name_length
        var name = bytes.read_string_at(at + 4, name_length)
        crash name
        at = at + 4 + name_length
        var handle = _load_library(library)
        var found: Long = 0
        if handle != 0 {
            found = _procedure_address(handle, name)
        }
        if found == 0 {
            return "the new code calls '{name}' of the system, which '{library}' does not have"
        }
        var room = Buffer(8)
        room.append_long_little_endian(found)
        _move_memory(cell, room, 8)
        index = index + 1
    }
    return ""
}

func _virtual_allocate(address: Long, size: Long, allocation: Integer, protection: Integer): Long {
    var call = DynamicLibrary.Call(kernel.functions["virtual_allocate"])
    call.arguments["address"] = address
    call.arguments["size"] = size
    call.arguments["allocation"] = allocation
    call.arguments["protection"] = protection
    return call.call()
}

func _open_pipe(command: String, mode: String): Long {
    var call = DynamicLibrary.Call(runtime.functions["open_pipe"])
    call.arguments["command"] = command
    call.arguments["mode"] = mode
    return call.call()
}

func _read_chunk(handle: Long): Buffer? {
    var call = DynamicLibrary.Call(runtime.functions["read_chunk"])
    call.arguments["size"] = 1
    call.arguments["count"] = _chunk_size
    call.arguments["handle"] = handle
    var read = call.call()
    fallback read
    var bytes = read.bytes.to_buffer()
    fallback not bytes.is_empty()
    return bytes
}

func _close_pipe(handle: Long): Integer {
    var call = DynamicLibrary.Call(runtime.functions["close_pipe"])
    call.arguments["handle"] = handle
    return call.call()
}

func _move_memory(destination: Long, source: Buffer, size: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["move_memory"])
    call.arguments["destination"] = destination
    call.arguments["source"] = source
    call.arguments["size"] = size
    call.call()
}

func _current_process(): Long {
    var call = DynamicLibrary.Call(kernel.functions["current_process"])
    return call.call()
}

func _flush_instruction_cache(process: Long, address: Long, size: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["flush_instruction_cache"])
    call.arguments["process"] = process
    call.arguments["address"] = address
    call.arguments["size"] = size
    call.call()
}

func _load_library(name: String): Long {
    var call = DynamicLibrary.Call(kernel.functions["load_library"])
    call.arguments["name"] = name
    return call.call()
}

func _procedure_address(module: Long, name: String): Long {
    var call = DynamicLibrary.Call(kernel.functions["procedure_address"])
    call.arguments["module"] = module
    call.arguments["name"] = name
    return call.call()
}
