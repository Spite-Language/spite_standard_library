var input: Long = 0

func read_line(): String? {
    if input == 0 {
        input = _open_stream(0, "r")
    }
    var line = Buffer(0)
    var read_anything = false
    var ended = false
    while not ended {
        var room = Buffer(256)
        var read = _read_text_line(room, 256, input)
        if read == 0 {
            ended = true
        } else {
            read_anything = true
            var room_count = _text_length(room)
            room._take_written(room_count)
            line.append_buffer(room, 0, room_count)
            ended = _ends_with_byte(line, 10)
        }
    }
    fallback read_anything
    var length = line.count()
    if _ends_with_byte(line, 10) {
        length = length - 1
        line._take_written(length)
    }
    if _ends_with_byte(line, 13) {
        length = length - 1
    }
    return line.read_string_at(0, length)
}

func _ends_with_byte(bytes: Buffer, wanted: Integer): Boolean {
    var count = bytes.count()
    fallback count != 0
    var last = bytes[count - 1]
    crash last
    var code: Integer = last
    return code == wanted
}

func _open_stream(file: Integer, mode: String): Long {
    var call = DynamicLibrary.Call(library.functions["open_stream"])
    call.arguments["file"] = file
    call.arguments["mode"] = mode
    return call.call()
}

func _read_text_line(room: Buffer, size: Integer, stream: Long): Long {
    var call = DynamicLibrary.Call(library.functions["read_text_line"])
    call.arguments["room"] = room
    call.arguments["size"] = size
    call.arguments["stream"] = stream
    return call.call()
}

func _text_length(text: Buffer): Integer {
    var call = DynamicLibrary.Call(library.functions["text_length"])
    call.arguments["text"] = text
    return call.call()
}
