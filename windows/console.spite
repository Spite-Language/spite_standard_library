var input = 0

func read_line(): String? {
    if input == 0 {
        input = library._fdopen_as_long(0, "r")
    }
    var line = Buffer(0)
    var read_anything = false
    var ended = false
    while not ended {
        var room = Buffer(256)
        var read = library.fgets(room, 256, input)
        if read == 0 {
            ended = true
        } else {
            read_anything = true
            var room_count = library.strlen(room)
            room.take_written(room_count)
            line.append_buffer(room, 0, room_count)
            ended = _ends_with_byte(line, 10)
        }
    }
    assert read_anything
    var length = line.count()
    if _ends_with_byte(line, 10) {
        length = length - 1
        line.take_written(length)
    }
    if _ends_with_byte(line, 13) {
        length = length - 1
    }
    return line.read_string_at(0, length)
}

func _ends_with_byte(bytes: Buffer, wanted: Integer): Boolean {
    var count = bytes.count()
    if count == 0 {
        return false
    }
    var last = bytes[count - 1]
    crash last
    var code: Integer = last
    return code == wanted
}
