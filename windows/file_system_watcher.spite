var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "create_file": DynamicLibrary.FunctionDeclaration(
            "CreateFileW",
            [
                DynamicLibrary.Argument("path", Buffer),
                DynamicLibrary.Argument("access", Integer),
                DynamicLibrary.Argument("sharing", Integer),
                DynamicLibrary.Argument("security", Long),
                DynamicLibrary.Argument("disposition", Integer),
                DynamicLibrary.Argument("flags", Integer),
                DynamicLibrary.Argument("template", Long),
            ],
            Long,
        ),
        "create_event": DynamicLibrary.FunctionDeclaration(
            "CreateEventW",
            [
                DynamicLibrary.Argument("security", Long),
                DynamicLibrary.Argument("manual_reset", Integer),
                DynamicLibrary.Argument("initial_state", Integer),
                DynamicLibrary.Argument("name", Long),
            ],
            Long,
        ),
        "reset_event": DynamicLibrary.FunctionDeclaration(
            "ResetEvent",
            [
                DynamicLibrary.Argument("event", Long),
            ],
            Nothing,
        ),
        "read_directory_changes": DynamicLibrary.FunctionDeclaration(
            "ReadDirectoryChangesW",
            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("buffer", Buffer),
                DynamicLibrary.Argument("length", Integer),
                DynamicLibrary.Argument("subtree", Integer),
                DynamicLibrary.Argument("filter", Integer),
                DynamicLibrary.Argument("returned", Long),
