var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var handles = List<Long>()
var events = List<Long>()
var overlaps = List<Buffer>()
var buffers = List<Buffer>()
var roots = List<String>()
var file_names = List<String>()
var _backup_semantics_and_overlapped_flags = 1107296256
var _io_incomplete_error = 996

func watch_folder(path: Path): Boolean {
    var written = path.written
    return _open_watch(written, written, "")
}

func watch_file(file_path: Path): Boolean {
    var path = file_path.written
    var cut = path.length()
    var found = false
    while cut > 0 and not found {
        var before = path[cut - 1]
        found = before == "/" or before == "\\"
        if not found {
            cut = cut - 1
        }
    }
    var path_length = path.length()
    var name = path.slice(cut, path_length)
    crash name
    var lower_name = name.lower_case()
    var folder = "."
    if cut > 1 {
        var sliced_folder = path.slice(0, cut - 1)
        crash sliced_folder
        folder = sliced_folder
    } else if cut == 1 {
        var sliced_folder = path.slice(0, 1)
        crash sliced_folder
        folder = sliced_folder
    }
    return _open_watch(folder, path, lower_name)
}

func _zeroed(size: Integer): Buffer {
    var room = Buffer(size)
    var index = 0
    while index < size {
        room.append(0)
        index = index + 1
    }
    return room
}

func _open_watch(folder: String, root: String, file_name: String): Boolean {
    var no_value: Long = 0
    var wide_folder = folder._to_wide()
    var handle = kernel.CreateFileW_as_long(wide_folder, 1, 7, no_value, 3, _backup_semantics_and_overlapped_flags, no_value)
    fallback handle != -1
    var overlap = _zeroed(32)
    var event = kernel.CreateEventW_as_long(no_value, 1, 0, no_value)
    overlap.write_long_little_endian_at(24, event)
    var buffer = Buffer(65536)
    handles.append(handle)
    events.append(event)
    overlaps.append(overlap)
    buffers.append(buffer)
    roots.append(root)
    file_names.append(file_name)
    var watching = handles.count() - 1
    var requested = _request(watching)
    if not requested {
        _close_watch(watching)
    }
    return requested
}

func _request(watching: Integer): Boolean {
    var event = events[watching]
    var file_name = file_names[watching]
    var handle = handles[watching]
    var buffer = buffers[watching]
    var overlap = overlaps[watching]
    crash event
    crash file_name
    crash handle
    crash buffer
    crash overlap
    kernel.ResetEvent(event)
    var subtree = 0
    if file_name.is_empty() {
        subtree = 1
    }
    var no_value: Long = 0
    var requested = kernel.ReadDirectoryChangesW(handle, buffer, 65536, subtree, 27, no_value, overlap, no_value)
    return requested != 0
}

func _collect() {
    var transferred = _zeroed(8)
    var watching = 0
    while watching < handles.count() {
        _collect_from(watching, transferred)
        watching = watching + 1
    }
}

func _collect_from(watching: Integer, transferred: Buffer) {
    var handle = handles[watching]
    var overlap = overlaps[watching]
    var root = roots[watching]
    crash handle
    crash overlap
    crash root
    fallback handle != -1
    transferred.write_long_little_endian_at(0, 0)
    var result = kernel.GetOverlappedResult(handle, overlap, transferred, 0)
    if result == 0 {
        var failure = kernel.GetLastError()
        if failure != _io_incomplete_error {
            _note(root)
            _close_watch(watching)
        }
        return
    }
    var length = transferred.read_integer_little_endian_at(0)
    crash length
    if length == 0 {
        _note(root)
    } else {
        _read_notices(watching, length)
    }
    if not _request(watching) {
        _close_watch(watching)
    }
}

func _read_notices(watching: Integer, length: Integer) {
    var buffer = buffers[watching]
    crash buffer
    buffer.take_written(length)
    var offset = 0
    var more = true
    while more {
        var next = buffer.read_integer_little_endian_at(offset)
        var action = buffer.read_integer_little_endian_at(offset + 4)
        var name_bytes = buffer.read_integer_little_endian_at(offset + 8)
        crash next
        crash action
        crash name_bytes
        var read_name = buffer._read_wide_string_at(offset + 12, name_bytes / 2)
        if read_name {
            var name = read_name.replace("\\", "/")
            _note_notice(watching, name, action)
        } else {
            var root = roots[watching]
            crash root
            _note(root)
        }
        offset = offset + next
        more = next != 0
    }
}

func _note_notice(watching: Integer, name: String, action: Integer) {
    var root = roots[watching]
    var file_name = file_names[watching]
    crash root
    crash file_name
    if not file_name.is_empty() {
        var lower_name = name.lower_case()
        if lower_name == file_name {
            _note(root)
        }
        return
    }
    var path = _joined(root, name)
    var wide_path = path._to_wide()
    var attributes = kernel.GetFileAttributesW(wide_path)
    var is_folder = attributes != -1 and attributes.bits_and(16) != 0
    if action != 3 or not is_folder {
        _note(path)
    }
}

func _wait_for_event(waiting_at_most: Duration?) {
    var milliseconds: Long = -1
    if waiting_at_most {
        milliseconds = waiting_at_most.total('milliseconds')
    }
    var watch_count = handles.count()
    var waiting = Buffer(watch_count * 8 + 8)
    var count = 0
    var index = 0
    while index < watch_count {
        var handle = handles[index]
        crash handle
        if handle != -1 {
            var event = events[index]
            crash event
            waiting.append_long_little_endian(event)
            count = count + 1
        }
        index = index + 1
    }
    if count > 0 {
        kernel.WaitForMultipleObjects(count, waiting, 0, milliseconds)
    } else {
        kernel.Sleep(milliseconds)
    }
}

func _close_watch(watching: Integer) {
    var handle = handles[watching]
    var overlap = overlaps[watching]
    var event = events[watching]
    crash handle
    crash overlap
    crash event
    fallback handle != -1
    kernel.CancelIoEx(handle, overlap)
    var transferred = _zeroed(8)
    kernel.GetOverlappedResult(handle, overlap, transferred, 1)
    kernel.CloseHandle(handle)
    kernel.CloseHandle(event)
    handles[watching] = -1
}

func drop() {
    var index = 0
    while index < handles.count() {
        var handle = handles[index]
        crash handle
        if handle != -1 {
            _close_watch(index)
        }
        index = index + 1
    }
}
