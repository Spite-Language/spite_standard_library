func _wait_for_multiple_objects(count: Integer, handles: Buffer, wait_all: Integer, milliseconds: Long) {
    var call = DynamicLibrary.Call(kernel.functions["wait_for_multiple_objects"])
    call.arguments["count"] = count
    call.arguments["handles"] = handles
    call.arguments["wait_all"] = wait_all
    call.arguments["milliseconds"] = milliseconds
    call.call()
}

func _sleep(milliseconds: Long) {
    var call = DynamicLibrary.Call(kernel.functions["sleep"])
    call.arguments["milliseconds"] = milliseconds
