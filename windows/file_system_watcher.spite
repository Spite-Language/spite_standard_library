    call.arguments["buffer"] = buffer
    call.arguments["length"] = length
    call.arguments["subtree"] = subtree
    call.arguments["filter"] = filter
    call.arguments["returned"] = returned
    call.arguments["overlapped"] = overlapped
    call.arguments["completion"] = completion
    return call.call()
}

func _overlapped_result(handle: Long, overlapped: Buffer, transferred: Buffer, wait: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["overlapped_result"])
    call.arguments["handle"] = handle
    call.arguments["overlapped"] = overlapped
    call.arguments["transferred"] = transferred
    call.arguments["wait"] = wait
    return call.call()
}

func _last_error(): Integer {
    var call = DynamicLibrary.Call(kernel.functions["last_error"])
    return call.call()
}

func _file_attributes(path: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["file_attributes"])
    call.arguments["path"] = path
