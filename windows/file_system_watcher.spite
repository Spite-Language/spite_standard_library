            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("overlapped", Buffer),
                DynamicLibrary.Argument("transferred", Buffer),
                DynamicLibrary.Argument("wait", Integer),
            ],
            Integer,
        ),
        "last_error": DynamicLibrary.FunctionDeclaration("GetLastError", [], Integer),
        "file_attributes": DynamicLibrary.FunctionDeclaration(
