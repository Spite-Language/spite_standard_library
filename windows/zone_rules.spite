var _calendar: ZoneCalendar? = null

func follow_calendar(calendar: ZoneCalendar) {
    _calendar = calendar
}

func offset_seconds_at(unix_seconds: Long): Integer {
    var calendar = _calendar
    if calendar {
        return calendar.offset_seconds_at(unix_seconds)
    }
    return transition_offset_seconds_at(unix_seconds)
}
