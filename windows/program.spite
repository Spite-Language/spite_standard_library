var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "sleep_for": DynamicLibrary.FunctionDeclaration(
            "Sleep",
            [
                DynamicLibrary.Argument("milliseconds", Long),
            ],
            Nothing,
        ),
        "create_waitable_timer": DynamicLibrary.FunctionDeclaration(
            "CreateWaitableTimerExW",
            [
                DynamicLibrary.Argument("security", Long),
                DynamicLibrary.Argument("name", Long),
                DynamicLibrary.Argument("flags", Integer),
                DynamicLibrary.Argument("access", Integer),
            ],
            Long,
        ),
        "close_handle": DynamicLibrary.FunctionDeclaration(
            "CloseHandle",
            [
                DynamicLibrary.Argument("handle", Long),
            ],
            Nothing,
        ),
        "set_waitable_timer": DynamicLibrary.FunctionDeclaration(
            "SetWaitableTimer",
            [
                DynamicLibrary.Argument("timer", Long),
                DynamicLibrary.Argument("due", Buffer),
                DynamicLibrary.Argument("period", Integer),
                DynamicLibrary.Argument("completion", Long),
                DynamicLibrary.Argument("argument", Long),
                DynamicLibrary.Argument("resume", Integer),
            ],
            Integer,
        ),
        "wait_for_single_object": DynamicLibrary.FunctionDeclaration(
            "WaitForSingleObject",
            [
                DynamicLibrary.Argument("handle", Long),
                DynamicLibrary.Argument("milliseconds", Integer),
            ],
            Integer,
        ),
        "current_directory": DynamicLibrary.FunctionDeclaration(
            "GetCurrentDirectoryW",
            [
                DynamicLibrary.Argument("size", Integer),
                DynamicLibrary.Argument("room", Buffer),
            ],
            Integer,
        ),
        "module_file_name": DynamicLibrary.FunctionDeclaration(
            "GetModuleFileNameW",
            [
                DynamicLibrary.Argument("module", Long),
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("size", Integer),
            ],
            Integer,
        ),
        "environment_variable": DynamicLibrary.FunctionDeclaration(
            "GetEnvironmentVariableW",
            [
                DynamicLibrary.Argument("name", Buffer),
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("size", Integer),
            ],
            Integer,
        ),
        "command_line_address": DynamicLibrary.FunctionDeclaration("GetCommandLineW", [], Long),
        "wide_text_length": DynamicLibrary.FunctionDeclaration(
            "lstrlenW",
            [
                DynamicLibrary.Argument("address", Long),
            ],
            Integer,
        ),
        "copy_wide_text": DynamicLibrary.FunctionDeclaration(
            "lstrcpynW",
            [
                DynamicLibrary.Argument("room", Buffer),
                DynamicLibrary.Argument("address", Long),
                DynamicLibrary.Argument("length", Integer),
            ],
            Nothing,
        ),
    },
)
var _timer_all_access = 2031619

func sleep(duration: Duration) {
    var milliseconds = duration.total('milliseconds')
    if milliseconds <= 0 {
        var no_time: Long = 0
        _sleep_for(no_time)
        return
    }
    var no_value: Long = 0
    var high_resolution = 2
    var every_right = _timer_all_access
    var timer = _create_waitable_timer(no_value, no_value, high_resolution, every_right)
    if timer == 0 {
        _sleep_for(milliseconds)
        return
    }
    _wait_on_the_timer(timer, milliseconds)
    _close_handle(timer)
}

func _wait_on_the_timer(timer: Long, milliseconds: Long) {
    var no_value: Long = 0
    var due = Buffer(8)
    due.append_long_little_endian(milliseconds * -10000)
    var set = _set_waitable_timer(timer, due, 0, no_value, no_value, 0)
    if set == 0 {
        _sleep_for(milliseconds)
        return
    }
    var waited = _wait_for_single_object(timer, -1)
    if waited != 0 {
        _sleep_for(milliseconds)
    }
}

func working_directory(): String? {
    var size = 1024
    var room = Buffer(size * 2)
    var length = _current_directory(size, room)
    while length >= size {
        size = length
        room = Buffer(size * 2)
        length = _current_directory(size, room)
    }
    fallback length > 0
    room._take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func executable_path(): String? {
    var size = 1024
    var room = Buffer(size * 2)
    var length = _module_file_name(0, room, size)
    while length >= size and size < 32768 {
        size = size * 2
        room = Buffer(size * 2)
        length = _module_file_name(0, room, size)
    }
    fallback length > 0 and length < size
    room._take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func environment(name: String): String? {
    var wide_name = name._to_wide()
    var size = 4096
    var room = Buffer(size * 2)
    var length = _environment_variable(wide_name, room, size)
    while length >= size {
        size = length
        room = Buffer(size * 2)
        length = _environment_variable(wide_name, room, size)
    }
    fallback length != 0
    room._take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func command_line(): String {
    var address = _command_line_address()
    var length = _wide_text_length(address)
    var room = Buffer(length * 2 + 2)
    _copy_wide_text(room, address, length + 1)
    room._take_written(length * 2)
    var text = room._read_wide_string_at(0, length)
    crash text
    return text
}

func _arguments(): List<String> {
    var line = command_line()
    var pieces = List<String>()
    var piece = String()
    var quoted = false
    var started = false
    var index = 0
    while index < line.length() {
        var code = line.byte_at(index)
        if code == 34 {
            quoted = not quoted
            started = true
        } else if code == 32 and not quoted {
            if started {
                pieces.append(piece)
            }
            piece = String()
            started = false
        } else {
            piece.append_code(code)
            started = true
        }
        index = index + 1
    }
    if started {
        pieces.append(piece)
    }
    fallback pieces.remove_first()
    return pieces
}

func _loads_the_common_library() {
    load "../common"
}

func _sleep_for(milliseconds: Long) {
    var call = DynamicLibrary.Call(kernel.functions["sleep_for"])
    call.arguments["milliseconds"] = milliseconds
    call.call()
}

func _create_waitable_timer(security: Long, name: Long, flags: Integer, access: Integer): Long {
    var call = DynamicLibrary.Call(kernel.functions["create_waitable_timer"])
    call.arguments["security"] = security
    call.arguments["name"] = name
    call.arguments["flags"] = flags
    call.arguments["access"] = access
    return call.call()
}

func _close_handle(handle: Long) {
    var call = DynamicLibrary.Call(kernel.functions["close_handle"])
    call.arguments["handle"] = handle
    call.call()
}

func _set_waitable_timer(
    timer: Long,
    due: Buffer,
    period: Integer,
    completion: Long,
    argument: Long,
    resume: Integer,
): Integer {
    var call = DynamicLibrary.Call(kernel.functions["set_waitable_timer"])
    call.arguments["timer"] = timer
    call.arguments["due"] = due
    call.arguments["period"] = period
    call.arguments["completion"] = completion
    call.arguments["argument"] = argument
    call.arguments["resume"] = resume
    return call.call()
}

func _wait_for_single_object(handle: Long, milliseconds: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["wait_for_single_object"])
    call.arguments["handle"] = handle
    call.arguments["milliseconds"] = milliseconds
    return call.call()
}

func _current_directory(size: Integer, room: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["current_directory"])
    call.arguments["size"] = size
    call.arguments["room"] = room
    return call.call()
}

func _module_file_name(module: Long, room: Buffer, size: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["module_file_name"])
    call.arguments["module"] = module
    call.arguments["room"] = room
    call.arguments["size"] = size
    return call.call()
}

func _environment_variable(name: Buffer, room: Buffer, size: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["environment_variable"])
    call.arguments["name"] = name
    call.arguments["room"] = room
    call.arguments["size"] = size
    return call.call()
}

func _command_line_address(): Long {
    var call = DynamicLibrary.Call(kernel.functions["command_line_address"])
    return call.call()
}

func _wide_text_length(address: Long): Integer {
    var call = DynamicLibrary.Call(kernel.functions["wide_text_length"])
    call.arguments["address"] = address
    return call.call()
}

func _copy_wide_text(room: Buffer, address: Long, length: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["copy_wide_text"])
    call.arguments["room"] = room
    call.arguments["address"] = address
    call.arguments["length"] = length
    call.call()
}
