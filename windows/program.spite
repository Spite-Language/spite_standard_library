var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var _timer_all_access = 2031619

func sleep(duration: Duration) {
    var milliseconds = duration.total('milliseconds')
    if milliseconds <= 0 {
        var no_time: Long = 0
        kernel.Sleep(no_time)
        return
    }
    var no_value: Long = 0
    var high_resolution = 2
    var every_right = _timer_all_access
    var timer = kernel.CreateWaitableTimerExW_as_long(no_value, no_value, high_resolution, every_right)
    if timer == 0 {
        kernel.Sleep(milliseconds)
        return
    }
    _wait_on_the_timer(timer, milliseconds)
    kernel.CloseHandle(timer)
}

func _wait_on_the_timer(timer: Long, milliseconds: Long) {
    var no_value: Long = 0
    var due = Buffer(8)
    due.append_long_little_endian(milliseconds * -10000)
    var set = kernel.SetWaitableTimer(timer, due, 0, no_value, no_value, 0)
    if set == 0 {
        kernel.Sleep(milliseconds)
        return
    }
    var waited = kernel.WaitForSingleObject(timer, -1)
    if waited != 0 {
        kernel.Sleep(milliseconds)
    }
}

func working_directory(): String? {
    var size = 1024
    var room = Buffer(size * 2)
    var length = kernel.GetCurrentDirectoryW(size, room)
    while length >= size {
        size = length
        room = Buffer(size * 2)
        length = kernel.GetCurrentDirectoryW(size, room)
    }
    fallback length > 0
    room.take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func executable_path(): String? {
    var size = 1024
    var room = Buffer(size * 2)
    var length = kernel.GetModuleFileNameW(0, room, size)
    while length >= size and size < 32768 {
        size = size * 2
        room = Buffer(size * 2)
        length = kernel.GetModuleFileNameW(0, room, size)
    }
    fallback length > 0 and length < size
    room.take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func environment(name: String): String? {
    var wide_name = name._to_wide()
    var size = 4096
    var room = Buffer(size * 2)
    var length = kernel.GetEnvironmentVariableW(wide_name, room, size)
    while length >= size {
        size = length
        room = Buffer(size * 2)
        length = kernel.GetEnvironmentVariableW(wide_name, room, size)
    }
    fallback length != 0
    room.take_written(length * 2)
    return room._read_wide_string_at(0, length)
}

func command_line(): String {
    var address = kernel.GetCommandLineW_as_long()
    var length = kernel.lstrlenW(address)
    var room = Buffer(length * 2 + 2)
    kernel.lstrcpynW(room, address, length + 1)
    room.take_written(length * 2)
    var text = room._read_wide_string_at(0, length)
    crash text
    return text
}

func _arguments(): List<String> {
    var line = command_line()
    var pieces = List<String>()
    var piece = String()
    var quoted = false
    var started = false
    var index = 0
    while index < line.length() {
        var code = line.byte_at(index)
        if code == 34 {
            quoted = not quoted
            started = true
        } else if code == 32 and not quoted {
            if started {
                pieces.append(piece)
            }
            piece = String()
            started = false
        } else {
            piece.append_code(code)
            started = true
        }
        index = index + 1
    }
    if started {
        pieces.append(piece)
    }
    fallback pieces.remove_first()
    return pieces
}

func _loads_the_common_library() {
    load "../common"
}
