var sockets = DynamicLibrary("ws2_32.dll", 'identity', "")
var memory_library = DynamicLibrary("ucrtbase.dll", 'identity', "")
var nonblocking = false

func start_sockets() {
    var information = Buffer(512)
    sockets.WSAStartup(514, information)
}

func open_socket(family: Integer): Long {
    nonblocking = false
    var opened = sockets.socket_as_long(family, 1, 6)
    if opened != -1 and family == ipv6_family() {
        allow_ipv4_too(opened)
    }
    return opened
}

func ipv4_family(): Integer {
    return 2
}

func ipv6_family(): Integer {
    return 23
}

func allow_ipv4_too(opened: Long) {
    var disabled = _zeroed(4)
    sockets.setsockopt(opened, 41, 27, disabled, 4)
}

func resolve_name(host: String, hints: Buffer, found: Buffer): Integer {
    var no_service: Long = 0
    var answer = sockets.getaddrinfo(host, no_service, hints, found)
    found.take_written(8)
    return answer
}

func resolved_address_offset(): Integer {
    return 32
}

func next_entry_offset(): Integer {
    return 40
}

func read_foreign(place: Long, bytes: Integer): Buffer {
    var room = Buffer(bytes)
    var wanted: Long = bytes
    memory_library.memcpy(room, place, wanted)
    room.take_written(bytes)
    return room
}

func free_resolved(first: Long) {
    sockets.freeaddrinfo(first)
}

func bind_address(address: Buffer): Boolean {
    var length = address_length(address)
    return sockets.bind(handle, address, length) == 0
}

func listen_for_clients(): Boolean {
    return sockets.listen(handle, 64) == 0
}

func accept_handle(): Long {
    var no_address: Long = 0
    return sockets.accept_as_long(handle, no_address, no_address)
}

func connect_address(address: Buffer): Boolean {
    var length = address_length(address)
    return sockets.connect(handle, address, length) == 0
}

func receive_into(room: Buffer, bytes: Integer): Integer {
    return sockets.recv(handle, room, bytes, 0)
}

func send_text(text: String): Integer {
    var text_length = text.length()
    return sockets.send(handle, text, text_length, 0)
}

func send_from(room: Buffer, bytes: Integer): Integer {
    return sockets.send(handle, room, bytes, 0)
}

func use_blocking_calls() {
    if nonblocking {
        switch_blocking(handle, false)
        nonblocking = false
    }
}

func use_nonblocking_calls() {
    if not nonblocking {
        switch_blocking(handle, true)
        nonblocking = true
    }
}

func switch_blocking(socket: Long, enabled: Boolean) {
    var mode = Buffer(4)
    var value = 0
    if enabled {
        value = 1
    }
    mode.append_integer_little_endian(value)
    sockets.ioctlsocket(socket, -2147195266, mode)
}

func accept_now(): Long {
    use_nonblocking_calls()
    var no_address: Long = 0
    var accepted = sockets.accept_as_long(handle, no_address, no_address)
    if accepted != -1 {
        switch_blocking(accepted, false)
    }
    return accepted
}

func receive_now(room: Buffer, bytes: Integer): Integer {
    use_nonblocking_calls()
    var received = sockets.recv(handle, room, bytes, 0)
    if received > 0 {
        return received
    }
    if received < 0 and would_block() {
        return 0
    }
    return -1
}

func send_now(room: Buffer, bytes: Integer): Integer {
    use_nonblocking_calls()
    var sent = sockets.send(handle, room, bytes, 0)
    if sent >= 0 {
        return sent
    }
    if would_block() {
        return 0
    }
    return -1
}

func would_block(): Boolean {
    return sockets.WSAGetLastError() == 10035
}

func close_handle() {
    sockets.closesocket(handle)
}

func first_readable(handles: List<Long>, milliseconds: Integer): Integer {
    var count = handles.count()
    var watched = _zeroed(count * 16)
    var index = 0
    while index < count {
        var watched_handle = handles[index]
        crash watched_handle
        watched.write_long_little_endian_at(index * 16, watched_handle)
        watched.write_short_little_endian_at(index * 16 + 8, 256)
        index = index + 1
    }
    var ready = sockets.WSAPoll(watched, count, milliseconds)
    var found = -1
    if ready < 0 {
        found = -2
    }
    index = 0
    while ready > 0 and found < 0 and index < count {
        if _short_in(watched, index * 16 + 10) != 0 {
            found = index
        }
        index = index + 1
    }
    return found
}
