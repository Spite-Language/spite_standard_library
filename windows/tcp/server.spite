func _accept(socket: Long, address: Long, length: Long): Long {
    var call = DynamicLibrary.Call(sockets.functions["accept"])
    call.arguments["socket"] = socket
    call.arguments["address"] = address
    call.arguments["length"] = length
    return call.call()
}

func _control_socket(socket: Long, command: Integer, argument: Buffer) {
    var call = DynamicLibrary.Call(sockets.functions["control_socket"])
    call.arguments["socket"] = socket
    call.arguments["command"] = command
    call.arguments["argument"] = argument
    call.call()
}

func _close_socket(socket: Long) {
    var call = DynamicLibrary.Call(sockets.functions["close_socket"])
    call.arguments["socket"] = socket
    call.call()
}

func _poll(watched: Buffer, count: Integer, milliseconds: Long): Integer {
    var call = DynamicLibrary.Call(sockets.functions["poll"])
    call.arguments["watched"] = watched
    call.arguments["count"] = count
    call.arguments["milliseconds"] = milliseconds
    return call.call()
}
