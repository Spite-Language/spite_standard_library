    var call = DynamicLibrary.Call(sockets.functions["bind_socket"])
    call.arguments["socket"] = socket
    call.arguments["address"] = address
    call.arguments["length"] = length
    return call.call()
}

func _listen(socket: Long, backlog: Integer): Integer {
    var call = DynamicLibrary.Call(sockets.functions["listen"])
    call.arguments["socket"] = socket
    call.arguments["backlog"] = backlog
