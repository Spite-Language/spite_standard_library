            ],
            Integer,
        ),
    },
)
var nonblocking = false
var _winsock_version_2_2 = 514
var _nonblocking_io_control = -2147195266

func _start_sockets() {
    var information = Buffer(512)
    _socket_startup(_winsock_version_2_2, information)
}

func _open_handle(family: Integer, as_ipv6: Boolean): Long {
    nonblocking = false
    var opened = _socket(family, 1, 6)
    if opened != -1 and as_ipv6 {
        var disabled = Buffer(4)
        disabled.append_integer_little_endian(0)
        _set_socket_option(opened, 41, 27, disabled, 4)
    }
    return opened
}

func _bind_address(address: Buffer, length: Integer): Boolean {
    return _bind_socket(handle, address, length) == 0
}

func _listen_for_clients(): Boolean {
    return _listen(handle, 64) == 0
}

func _accept_handle(): Long {
    var no_address: Long = 0
    return _accept(handle, no_address, no_address)
}

func _use_blocking_calls() {
    if nonblocking {
        _switch_blocking(handle, false)
        nonblocking = false
    }
}

func _use_nonblocking_calls() {
    if not nonblocking {
        _switch_blocking(handle, true)
        nonblocking = true
    }
}

func _switch_blocking(socket: Long, enabled: Boolean) {
    var mode = Buffer(4)
    var value = 0
    if enabled {
        value = 1
    }
    mode.append_integer_little_endian(value)
    _control_socket(socket, _nonblocking_io_control, mode)
}

func _accept_handle_now(): Long {
    _use_nonblocking_calls()
    var no_address: Long = 0
    var accepted = _accept(handle, no_address, no_address)
    if accepted != -1 {
        _switch_blocking(accepted, false)
    }
    return accepted
}

func _close_handle() {
    _close_socket(handle)
}

func _first_readable(handles: List<Long>, patience: Duration): Integer {
    var milliseconds = patience.total('milliseconds')
    var count = handles.count()
    var watched = Buffer(count * 16)
    var index = 0
    while index < count * 16 {
        watched.append(0)
        index = index + 1
    }
    index = 0
    while index < count {
        var watched_handle = handles[index]
        crash watched_handle
        watched.write_long_little_endian_at(index * 16, watched_handle)
        watched.write_short_little_endian_at(index * 16 + 8, 256)
        index = index + 1
    }
    var ready = _poll(watched, count, milliseconds)
    var found = -1
    if ready < 0 {
        found = -2
    }
    index = 0
    while ready > 0 and found < 0 and index < count {
        var returned = watched.read_unsigned_short_little_endian_at(index * 16 + 10)
        crash returned
        var returned_integer: Integer? = returned
        if returned_integer != 0 {
            found = index
        }
        index = index + 1
    }
    return found
}

func _socket_startup(version: Integer, information: Buffer) {
    var call = DynamicLibrary.Call(sockets.functions["socket_startup"])
    call.arguments["version"] = version
    call.arguments["information"] = information
    call.call()
}

func _socket(family: Integer, kind: Integer, protocol: Integer): Long {
    var call = DynamicLibrary.Call(sockets.functions["socket"])
    call.arguments["family"] = family
    call.arguments["kind"] = kind
    call.arguments["protocol"] = protocol
    return call.call()
}

func _set_socket_option(socket: Long, level: Integer, option: Integer, value: Buffer, length: Integer) {
    var call = DynamicLibrary.Call(sockets.functions["set_socket_option"])
    call.arguments["socket"] = socket
    call.arguments["level"] = level
    call.arguments["option"] = option
    call.arguments["value"] = value
    call.arguments["length"] = length
    call.call()
}

