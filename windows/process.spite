var library = DynamicLibrary("ucrtbase.dll", 'identity', "")

func run_attached(): Integer? {
    var command_text = _command_line()
    var wide_command = command_text._to_wide()
    library._set_errno(0)
    var code = library._wsystem(wide_command)
    assert code != -1 or _system_error() == 0
    return code
}

func _system_error(): Integer {
    var room = Buffer(4)
    room.append_integer_little_endian(0)
    library._get_errno(room)
    var error = room.read_integer_little_endian_at(0)
    crash error
    return error
}

func _open_process(line: String): Long {
    var wide_line = line._to_wide()
    var mode = "r"
    var wide_mode = mode._to_wide()
    return library._wpopen_as_long(wide_line, wide_mode)
}

func _read_into(room: Buffer, bytes: Long, handle: Long): Long {
    var one: Long = 1
    return library.fread_as_long(room, one, bytes, handle)
}

func _close_process(handle: Long): Integer {
    return library._pclose(handle)
}

func _shell_line(line: String): String {
    if line.starts_with("\"") {
        return "\"{line}\""
    }
    return line
}

func _change_directory(folder: String): String {
    var windows_folder = folder.replace("/", "\\")
    return "cd /d \"{windows_folder}\""
}

func _set_variable(name: String, value: String): String {
    return "set \"{name}={value}\""
}

func _quoted_argument(argument: String): String {
    if not argument.is_empty() and not _needs_quotes(argument) {
        return argument
    }
    var equals = argument.index_of("=")
    if equals {
        var key = argument.slice(0, equals)
        crash key
        if equals > 0 and not _needs_quotes(key) {
            var argument_length = argument.length()
            var value = argument.slice(equals + 1, argument_length)
            crash value
            var quoted_value = _quoted_text(value)
            return "{key}={quoted_value}"
        }
    }
    return _quoted_text(argument)
}

func _needs_quotes(text: String): Boolean {
    var index = 0
    var special = " \t\n\"&|<>^"
    while index < text.length() {
        var character = text[index]
        crash character
        if special.contains(character) {
            return true
        }
        index = index + character.length()
    }
    return false
}

func _quoted_text(text: String): String {
    var quoted = "\""
    var backslashes = 0
    var index = 0
    while index < text.length() {
        var character = text[index]
        crash character
        if character == "\\" {
            backslashes = backslashes + 1
        } else {
            var is_quote = character == "\""
            var escaped = _escaped_backslashes(backslashes, is_quote)
            if is_quote {
                escaped = "{escaped}\\"
            }
            quoted = "{quoted}{escaped}{character}"
            backslashes = 0
        }
        index = index + character.length()
    }
    var closing = _escaped_backslashes(backslashes, true)
    return "{quoted}{closing}\""
}

func _escaped_backslashes(count: Integer, before_quote: Boolean): String {
    var written = count
    if before_quote {
        written = count * 2
    }
    var escaped = ""
    var index = 0
    while index < written {
        escaped = "{escaped}\\"
        index = index + 1
    }
    return escaped
}
