# ../docs/memory.md#the-numbers

var _buffer = Buffer(2)

func _value(): Short {
    return _buffer._read_short_at(0)
}

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(2)
}

func to_boolean(): Boolean {
    return _value() != 0
}

func to_byte(): Byte {
    return _value()
}

func to_tiny(): Tiny {
    return _value()
}

func to_short(): Short {
    return _value()
}

func to_unsigned_short(): UnsignedShort {
    return _value()
}

func to_integer(): Integer {
    return _value()
}

func to_unsigned_integer(): UnsignedInteger {
    return _value()
}

func to_long(): Long {
    return _value()
}

func to_unsigned_long(): UnsignedLong {
    return _value()
}

func to_float(): Float {
    return _value()
}

func to_double(): Double {
    return _value()
}

func absolute(): Short {
    var value = _value()
    if value >= 0 {
        return value
    }
    var zero: Short = 0
    return zero - value
}

func _bits_and(other: Short): Short

func _bits_or(other: Short): Short

func _bits_xor(other: Short): Short

func _bits_not(): Short

func _shifted_left(count: Integer): Short

func _shifted_right(count: Integer): Short

func _wrapping_sum(other: Short): Short

func _wrapping_subtract(other: Short): Short

func _wrapping_multiply(other: Short): Short

func bits_and(other: Short): Short {
    return _bits_and(other)
}

func bits_or(other: Short): Short {
    return _bits_or(other)
}

func bits_exclusive_or(other: Short): Short {
    return _bits_xor(other)
}

func bits_inverted(): Short {
    return _bits_not()
}

func shifted_left(count: Integer): Short {
    crash count >= 0
    if count >= 16 {
        return 0
    }
    return _shifted_left(count)
}

func shifted_right(count: Integer): Short {
    crash count >= 0
    if count >= 16 {
        var almost = _shifted_right(15)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: Short): Short {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: Short): Short {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: Short): Short {
    return _wrapping_multiply(other)
}

func clamp(lowest: Short, highest: Short): Short {
    var value = _value()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_unsigned(): UnsignedShort

func bits_as_unsigned(): UnsignedShort {
    return _bits_as_unsigned()
}

func get_largest(): Short {
    return 32767
}

func get_smallest(): Short {
    return -32768
}

func sum(other: Short): Short {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: Short): Short {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: Short): Short {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: Short): Short {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: Short): Short {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: Short): Short {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Short): Short {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: Short): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: Short): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: Short): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value: Long = _value()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 16 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 15
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 16 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}
