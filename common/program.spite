singleton

var _library = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "exit": DynamicLibrary.FunctionDeclaration("exit", [DynamicLibrary.Argument("code", Integer)], Nothing),
    },
)

func exit(code: Integer) {
    var call = DynamicLibrary.Call(_library.functions["exit"])
    call.arguments["code"] = code
    call.call()
}

func live_allocations(): Long {
    return _live_allocations()
}

func live_bytes(): Long {
    return _live_bytes()
}

func _live_allocations(): Long

func _live_bytes(): Long
