singleton

var handle: Long = 0
var file_name = ""
var header_file_name = ""

func DynamicLibrary(library_file_name: String, _naming: Symbol, header: String) {
    file_name = library_file_name
    header_file_name = header
    handle = open_library(library_file_name)
}

func open_library(library_file_name: String): Long

func close_library(library_handle: Long)

func drop() {
    close_library(handle)
}

func to_debug(): String {
    return "DynamicLibrary {file_name}"
}
