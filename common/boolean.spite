# ../docs/memory.md#the-numbers

var _buffer = Buffer(1)

func _value(): Byte {
    return _buffer._read_byte_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(1)
}

func to_string(): String {
    if _value() != 0 {
        return "true"
    }
    return "false"
}

func to_debug(): String {
    return to_string()
}

func equals(other: Boolean): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}
