# ../docs/memory.md#the-boolean

var _buffer = Buffer(1)

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(1)
}

func to_boolean(): Boolean {
    var mine = to_buffer()
    return mine.read_byte_at(0) != 0
}

func to_tiny(): Tiny {
    var mine = to_buffer()
    return mine.read_tiny_at(0)
}

func to_byte(): Byte {
    var mine = to_buffer()
    return mine.read_byte_at(0)
}

func to_short(): Short {
    var mine = to_buffer()
    return mine.read_tiny_at(0)
}

func to_unsigned_short(): UnsignedShort {
    var mine = to_buffer()
    return mine.read_tiny_at(0)
}

func to_integer(): Integer {
    var mine = to_buffer()
    return mine.read_byte_at(0)
}

func to_unsigned_integer(): UnsignedInteger {
    var mine = to_buffer()
    return mine.read_byte_at(0)
}

func to_long(): Long {
    var mine = to_buffer()
    return mine.read_byte_at(0)
}

func to_unsigned_long(): UnsignedLong {
    var mine = to_buffer()
    return mine.read_byte_at(0)
}

func to_string(): String {
    if _buffer[0] != 0 {
        return "true"
    }
    return "false"
}

func to_debug(): String {
    return to_string()
}

func equals(other: Boolean): Boolean {
    var mine = to_buffer()
    var theirs = other.to_buffer()
    return mine.compare_bytes(theirs, 0, 1) == 0
}

func less_than(other: Boolean): Boolean {
    var mine = to_buffer()
    var theirs = other.to_buffer()
    return mine.read_byte_at(0) < theirs.read_byte_at(0)
}

func greater_than(other: Boolean): Boolean {
    var mine = to_buffer()
    var theirs = other.to_buffer()
    return mine.read_byte_at(0) > theirs.read_byte_at(0)
}
