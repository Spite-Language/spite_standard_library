# ../docs/memory.md#the-numbers

var _buffer = Buffer(1)
var _smallest_value: Long = 0
var _largest_value: Long = 1

# ../docs/memory.md#the-numbers
func _set_this(value: Long) {
    crash value >= _smallest_value and value <= _largest_value
    _buffer._write_byte_at(0, value)
}

func _value(): Byte {
    return _buffer._read_byte_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(1)
}

func to_string(): String {
    if _value() != 0 {
        return "true"
    }
    return "false"
}

func to_debug(): String {
    return to_string()
}

func equals(other: Boolean): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}
