generic $value_type

var keys = Dictionary<Spite.AttributeDeclaration, String>()
var _key = ""
var _text = ""
var position = 0
var _expected = ""
var _matched = false

func read(text: String): $value_type? {
    var parsed = _continue(text, 0, "")
    _finish()
    fallback not _failed()
    return parsed
}

func _continue(text: String, start: Integer, wanted: String): $value_type {
    _text = text
    position = start
    _expected = wanted
    return _parse()
}

func _parse(): $value_type {
    if $value_type == String {
        return _read_text()
    } else if $value_type == Boolean {
        return _read_boolean()
    } else if $value_type == Number {
        return _parse_number()
    } else if $value_type == Enum {
        return _read_enum()
    } else if $value_type == Null {
        return _parse_present()
    } else if $value_type == List {
        return _parse_list()
    } else if $value_type == Dictionary {
        return _parse_dictionary()
    } else {
        return _parse_object()
    }
}

func _parse_number(): $value_type {
    var number_text = _read_number()
    var number: $value_type? = number_text
    if number {
        return number
    }
    var whole_text = _whole_part(number_text)
    var whole: $value_type? = whole_text
    if not whole {
        _fail("a number that fits")
        return 0
    }
    return whole
}

func _whole_part(number_text: String): String {
    var written = number_text
    var has_exponent = written.contains("e") or written.contains("E")
    if has_exponent {
        var decimal = written.to_double()
        crash decimal
        written = decimal.to_string()
    }
    var point = written.index_of(".")
    if not point {
        return written
    }
    var sliced = written.slice(0, point)
    crash sliced
    return sliced
}

func _parse_present(): $value_type {
    var is_null = _read_null()
    if is_null {
        return null
    }
    var inner = JsonReader<$value_type.value_type>()
    var item = inner._continue(_text, position, _expected)
    position = inner.position
    _expected = inner._expected
    return item
}

func _parse_list(): $value_type {
    var list = $value_type()
    var element_json = JsonReader<$value_type.element_type>()
    _expect("[")
    var more = not _consume("]")
    while more and not _failed() {
        var element = element_json._continue(_text, position, _expected)
        position = element_json.position
        _expected = element_json._expected
        list.append(element)
        more = _consume(",")
        if not more {
            _expect("]")
        }
    }
    return list
}

func _parse_dictionary(): $value_type {
    var dictionary = $value_type()
    var entry_json = JsonReader<$value_type.value_type>()
    _expect("\{")
    var more = not _consume("}")
    while more and not _failed() {
        var key_text = _read_text()
        var key: $value_type.key_type? = key_text
        if not key {
            _fail("a key that fits the dictionary")
            return dictionary
        }
        _expect(":")
        var entry = entry_json._continue(_text, position, _expected)
        position = entry_json.position
        _expected = entry_json._expected
        dictionary[key] = entry
        more = _consume(",")
        if not more {
            _expect("}")
        }
    }
    return dictionary
}

func _parse_object(): $value_type {
    var created = $value_type()
    _expect("\{")
    var more = not _consume("}")
    while more and not _failed() {
        var key = _read_text()
        _expect(":")
        _matched = false
        _key = key
        read_attributes(created)
        if not _matched {
            read_camel_attributes(created)
        }
        if not _matched {
            _skip_value()
        }
        more = _consume(",")
        if not more {
            _expect("}")
        }
    }
    return created
}


func read_attribute(attribute: Spite.AttributeDeclaration, created: $value_type) {
    var name = attribute.name
    fallback not name.starts_with("_")
    fallback not attribute.class.is_singleton
    var key = name
    var given = keys[attribute]
    if given and not keys.is_empty() {
        key = given
    }
    fallback _key == key
    var attribute_json = JsonReader<attribute.class>()
    created[attribute] = attribute_json._continue(_text, position, _expected)
    position = attribute_json.position
    _expected = attribute_json._expected
    _matched = true
}

func read_camel_attribute(attribute: Spite.AttributeDeclaration, created: $value_type) {
    var name = attribute.name
    fallback not name.starts_with("_")
    fallback not attribute.class.is_singleton
    var given = keys[attribute]
    var is_renamed = given and not keys.is_empty()
    fallback not is_renamed
    fallback _key == attribute.camel_case_name or _key == attribute.pascal_case_name
    var attribute_json = JsonReader<attribute.class>()
    created[attribute] = attribute_json._continue(_text, position, _expected)
    position = attribute_json.position
    _expected = attribute_json._expected
    _matched = true
}


func _read_enum(): $value_type {
    var name = _read_text()
    var symbol: $value_type? = name
    if symbol {
        return symbol
    }
    var unnamed = $value_type()
    _fail("one of the names of {unnamed.class.name}")
    return unnamed
}


func _failed(): Boolean {
    return not _expected.is_empty()
}

func _fail(wanted: String) {
    if _expected.is_empty() {
        _expected = wanted
    }
}

func _finish() {
    _skip_space()
    if position < _text.length() {
        _fail("the end of the text")
    }
}

func _skip_space() {
    var spacing = true
    while spacing and position < _text.length() {
        var code = _text.byte_at(position)
        spacing = code == 32 or code == 9 or code == 10 or code == 13
        if spacing {
            position = position + 1
        }
    }
}

func _consume(token: String): Boolean {
    _skip_space()
    var end = position + token.length()
    fallback end <= _text.length()
    var found = _text.slice(position, end)
    crash found
    if found == token {
        position = end
        return true
    }
    return false
}

func _expect(token: String) {
    var found = _consume(token)
    if not found {
        _fail("'{token}'")
    }
}

func _read_null(): Boolean {
    return _consume("null")
}

func _read_boolean(): Boolean {
    var is_true = _consume("true")
    if is_true {
        return true
    }
    var is_false = _consume("false")
    if not is_false {
        _fail("true or false")
    }
    return false
}

func _read_number(): String {
    _skip_space()
    var start = position
    _skip_number()
    if _failed() {
        return "0"
    }
    var sliced = _text.slice(start, position)
    crash sliced
    return sliced
}

func _skip_number() {
    _skip_if(45)
    var whole_digits = _skip_digits()
    if whole_digits == 0 {
        _fail("a number")
        return
    }
    if _skip_character(46) {
        var fraction_digits = _skip_digits()
        if fraction_digits == 0 {
            _fail("a digit after '.'")
        }
    }
    if _skip_character(101) or _skip_character(69) {
        if not _skip_character(43) {
            _skip_if(45)
        }
        var exponent_digits = _skip_digits()
        if exponent_digits == 0 {
            _fail("a digit in the exponent")
        }
    }
}

func _skip_text() {
    var skipped = _read_text()
    fallback not skipped.is_empty()
}

func _read_text(): String {
    var opened = _consume("\"")
    if not opened {
        _fail("text in double quotes")
        return ""
    }
    var made = String()
    var start = position
    var closed = false
    while not closed and position < _text.length() and _expected.is_empty() {
        var code = _text.byte_at(position)
        if code == 34 {
            var last_run = _text.slice(start, position)
            crash last_run
            made = made + last_run
            position = position + 1
            closed = true
        } else if code == 92 {
            var run = _text.slice(start, position)
            crash run
            var escaped = _read_escape()
            made = made + run + escaped
            start = position
        } else {
            position = position + 1
        }
    }
    if not closed {
        _fail("'\"' to close the text")
    }
    return made
}

func _read_escape(): String {
    position = position + 1
    var code = 0
    if position < _text.length() {
        code = _text.byte_at(position)
    }
    position = position + 1
    if code == 34 or code == 92 or code == 47 {
        var sliced = _text.slice(position - 1, position)
        crash sliced
        return sliced
    }
    switch code {
        110: return "\n"
        116: return "\t"
        114: return "\r"
        98: return _text_of(8)
        102: return _text_of(12)
        _: return _unicode_escape_of(code)
    }
}

func _unicode_escape_of(code: Integer): String {
    if code != 117 {
        _fail("an escape: one of \\\" \\\\ \\/ \\b \\f \\n \\r \\t \\u")
        return ""
    }
    var code_point = _read_hexadecimal()
    if code_point >= 55296 and code_point < 56320 and _consume("\\u") {
        var low = _read_hexadecimal()
        code_point = 65536 + (code_point - 55296) * 1024 + low - 56320
    }
    return _text_of(code_point)
}

func _read_hexadecimal(): Integer {
    var value = 0
    var digits = 0
    while digits < 4 {
        var digit = _hexadecimal_digit(position)
        if digit < 0 {
            _fail("four hexadecimal digits after \\u")
            return 0
        }
        value = value * 16 + digit
        position = position + 1
        digits = digits + 1
    }
    return value
}

func _hexadecimal_digit(at: Integer): Integer {
    if at >= _text.length() {
        return -1
    }
    var code = _text.byte_at(at)
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    if code >= 65 and code <= 70 {
        return code - 55
    }
    return -1
}

func _text_of(code_point: Integer): String {
    var result = String()
    var shift = 0
    var lead_marker = 0
    if code_point >= 65536 {
        shift = 18
        lead_marker = 240
    } else if code_point >= 2048 {
        shift = 12
        lead_marker = 224
    } else if code_point >= 128 {
        shift = 6
        lead_marker = 192
    }
    var moved = code_point.shifted_right(shift)
    var lead = moved.bits_or(lead_marker)
    result.append_code(lead)
    while shift > 0 {
        shift = shift - 6
        var part = code_point.shifted_right(shift)
        var low_bits = part.bits_and(63)
        var continuation = low_bits.bits_or(128)
        result.append_code(continuation)
    }
    return result
}

func _skip_if(code: Integer) {
    fallback _skip_character(code)
}

func _skip_character(code: Integer): Boolean {
    if position < _text.length() and _text.byte_at(position) == code {
        position = position + 1
        return true
    }
    return false
}

func _skip_digits(): Integer {
    var start = position
    var digit = true
    while digit and position < _text.length() {
        var code = _text.byte_at(position)
        digit = code >= 48 and code <= 57
        if digit {
            position = position + 1
        }
    }
    return position - start
}

func _skip_value() {
    _skip_space()
    if position >= _text.length() {
        _fail("a value")
        return
    }
    var code = _text.byte_at(position)
    if code == 34 {
        _skip_text()
    } else if code == 123 {
        _skip_members()
    } else if code == 91 {
        _skip_elements()
    } else {
        _skip_word()
    }
}

func _skip_word() {
    var is_true = _consume("true")
    var is_false = _consume("false")
    var is_null = _read_null()
    if not is_true and not is_false and not is_null {
        _skip_space()
        _skip_number()
    }
}

func _skip_members() {
    _expect("\{")
    var more = not _consume("}")
    while more and _expected.is_empty() {
        _skip_text()
        _expect(":")
        _skip_value()
        more = _consume(",")
        if not more {
            _expect("}")
        }
    }
}

func _skip_elements() {
    _expect("[")
    var more = not _consume("]")
    while more and _expected.is_empty() {
        _skip_value()
        more = _consume(",")
        if not more {
            _expect("]")
        }
    }
}
