var _largest_buffer_length: Long = 2147483647
var path: String

func File(starting_path: Path) {
    path = starting_path.written
}

func move_to(new_path: Path): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place and not new_path.is_on_a_volume
    }
    var file_there = File(new_path)
    var folder_there = Directory(new_path)
    var file_exists = file_there.exists()
    var folder_exists = folder_there.exists()
    fallback not file_exists and not folder_exists
    var renamed = _rename_to(new_path.written)
    if renamed {
        path = new_path.written
    }
    return renamed
}

func get_file_name(): String {
    var end = path.length()
    while end > 1 and path.byte_at(end - 1) == 47 {
        end = end - 1
    }
    var start = end
    while start > 0 and path.byte_at(start - 1) != 47 and path.byte_at(start - 1) != 92 {
        start = start - 1
    }
    var sliced = path.slice(start, end)
    crash sliced
    return sliced
}

func to_string(): String {
    return path
}

func read_as_string(): String? {
    var bytes = read_as_buffer()
    fallback bytes
    return bytes.read_as_string()
}

func write_string(text: String): Boolean {
    return _put(text, "wb")
}

func append_string(text: String): Boolean {
    return _put(text, "ab")
}

func byte_count(): Long? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            var preloaded = place._preloaded_bytes()
            fallback preloaded
            var counted: Long = preloaded.count()
            return counted
        }
    }
    var handle = _open_handle("rb")
    fallback handle != 0
    var sought = _seek(handle, 0, 2)
    var bytes = _tell(handle)
    var closed = _close_handle(handle)
    fallback sought == 0 and bytes >= 0 and closed == 0
    return bytes
}

func last_written(): Instant? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var nanoseconds = _modified_nanoseconds_since_1970()
    fallback nanoseconds
    var whole = Duration(nanoseconds / 1000000000, 'seconds')
    var part = Duration(nanoseconds % 1000000000, 'nanoseconds')
    var since_1970 = whole + part
    return Instant(since_1970)
}

func read_as_buffer(): Buffer? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            var preloaded = place._preloaded_bytes()
            fallback preloaded
            return preloaded.copy()
        }
    }
    var handle = _open_handle("rb")
    fallback handle != 0
    var sought = _seek(handle, 0, 2)
    var length = _tell(handle)
    var rewound = _seek(handle, 0, 0)
    if sought != 0 or rewound != 0 or length < 0 or length > _largest_buffer_length {
        fallback _close_handle(handle) == 0
        return null
    }
    var bytes = _read_into_buffer(handle, length)
    var closed = _close_handle(handle)
    fallback bytes
    fallback closed == 0 and length == bytes.count()
    return bytes
}

func read_buffer_at(position: Long, count: Integer): Buffer? {
    crash position >= 0 and count >= 0
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            return _preloaded_part(place, position, count)
        }
    }
    var handle = _open_handle("rb")
    fallback handle != 0
    var sought_end = _seek(handle, 0, 2)
    var end = _tell(handle)
    var available = end - position
    if available > count {
        available = count
    }
    if available < 0 {
        available = 0
    }
    var sought = _seek(handle, position, 0)
    if sought_end != 0 or end < 0 or sought != 0 {
        fallback _close_handle(handle) == 0
        return null
    }
    var bytes = _read_into_buffer(handle, available)
    var closed = _close_handle(handle)
    fallback bytes
    var got_count: Long = bytes.count()
    fallback closed == 0 and got_count == available
    return bytes
}

func write_buffer(bytes: Buffer): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var handle = _open_handle("wb")
    fallback handle != 0
    var written = _write_buffer(bytes, handle)
    var closed = _close_handle(handle)
    var counted: Long = bytes.count()
    return written == counted and closed == 0
}

func append_buffer(bytes: Buffer): Long? {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var handle = _open_handle("ab")
    fallback handle != 0
    var sought = _seek(handle, 0, 2)
    var start = _tell(handle)
    var written = _write_buffer(bytes, handle)
    var closed = _close_handle(handle)
    var counted: Long = bytes.count()
    fallback sought == 0 and start >= 0 and written == counted and closed == 0
    return start
}

func _read_into_buffer(handle: Long, wanted: Long): Buffer? {
    var counted: Integer? = wanted
    crash counted
    var bytes = Buffer(counted)
    if wanted > 0 {
        var got = _read_into(bytes, wanted, handle)
        fallback got >= 0 and got <= wanted
        var got_count: Integer? = got
        crash got_count
        bytes.take_written(got_count)
    }
    return bytes
}

func _write_buffer(bytes: Buffer, handle: Long): Long {
    var counted: Long = bytes.count()
    fallback counted != 0
    return _write_from(bytes, counted, handle)
}

func _put(text: String, mode: String): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place
    }
    var handle = _open_handle(mode)
    fallback handle != 0
    var written = _write_text(text, handle)
    var closed = _close_handle(handle)
    var length: Long = text.length()
    return written == length and closed == 0
}

# ../../spite_documentation/programs.md#preloaded-files
func _has_volumes(): Boolean

func _place_on_a_volume(): Path? {
    var place: Path? = path
    fallback place
    fallback place.is_on_a_volume
    return place
}

func _preloaded_part(place: Path, position: Long, count: Integer): Buffer? {
    var preloaded = place._preloaded_bytes()
    fallback preloaded
    var length: Long = preloaded.count()
    var available = length - position
    if available > count {
        available = count
    }
    if available <= 0 {
        return Buffer(0)
    }
    var start: Integer? = position
    crash start
    var wanted: Integer? = available
    crash wanted
    var part = Buffer(wanted)
    part.append_buffer(preloaded, start, wanted)
    return part
}
