singleton

var _no_offset = Duration(0, 'seconds')
var _utc = TimeZone("UTC", _no_offset)

func utc(): TimeZone {
    return _utc
}

func fixed_offset(offset: Duration): TimeZone {
    var identifier = offset._written_as_offset()
    return TimeZone(identifier, offset)
}

func read_tzif(identifier: String, data: Buffer): TimeZone? {
    var zone = TimeZone(identifier, _no_offset)
    var read = zone._read_tzif(data)
    fallback read
    return zone
}
