var _name = ""
var _name_with_namespaces = ""
var _owner: Spite.Class = Nothing

func Type(starting_name: String, starting_name_with_namespaces: String, starting_owner: Spite.Class) {
    _name = starting_name
    _name_with_namespaces = starting_name_with_namespaces
    _owner = starting_owner
}

func get_name(): String {
    return _name
}

func get_name_with_namespaces(): String {
    return _name_with_namespaces
}

func get_owner(): Spite.Class {
    return _owner
}

func equals(other: Type): Boolean {
    return _name_with_namespaces == other._name_with_namespaces
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
