var _name: String
var _name_with_namespaces: String
var _namespace: Spite.Namespace?
var _is_singleton: Boolean
var _is_enum: Boolean
var _is_optional: Boolean
var _is_list: Boolean
var _is_dictionary: Boolean
var _is_stateful: Boolean
var _is_fixed_size: Boolean
var _generics: Dictionary<String, Spite.Class>
var _attributes: Dictionary<String, Spite.AttributeDeclaration>
var _functions: Dictionary<String, Spite.FunctionDeclaration>
var _enums: Dictionary<String, Spite.Enum>
var _unions: Dictionary<String, Spite.Union>
var _types: Dictionary<String, Spite.Type>
var _has_no_stand_in: Boolean
var _source_files: List<File>

func Class(
    starting_name: String,
    starting_name_with_namespaces: String,
    starting_namespace: Spite.Namespace?,
    starting_is_singleton: Boolean,
    starting_is_enum: Boolean,
    starting_is_optional: Boolean,
    starting_is_list: Boolean,
    starting_is_dictionary: Boolean,
    starting_is_stateful: Boolean,
    starting_is_fixed_size: Boolean,
    starting_has_no_stand_in: Boolean,
    starting_generics: Dictionary<String, Spite.Class>,
    starting_attributes: Dictionary<String, Spite.AttributeDeclaration>,
    starting_functions: Dictionary<String, Spite.FunctionDeclaration>,
    starting_enums: Dictionary<String, Spite.Enum>,
    starting_unions: Dictionary<String, Spite.Union>,
    starting_types: Dictionary<String, Spite.Type>,
    starting_source_files: List<File>,
) {
    _name = starting_name
    _name_with_namespaces = starting_name_with_namespaces
    _namespace = starting_namespace
    _is_singleton = starting_is_singleton
    _is_enum = starting_is_enum
    _is_optional = starting_is_optional
    _is_list = starting_is_list
    _is_dictionary = starting_is_dictionary
    _is_stateful = starting_is_stateful
    _is_fixed_size = starting_is_fixed_size
    _has_no_stand_in = starting_has_no_stand_in
    _generics = starting_generics
    _attributes = starting_attributes
    _functions = starting_functions
    _enums = starting_enums
    _unions = starting_unions
    _types = starting_types
    _source_files = starting_source_files
}

func get_name(): String {
    return _name
}

func get_name_with_namespaces(): String {
    return _name_with_namespaces
}

func get_namespace(): Spite.Namespace? {
    return _namespace
}

func get_attributes(): Dictionary<String, Spite.AttributeDeclaration> {
    return _attributes
}

func get_functions(): Dictionary<String, Spite.FunctionDeclaration> {
    return _functions
}

func get_enums(): Dictionary<String, Spite.Enum> {
    return _enums
}

func get_unions(): Dictionary<String, Spite.Union> {
    return _unions
}

func get_types(): Dictionary<String, Spite.Type> {
    return _types
}

func get_is_singleton(): Boolean {
    return _is_singleton
}

func get_source_files(): List<File> {
    return _source_files
}

func get_is_optional(): Boolean {
    return _is_optional
}

func get_is_enum(): Boolean {
    return _is_enum
}

func get_is_stateful(): Boolean {
    return _is_stateful
}

func get_is_fixed_size(): Boolean {
    return _is_fixed_size
}

func get_is_list(): Boolean {
    return _is_list
}

func get_is_dictionary(): Boolean {
    return _is_dictionary
}

func get_generics(): Dictionary<String, Spite.Class> {
    return _generics
}

func fits_vector(): Boolean {
    return _is_fixed_size
}

func has_function(name: String): Boolean {
    crash not _has_no_stand_in
    var functions = _functions.values()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name_fits(name) {
            return true
        }
        index = index + 1
    }
    return false
}

func argument_count(name: String): Integer {
    crash has_function(name)
    var functions = _functions.values()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name_fits(name) {
            return function.argument_count()
        }
        index = index + 1
    }
    crash
}

func function_waits(name: String): Boolean {
    crash not _has_no_stand_in
    var functions = _functions.values()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name_fits(name) and function.is_resumable {
            return true
        }
        index = index + 1
    }
    return false
}

func satisfies_type(_wanted: Spite.Type): Boolean {
    crash
}

func equals(other: Class): Boolean {
    return _name_with_namespaces == other._name_with_namespaces
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
