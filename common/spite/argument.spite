var _name = ""
var _class = Spite.Class("Nothing")
var _index = 0
var _is_mutated = false
var _has_facts = false

func Argument(starting_name: String, starting_index: Integer) {
    _name = starting_name
    _index = starting_index
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_index(): Integer {
    return _index
}

func get_is_mutated(): Boolean {
    crash _has_facts
    return _is_mutated
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
