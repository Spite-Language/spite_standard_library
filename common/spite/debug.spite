generic $value_type

func text(value: $value_type): String {
    if $value_type == Enum {
        return "'{value}'"
    } else if $value_type == Null {
        if value {
            var inner = Spite.Debug<$value_type.value_type>()
            return inner.text(value)
        }
        return "null"
    } else {
        return value.to_debug()
    }
}
