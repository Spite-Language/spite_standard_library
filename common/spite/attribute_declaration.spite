var _name = ""
var _class: Spite.Class? = null
var _index = 0
var _source_file: File? = null

func AttributeDeclaration(starting_name: String, starting_index: Integer) {
    _name = starting_name
    _index = starting_index
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class? {
    return _class
}

func get_index(): Integer {
    return _index
}

func get_source_file(): File {
    crash _source_file
    return _source_file
}

func get_is_singleton(): Boolean {
    if _class {
        return _class.is_singleton
    }
    return false
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
