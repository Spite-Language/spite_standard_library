var _name: String
var _class: Spite.Class = Nothing
var _index: Integer
var _source_path: String

func AttributeDeclaration(
    starting_name: String,
    starting_index: Integer,
    starting_class: Spite.Class,
    starting_source_path: String,
) {
    _name = starting_name
    _index = starting_index
    _class = starting_class
    _source_path = starting_source_path
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_index(): Integer {
    return _index
}

func get_source_file(): File {
    var source_path: Path? = _source_path
    crash source_path
    return File(source_path)
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
