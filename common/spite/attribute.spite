# ../../../spite_documentation/reflection.md#spiteattribute
generic $value

var _name: String
var _class: Spite.Class = Nothing
var _value: $value
var _index: Integer
var _declaration = Spite.AttributeDeclaration("", 0, Nothing, Nothing, "")
var _writer: Spite.Function<$value, Nothing>?

func Attribute(
    starting_name: String,
    starting_index: Integer,
    starting_class: Spite.Class,
    starting_declaration: Spite.AttributeDeclaration,
    starting_value: $value,
    starting_writer: Spite.Function<$value, Nothing>?,
) {
    _name = starting_name
    _index = starting_index
    _class = starting_class
    _declaration = starting_declaration
    _value = starting_value
    _writer = starting_writer
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_value(): $value {
    return _value
}

func set_value(value: $value) {
    crash _writer
    _writer(value)
    _value = value
}

func get_owner_class(): Spite.Class {
    return _declaration.owner_class
}

func get_index(): Integer {
    return _index
}

func get_declaration(): Spite.AttributeDeclaration {
    return _declaration
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
