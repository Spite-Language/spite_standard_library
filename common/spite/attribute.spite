var _name: String
var _class: Spite.Class = Nothing
# ../../../spite_documentation/functions_and_operators.md#null-only-goes-where-a-t-is-wanted
var _value: Anything?
var _index: Integer
var _declaration = Spite.AttributeDeclaration("", 0, Nothing, "")
var _owner: Anything

func Attribute(
    starting_name: String,
    starting_index: Integer,
    starting_class: Spite.Class,
    starting_declaration: Spite.AttributeDeclaration,
    starting_owner: Anything,
    starting_value: Anything?,
) {
    _name = starting_name
    _index = starting_index
    _class = starting_class
    _declaration = starting_declaration
    _owner = starting_owner
    _value = starting_value
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_value(): Anything? {
    return _value
}

func get_index(): Integer {
    return _index
}

func get_declaration(): Spite.AttributeDeclaration {
    return _declaration
}

func get_owner(): Anything {
    return _owner
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
