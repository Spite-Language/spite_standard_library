var _name = ""
var _class = Spite.Class("Nothing")
var _value: Anything? = null
var _index = 0
var _declaration: Spite.AttributeDeclaration? = null
var _owner: Anything? = null

func Attribute(starting_name: String, starting_index: Integer) {
    _name = starting_name
    _index = starting_index
}

func get_name(): String {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_value(): Anything? {
    return _value
}

func get_index(): Integer {
    return _index
}

func get_declaration(): Spite.AttributeDeclaration {
    crash _declaration
    return _declaration
}

func get_owner(): Anything {
    crash _owner
    return _owner
}

func get_is_singleton(): Boolean {
    return _class.is_singleton
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
