# https://github.com/Spite-Language/spite_documentation/blob/master/reflection.md#a-call-built-before-it-runs
generic $instance

var _declaration = Spite.FunctionDeclaration("", "", 0, [], Nothing, false, false, false, null, null, [], [], "", "", "")
var _instance: $instance

func Call(starting_declaration: Spite.FunctionDeclaration, starting_instance: $instance) {
    _declaration = starting_declaration
    _instance = starting_instance
}

func call() {
    _declaration._call_on(_instance)
}
