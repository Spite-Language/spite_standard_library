var _declaration = Spite.Function("")
var _instance: Anything? = null
var _arguments = Dictionary<String, Anything>()

func Call(starting_declaration: Spite.Function, starting_instance: Anything) {
    _declaration = starting_declaration
    _instance = starting_instance
}

func get_arguments(): Dictionary<String, Anything> {
    return _arguments
}

func call() {
    crash _instance
    _declaration._call_on(_instance)
}
