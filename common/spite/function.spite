var _name = ""
var _declaration = Spite.FunctionDeclaration("", "", 0, [], Nothing, false, false, false, null, null, [], [], "", "")
var _owner: Anything = ""
var _called: Spite.Function<Nothing> = _not_made
var _value: Spite.Function<Nothing> = _not_made

func Function(
    starting_name: String,
    starting_declaration: Spite.FunctionDeclaration,
    starting_owner: Anything,
    starting_called: Spite.Function<Nothing>,
    starting_value: Spite.Function<Nothing>,
) {
    _name = starting_name
    _declaration = starting_declaration
    _owner = starting_owner
    _called = starting_called
    _value = starting_value
}

func _not_made() {
    crash
}

func get_name(): String {
    return _name
}

func get_declaration(): Spite.FunctionDeclaration {
    return _declaration
}

func get_owner(): Anything {
    return _owner
}

func call_function() {
    var called = _called
    called()
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
