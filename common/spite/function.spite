var _name = ""
var _declaration = Spite.FunctionDeclaration("", "", 0, Nothing, "", "")
var _owner: Anything = ""
var _called: Spite.Function<Nothing>? = null
var _value: Spite.Function<Nothing>? = null

func Function(starting_name: String, starting_declaration: Spite.FunctionDeclaration, starting_owner: Anything) {
    _name = starting_name
    _declaration = starting_declaration
    _owner = starting_owner
}

func get_name(): String {
    return _name
}

func get_declaration(): Spite.FunctionDeclaration {
    return _declaration
}

func get_owner(): Anything {
    return _owner
}

func call_function() {
    crash _called
    var called = _called
    called()
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
