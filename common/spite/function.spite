var _name = ""
var _arguments = List<Spite.Argument>()
var _returns: Spite.Class? = null
var _is_resumable = false
var _has_facts = false
var _has_accesses = false
var _returned_literal: String? = null
var _called: Spite.Function<Nothing>? = null
var _called_on: Spite.Function<Anything, Dictionary<String, Anything>, Nothing>? = null
var _accesses = List<Spite.Access>()
var _accessed_names = List<String>()

func Function(starting_name: String) {
    _name = starting_name
}

func get_name(): String {
    return _name
}

func get_arguments(): List<Spite.Argument> {
    return _arguments
}

func get_returns(): Spite.Class? {
    return _returns
}

func get_is_resumable(): Boolean {
    crash _has_facts
    return _is_resumable
}

func get_returned_literal(): String {
    crash _returned_literal
    return _returned_literal
}

func get_accesses(): Dictionary<String, Spite.Access> {
    crash _has_accesses
    var accesses = Dictionary<String, Spite.Access>()
    var index = 0
    while index < _accesses.count() {
        var access = _accesses[index]
        var name = _accessed_names[index]
        crash name
        if access.is_read or access.is_written {
            accesses[name] = access
        }
        index = index + 1
    }
    return accesses
}

func call_function() {
    crash _called
    var called = _called
    called()
}

func _call_on(instance: Anything, arguments: Dictionary<String, Anything>) {
    crash _called_on
    var called = _called_on
    called(instance, arguments)
}

func argument_count(): Integer {
    return _arguments.count()
}

func name_fits(pattern: String): Boolean {
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening and closing {
        return _fits_around(pattern, opening, closing)
    }
    return _name == pattern
}

func _fits_around(pattern: String, opening: Integer, closing: Integer): Boolean {
    if closing < opening {
        return _name == pattern
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    var suffix = pattern.slice(closing + 1, pattern_length)
    var prefix_length = prefix.length()
    var suffix_length = suffix.length()
    var name_length = _name.length()
    var long_enough = name_length > prefix_length + suffix_length
    return long_enough and _name.starts_with(prefix) and _name.ends_with(suffix)
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
