func clamp(low: Double, high: Double): Double {
    var value = _value()
    var lowest = low._value()
    var highest = high._value()
    if value != value {
        return value
    }
    if lowest != lowest {
        return lowest
    }
    if highest != highest {
        return highest
    }
    var held = value
    if held < lowest {
        held = lowest
    }
    if held > highest {
        held = highest
    }
    return held
}

func is_not_a_number(): Boolean {
    var value = _value()
    return value != value
}

func is_finite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference == 0.0
}

func is_infinite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference != 0.0 and value == value
}

func negate(): Double {
    var value = _value()
    var minus_one: Double = -1.0
    return value * minus_one
}

func get_pi(): Double {
    return 3.141592653589793
}

func get_tau(): Double {
    return 6.283185307179586
}

func get_euler_number(): Double {
    return 2.718281828459045
}

func get_infinity(): Double {
    var one: Double = 1.0
    var zero: Double = 0.0
    return one / zero
}

func get_not_a_number(): Double {
    var zero: Double = 0.0
    return zero / zero
}

func get_largest(): Double {
    var pattern: Long = 9218868437227405311
    return pattern.bits_as_double()
}

func get_smallest(): Double {
    var largest = get_largest()
    var zero: Double = 0.0
    return zero - largest
}
