# ../../spite_documentation/collections.md#a-list-tells-its-changes

generic $item_type

enum Kind {
    'appended'
    'inserted'
    'set'
    'removed'
    'cleared'
    'rewritten'
}

var kind: Kind
var index: Integer
var item: $item_type?

func ListChange(starting_kind: Kind, starting_index: Integer, starting_item: $item_type?) {
    kind = starting_kind
    index = starting_index
    item = starting_item
}
