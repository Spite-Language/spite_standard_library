# ../docs/memory.md#the-string

var _buffer = Buffer(16)
var _length = 0

func length(): Integer {
    return _length
}

func is_empty(): Boolean {
    return _length == 0
}

func code_at(index: Integer): Integer {
    return _buffer._read_byte_at(index)
}

func append_code(code: Integer) {
    _buffer.append(code)
    _length = _length + 1
}

func character_at(index: Integer): String {
    var character = String()
    var code = code_at(index)
    character.append_code(code)
    return character
}

func slice(start: Integer, end: Integer): String {
    var first = _clamped(start)
    var last = _clamped(end)
    if last <= first {
        return String()
    }
    var sliced = String()
    var index = first
    while index < last {
        var code = code_at(index)
        sliced.append_code(code)
        index = index + 1
    }
    return sliced
}

func _clamped(position: Integer): Integer {
    if position < 0 {
        return 0
    }
    if _length < position {
        return _length
    }
    return position
}

func sum(other: String): String {
    var summed = String()
    var index = 0
    while index < _length {
        var code = code_at(index)
        summed.append_code(code)
        index = index + 1
    }
    var other_index = 0
    while other_index < other.length() {
        var code = other.code_at(other_index)
        summed.append_code(code)
        other_index = other_index + 1
    }
    return summed
}

func equals(other: String): Boolean {
    if _length != other.length() {
        return false
    }
    var index = 0
    while index < _length {
        if code_at(index) != other.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func less_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = code_at(index)
        var theirs = other.code_at(index)
        if mine != theirs {
            return mine < theirs
        }
        index = index + 1
    }
    return _length < other.length()
}

func greater_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = code_at(index)
        var theirs = other.code_at(index)
        if mine != theirs {
            return mine > theirs
        }
        index = index + 1
    }
    return _length > other.length()
}

func starts_with(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var index = 0
    while index < text.length() {
        if code_at(index) != text.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func ends_with(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var index = text.length()
    while index > 0 {
        var text_length = text.length()
        var mine = code_at(_length - text_length + index - 1)
        var theirs = text.code_at(index - 1)
        if mine != theirs {
            return false
        }
        index = index - 1
    }
    return true
}

func contains(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var start = 0
    while start + text.length() <= _length {
        if _starts_the_text_at(start, text) {
            return true
        }
        start = start + 1
    }
    return false
}

func _starts_the_text_at(start: Integer, text: String): Boolean {
    var index = 0
    while index < text.length() {
        if code_at(start + index) != text.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func split(separator: String): List<String> {
    var pieces = List<String>()
    var piece = String()
    var index = 0
    while index < _length {
        if _starts_the_separator_at(index, separator) {
            pieces.append(piece)
            piece = String()
            index = index + separator.length()
        } else {
            var code = code_at(index)
            piece.append_code(code)
            index = index + 1
        }
    }
    pieces.append(piece)
    return pieces
}

func _starts_the_separator_at(index: Integer, separator: String): Boolean {
    if index + separator.length() > _length {
        return false
    }
    return _starts_the_text_at(index, separator)
}

func to_long(): Long? {
    var text = trim()
    var size = text._length
    var index = 0
    var negative = false
    if size > 0 and (text.code_at(0) == 45 or text.code_at(0) == 43) {
        negative = text.code_at(0) == 45
        index = 1
    }
    var digits_start = index
    var value: Long = 0
    while index < size and text.code_at(index) >= 48 and text.code_at(index) <= 57 {
        var digit: Long = text.code_at(index) - 48
        assert value >= (Long.smallest + digit) / 10
        value = value * 10 - digit
        index = index + 1
    }
    assert index > digits_start and index == size
    if negative {
        return value
    }
    assert value != Long.smallest
    return 0 - value
}

func to_double(): Double? {
    var text = trim()
    var valid = text._is_decimal()
    assert valid
    var library = DynamicLibrary("ucrtbase.dll")
    var end: Long = 0
    return library.strtod_as_double(text, end)
}

func to_float(): Float? {
    var text = trim()
    var valid = text._is_decimal()
    assert valid
    var library = DynamicLibrary("ucrtbase.dll")
    var end: Long = 0
    return library.strtof_as_float(text, end)
}

func _is_decimal(): Boolean {
    var index = 0
    if _length > 0 and _is_sign_at(0) {
        index = 1
    }
    var whole_end = _digits_end(index)
    var digits = whole_end - index
    index = whole_end
    if index < _length and code_at(index) == 46 {
        var fraction_end = _digits_end(index + 1)
        digits = digits + fraction_end - index - 1
        index = fraction_end
    }
    if digits == 0 {
        return false
    }
    if index < _length and (code_at(index) == 101 or code_at(index) == 69) {
        index = index + 1
        if index < _length and _is_sign_at(index) {
            index = index + 1
        }
        var exponent_end = _digits_end(index)
        if exponent_end == index {
            return false
        }
        index = exponent_end
    }
    return index == _length
}

func _is_sign_at(index: Integer): Boolean {
    var code = code_at(index)
    return code == 45 or code == 43
}

func _digits_end(start: Integer): Integer {
    var index = start
    while index < _length and code_at(index) >= 48 and code_at(index) <= 57 {
        index = index + 1
    }
    return index
}

func to_integer(): Integer? {
    var value = to_long()
    assert value and value >= Integer.smallest and value <= Integer.largest
    return value
}

func to_tiny(): Tiny? {
    var value = to_long()
    assert value and value >= Tiny.smallest and value <= Tiny.largest
    return value
}

func to_short(): Short? {
    var value = to_long()
    assert value and value >= Short.smallest and value <= Short.largest
    return value
}

func to_byte(): Byte? {
    var value = to_long()
    assert value and value >= 0 and value <= Byte.largest
    return value
}

func to_unsigned_short(): UnsignedShort? {
    var value = to_long()
    assert value and value >= 0 and value <= UnsignedShort.largest
    return value
}

func to_unsigned_integer(): UnsignedInteger? {
    var value = to_long()
    assert value and value >= 0 and value <= UnsignedInteger.largest
    return value
}

func to_unsigned_long(): UnsignedLong? {
    var text = trim()
    var size = text._length
    var index = 0
    if size > 0 and text.code_at(0) == 43 {
        index = 1
    }
    var digits_start = index
    var value: UnsignedLong = 0
    while index < size and text.code_at(index) >= 48 and text.code_at(index) <= 57 {
        var digit: UnsignedLong = text.code_at(index) - 48
        assert value <= (UnsignedLong.largest - digit) / 10
        value = value * 10 + digit
        index = index + 1
    }
    assert index > digits_start and index == size
    return value
}

func to_string(): String {
    return slice(0, _length)
}

func to_debug(): String {
    var quoted = String()
    quoted.append_code(34)
    var index = 0
    while index < _length {
        var code = code_at(index)
        if code == 34 or code == 92 {
            quoted.append_code(92)
            quoted.append_code(code)
        } else if code == 10 {
            quoted.append_code(92)
            quoted.append_code(110)
        } else {
            quoted.append_code(code)
        }
        index = index + 1
    }
    quoted.append_code(34)
    return quoted
}

func index_of(text: String): Integer? {
    var index = 0
    while index + text.length() <= _length {
        if _starts_the_text_at(index, text) {
            return index
        }
        index = index + 1
    }
    return null
}

func replace(from: String, to: String): String {
    crash not from.is_empty()
    var replaced = String()
    var index = 0
    while index < _length {
        if _starts_the_separator_at(index, from) {
            replaced = replaced.sum(to)
            index = index + from.length()
        } else {
            var code = code_at(index)
            replaced.append_code(code)
            index = index + 1
        }
    }
    return replaced
}

func lines(): List<String> {
    var pieces = split("\n")
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if piece.ends_with("\r") {
            var piece_length = piece.length()
            var kept = piece.slice(0, piece_length - 1)
            pieces[index] = kept
        }
        index = index + 1
    }
    return pieces
}

func _is_space_at(index: Integer): Boolean {
    var code = code_at(index)
    return code == 32 or code == 9 or code == 10 or code == 13
}

func trim(): String {
    var start = 0
    while start < _length and _is_space_at(start) {
        start = start + 1
    }
    var end = _length
    while end > start and _is_space_at(end - 1) {
        end = end - 1
    }
    return slice(start, end)
}

func upper_case(): String {
    return _shifted_case(97, 122, -32)
}

func lower_case(): String {
    return _shifted_case(65, 90, 32)
}

func _shifted_case(first: Integer, last: Integer, shift: Integer): String {
    var shifted = String()
    var index = 0
    while index < _length {
        var code = code_at(index)
        if code >= first and code <= last {
            code = code + shift
        }
        shifted.append_code(code)
        index = index + 1
    }
    return shifted
}

func to_bytes(): Buffer {
    var bytes = Buffer(_length)
    var index = 0
    while index < _length {
        var code = _buffer._read_byte_at(index)
        bytes.append(code)
        index = index + 1
    }
    return bytes
}
