var status = 200
var headers = Dictionary<String, String>()
var _body = Buffer(0)

func header(name: String): String? {
    var lowered = name.lower_case()
    return headers[lowered]
}

func set_header(name: String, value: String) {
    var lowered = name.lower_case()
    headers[lowered] = value
}

func read_body_as_string(): String? {
    return _body.read_as_string()
}

func read_body_as_buffer(): Buffer {
    return _body
}

func write_body_string(text: String) {
    _body = text.to_buffer()
}

func write_body_buffer(buffer: Buffer) {
    _body = buffer
}

func reason(): String {
    if status == 200 {
        return "OK"
    } else if status == 201 {
        return "Created"
    } else if status == 204 {
        return "No Content"
    } else if status == 301 {
        return "Moved Permanently"
    } else if status == 302 {
        return "Found"
    } else if status == 304 {
        return "Not Modified"
    } else if status == 400 {
        return "Bad Request"
    } else if status == 401 {
        return "Unauthorized"
    } else if status == 403 {
        return "Forbidden"
    } else if status == 404 {
        return "Not Found"
    } else if status == 405 {
        return "Method Not Allowed"
    } else if status == 409 {
        return "Conflict"
    } else if status == 413 {
        return "Content Too Large"
    } else if status == 426 {
        return "Upgrade Required"
    } else if status == 429 {
        return "Too Many Requests"
    } else if status == 500 {
        return "Internal Server Error"
    } else if status == 503 {
        return "Service Unavailable"
    } else {
        return "Status {status}"
    }
}
