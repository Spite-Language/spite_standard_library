var largest_body = 16777216
var largest_idle = 8
var _idle = List<Tcp.Connection>()
var _idle_keys = List<String>()
var _no_content_status = 204
var _not_modified_status = 304
var _first_success_status = 200
var _most_header_lines = 200
var _lowercase_f_code = 102

func send(address: IpAddress, port: Integer, request: Http.Request): Http.Response? {
    var host = address._host_text()
    var key = "{host} {port}"
    var reused = _take_idle(key)
    if reused {
        var first_line = _ask(reused, host, request)
        if first_line {
            return _finish(reused, key, request, first_line)
        }
        reused.close()
    }
    var client = Tcp.Client()
    var connected = client.connect(address, port)
    fallback connected
    var connection = client._connection
    var answer = _ask(connection, host, request)
    if not answer {
        connection.close()
    }
    fallback answer
    return _finish(connection, key, request, answer)
}

func close() {
    var index = 0
    while index < _idle.count() {
        var idle = _idle[index]
        idle.close()
        index = index + 1
    }
    _idle.clear()
    _idle_keys.clear()
}

func drop() {
    close()
}

func _take_idle(key: String): Tcp.Connection? {
    var index = 0
    while index < _idle_keys.count() {
        var held_key = _idle_keys[index]
        if held_key == key {
            var taken = _idle[index]
            _idle.remove_at(index)
            _idle_keys.remove_at(index)
            return taken
        }
        index = index + 1
    }
    return null
}

func _ask(connection: Tcp.Connection, host: String, request: Http.Request): String? {
    var body_length = request._body.count()
    var host_header = host
    var method = request.method
    var path = request.path
    var head = "{method} {path} HTTP/1.1\r\nhost: {host_header}\r\n"
    var names = request.headers.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var value = request.headers[name]
        crash value
        if name != "host" and name != "content-length" {
            head = "{head}{name}: {value}\r\n"
        }
        index = index + 1
    }
    head = "{head}content-length: {body_length}\r\n\r\n"
    var bytes = head.to_buffer()
    bytes.append_buffer(request._body, 0, body_length)
    var written = connection.write_buffer(bytes)
    fallback written
    return connection.read_line()
}

func _finish(connection: Tcp.Connection, key: String, request: Http.Request, first_line: String): Http.Response? {
    var response = _read_response(connection, request, first_line)
    if not response or connection.closed or _idle.count() >= largest_idle {
        connection.close()
    } else {
        _idle.append(connection)
        _idle_keys.append(key)
    }
    return response
}

func _read_response(connection: Tcp.Connection, request: Http.Request, first_line: String): Http.Response? {
    fallback first_line.starts_with("HTTP/1.")
    var line_length = first_line.length()
    fallback line_length >= 12
    var status_text = first_line.slice(9, 12)
    crash status_text
    var status: Integer? = status_text
    fallback status
    var response = Http.Response()
    response.status = status
    var headers_read = _read_headers(connection, response.headers)
    fallback headers_read
    var asked = ""
    var connection_header = response.header("connection")
    if connection_header {
        asked = connection_header.lower_case()
    }
    var keep = not asked.contains("close") and (first_line.starts_with("HTTP/1.1") or asked.contains("keep-alive"))
    var declared = response.header("content-length")
    var encoding = response.header("transfer-encoding")
    var bodiless = request.method == "HEAD" or status == _no_content_status or status == _not_modified_status or status < _first_success_status
    if bodiless {
        response._body = Buffer(0)
    } else if encoding {
        fallback encoding.lower_case() == "chunked"
        var chunked = _read_chunks(connection)
        fallback chunked
        response._body = chunked
    } else if declared {
        var length: Integer? = declared
        fallback length
        fallback length >= 0 and length <= largest_body
        var body = connection._read_exactly(length)
        fallback body
        response._body = body
    } else {
        var rest = _read_until_closed(connection)
        fallback rest
        response._body = rest
        keep = false
    }
    if not keep {
        connection.close()
    }
    return response
}

func _read_headers(connection: Tcp.Connection, headers: Dictionary<String, String>): Boolean {
    var count = 0
    while count < _most_header_lines {
        var line = connection.read_line()
        fallback line
        if line.is_empty() {
            return true
        }
        var colon = line.index_of(":")
        fallback colon and colon > 0
        var name = line.slice(0, colon)
        crash name
        var line_length = line.length()
        var value = line.slice(colon + 1, line_length)
        crash value
        var lowered = name.lower_case()
        var trimmed = value.trim()
        headers[lowered] = trimmed
        count = count + 1
    }
    return false
}

func _read_chunks(connection: Tcp.Connection): Buffer? {
    var body = Buffer(0)
    var finished = false
    while not finished {
        var size_line = connection.read_line()
        fallback size_line
        var size = _hex_value(size_line)
        fallback size >= 0
        fallback body.count() + size <= largest_body
        finished = size == 0
        if not finished {
            var chunk = connection._read_exactly(size)
            fallback chunk
            body.append_buffer(chunk, 0, size)
            var ending = connection.read_line()
            fallback ending
            fallback ending.is_empty()
        }
    }
    var trailers = Dictionary<String, String>()
    var trailer_read = _read_headers(connection, trailers)
    fallback trailer_read
    return body
}

func _hex_value(line: String): Integer {
    var end = line.length()
    var semicolon = line.index_of(";")
    if semicolon {
        end = semicolon
    }
    var digits = line.slice(0, end)
    crash digits
    var trimmed = digits.trim()
    var trimmed_length = trimmed.length()
    if trimmed_length == 0 or trimmed_length > 7 {
        return -1
    }
    var value = 0
    var index = 0
    while index < trimmed_length {
        var code = trimmed.byte_at(index)
        var digit = -1
        if code >= 48 and code <= 57 {
            digit = code - 48
        } else if code >= 97 and code <= _lowercase_f_code {
            digit = code - 87
        } else if code >= 65 and code <= 70 {
            digit = code - 55
        }
        if digit < 0 {
            return -1
        }
        value = value * 16 + digit
        index = index + 1
    }
    return value
}

func _read_until_closed(connection: Tcp.Connection): Buffer? {
    var body = Buffer(0)
    while not connection.closed {
        var piece = connection.read_as_buffer()
        if piece {
            var piece_count = piece.count()
            body.append_buffer(piece, 0, piece_count)
        }
        fallback body.count() <= largest_body
    }
    return body
}
