var largest_body = 1048576
var idle_limit = Duration(5, 'seconds')
var largest_waiting = 64
var _listener = Tcp.Server()
var _waiting = List<Tcp.Connection>()
var _waiting_since = List<Duration>()
var _longest_patience = Duration(1, 'seconds')
var _clock = Clock()

func listen_locally(port: Integer): Boolean {
    return _listener.listen_locally(port)
}

func listen_everywhere(port: Integer): Boolean {
    return _listener.listen_everywhere(port)
}

func next_request(): Http.Request? {
    while true {
        var client = _next_ready_connection()
        assert client
        var request = _read_request(client)
        if request {
            return request
        }
        if client.closed {
            client.close()
        } else {
            var refused = Http.Response()
            refused.status = 400
            _write_response(client, refused, true, true)
        }
    }
}

func respond(request: Http.Request, response: Http.Response) {
    var client = request._connection
    var waiting_count = _waiting.count()
    var keep = _keeps_alive(request) and waiting_count < largest_waiting and not _listener.closed
    var with_body = request.method != "HEAD" and response.status != 204 and response.status != 304
    var announce = keep and request.version == "HTTP/1.0"
    _write_response(client, response, with_body, announce or not keep)
    if keep and not client.closed {
        _waiting.append(client)
        var now = _clock.elapsed()
        _waiting_since.append(now)
    } else {
        client.close()
    }
}

func close() {
    _listener.close()
    var index = 0
    while index < _waiting.count() {
        var waiting = _waiting[index]
        crash waiting
        waiting.close()
        index = index + 1
    }
    _waiting.clear()
    _waiting_since.clear()
}

func drop() {
    close()
}

func _keeps_alive(request: Http.Request): Boolean {
    var asked = ""
    var connection_header = request.header("connection")
    if connection_header {
        asked = connection_header.lower_case()
    }
    if asked.contains("close") {
        return false
    }
    return request.version == "HTTP/1.1" or asked.contains("keep-alive")
}

func _next_ready_connection(): Tcp.Connection? {
    while true {
        _close_idle_connections()
        var pipelined = _first_pipelined()
        if pipelined >= 0 {
            return _take_waiting(pipelined)
        }
        assert not _listener.closed
        var handles = List<Long>()
        handles.append(_listener.handle)
        var index = 0
        while index < _waiting.count() {
            var waiting = _waiting[index]
            crash waiting
            handles.append(waiting.handle)
            index = index + 1
        }
        var patience = idle_limit
        if patience > _longest_patience {
            patience = _longest_patience
        }
        var ready = _listener._first_readable(handles, patience)
        assert ready != -2
        if ready == 0 {
            var client = _listener.accept()
            assert client
            return client
        }
        if ready > 0 {
            return _take_waiting(ready - 1)
        }
    }
}

func _first_pipelined(): Integer {
    var index = 0
    while index < _waiting.count() {
        var waiting = _waiting[index]
        crash waiting
        if not waiting.pending.is_empty() {
            return index
        }
        index = index + 1
    }
    return -1
}

func _take_waiting(index: Integer): Tcp.Connection {
    var taken = _waiting[index]
    crash taken
    _waiting.remove_at(index)
    _waiting_since.remove_at(index)
    return taken
}

func _close_idle_connections() {
    var now = _clock.elapsed()
    var index = 0
    while index < _waiting.count() {
        var since = _waiting_since[index]
        crash since
        var idle_for = now - since
        if idle_for > idle_limit {
            var idle = _take_waiting(index)
            idle.close()
        } else {
            index = index + 1
        }
    }
}

func _read_request(client: Tcp.Connection): Http.Request? {
    var first_line = client.read_line()
    assert first_line
    var parts = first_line.split(" ")
    assert parts.count() == 3
    var method = parts[0]
    var path = parts[1]
    var version = parts[2]
    crash method
    crash path
    crash version
    assert version == "HTTP/1.1" or version == "HTTP/1.0"
    assert not method.is_empty() and path.starts_with("/")
    var request = Http.Request()
    request._connection = client
    request.method = method
    request.path = path
    request.version = version
    var headers_read = _read_headers(client, request.headers)
    assert headers_read
    var declared = request.header("content-length")
    if declared {
        var length = declared.to_integer()
        assert length
        assert length >= 0 and length <= largest_body
        var body = client._read_exactly(length)
        assert body
        request._body = body
    } else {
        var encoding = request.header("transfer-encoding")
        assert not encoding
    }
    return request
}

func _read_headers(client: Tcp.Connection, headers: Dictionary<String, String>): Boolean {
    var count = 0
    while count < 200 {
        var line = client.read_line()
        if not line {
            return false
        }
        if line.is_empty() {
            return true
        }
        var colon = line.index_of(":")
        if not colon or colon <= 0 {
            return false
        }
        var name = line.slice(0, colon)
        crash name
        var line_length = line.length()
        var value = line.slice(colon + 1, line_length)
        crash value
        var lowered = name.lower_case()
        var trimmed = value.trim()
        headers[lowered] = trimmed
        count = count + 1
    }
    return false
}

func _write_response(client: Tcp.Connection, response: Http.Response, with_body: Boolean, closing: Boolean) {
    var reason = response.reason()
    var body_length = response._body.count()
    var status = response.status
    var head = "HTTP/1.1 {status} {reason}\r\n"
    var names = response.headers.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        crash name
        var value = response.headers[name]
        crash value
        if name != "content-length" and name != "connection" {
            head = "{head}{name}: {value}\r\n"
        }
        index = index + 1
    }
    var connection_line = "keep-alive"
    if closing {
        connection_line = "close"
    }
    head = "{head}content-length: {body_length}\r\nconnection: {connection_line}\r\n\r\n"
    var bytes = head.to_buffer()
    if with_body {
        bytes.append_buffer(response._body, 0, body_length)
    }
    client.write_buffer(bytes)
    if closing {
        client.close()
    }
}
