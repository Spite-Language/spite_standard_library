var command = ""
var arguments = List<String>()
var working_directory: Path? = null
var environment_variables = Dictionary<String, String>()
var with_errors = false
var keeps_errors_apart = false
var time_limit: Duration? = null
var _output: Buffer? = null
var _errors: Buffer? = null
var _was_stopped = false

func Process(starting_command: String, starting_arguments: List<String>) {
    command = starting_command
    arguments = starting_arguments
}

func run(): Integer? {
    _output = null
    _errors = null
    _was_stopped = false
    var command_text = _command_line()
    return _run_child(command_text)
}

func read_output_as_string(): String? {
    fallback _output
    return _output.read_as_string()
}

func read_output_as_buffer(): Buffer? {
    return _output
}

func read_errors_as_string(): String? {
    fallback _errors
    return _errors.read_as_string()
}

func read_errors_as_buffer(): Buffer? {
    return _errors
}

func get_was_stopped(): Boolean {
    return _was_stopped
}

func _command_line(): String {
    var file = File(command)
    var command_is_path = command.contains(" ") and file.exists()
    var line = command
    if command_is_path {
        line = "\"{command}\""
    }
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var quoted = _quoted_argument(argument)
        line = "{line} {quoted}"
        index = index + 1
    }
    if with_errors {
        line = "{line} 2>&1"
    }
    var prefix = _settings_prefix()
    return _shell_line("{prefix}{line}")
}

func _settings_prefix(): String {
    var prefix = ""
    if working_directory {
        var changed = _change_directory(working_directory.written)
        prefix = "{changed} && "
    }
    var names = environment_variables.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var value = environment_variables[name]
        crash value
        var assigned = _set_variable(name, value)
        prefix = "{prefix}{assigned} && "
        index = index + 1
    }
    return prefix
}
