# ../docs/memory.md#the-numbers

var _buffer = Buffer(8)

func UnsignedLong(from: String): UnsignedLong? {
    var text = from.trim()
    var size = text._length
    var index = 0
    if size > 0 and text.byte_at(0) == 43 {
        index = 1
    }
    var digits_start = index
    var value: UnsignedLong = 0
    while index < size and text.byte_at(index) >= 48 and text.byte_at(index) <= 57 {
        var digit: UnsignedLong? = text.byte_at(index) - 48
        var unsigned_long_largest = UnsignedLong.Largest()
        fallback value <= (unsigned_long_largest - digit) / 10
        value = value * 10 + digit
        index = index + 1
    }
    fallback index > digits_start and index == size
    return value
}

func Largest(): UnsignedLong {
    var every_bit: Long = -1
    return every_bit.bits_as_unsigned()
}

func Smallest(): UnsignedLong {
    return 0
}

func _value(): UnsignedLong {
    return _buffer._read_unsigned_long_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(8)
}

func absolute(): UnsignedLong {
    return _value()
}

func _bits_and(other: UnsignedLong): UnsignedLong

func _bits_or(other: UnsignedLong): UnsignedLong

func _bits_xor(other: UnsignedLong): UnsignedLong

func _bits_not(): UnsignedLong

func _shifted_left(count: Integer): UnsignedLong

func _shifted_right(count: Integer): UnsignedLong

func _wrapping_sum(other: UnsignedLong): UnsignedLong

func _wrapping_subtract(other: UnsignedLong): UnsignedLong

func _wrapping_multiply(other: UnsignedLong): UnsignedLong

func bits_and(other: UnsignedLong): UnsignedLong {
    return _bits_and(other)
}

func bits_or(other: UnsignedLong): UnsignedLong {
    return _bits_or(other)
}

func bits_exclusive_or(other: UnsignedLong): UnsignedLong {
    return _bits_xor(other)
}

func bits_inverted(): UnsignedLong {
    return _bits_not()
}

func shifted_left(count: Integer): UnsignedLong {
    crash count >= 0
    fallback count < 64
    return _shifted_left(count)
}

func shifted_right(count: Integer): UnsignedLong {
    crash count >= 0
    if count >= 64 {
        var almost = _shifted_right(63)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: UnsignedLong): UnsignedLong {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: UnsignedLong): UnsignedLong {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: UnsignedLong): UnsignedLong {
    return _wrapping_multiply(other)
}

func clamp(lowest: UnsignedLong, highest: UnsignedLong): UnsignedLong {
    var value = _value()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_signed(): Long

func bits_as_signed(): Long {
    return _bits_as_signed()
}

func bits_as_double(): Double {
    var signed = _bits_as_signed()
    return signed.bits_as_double()
}

func sum(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: UnsignedLong): UnsignedLong {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: UnsignedLong): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: UnsignedLong): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: UnsignedLong): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value: UnsignedLong = _value()
    var made = String()
    made._append_unsigned_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 64 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 63
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 64 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}

func _as_byte(): Byte {
    return _value()
}

func _as_tiny(): Tiny {
    return _value()
}

func _as_short(): Short {
    return _value()
}

func _as_unsigned_short(): UnsignedShort {
    return _value()
}

func _as_integer(): Integer {
    return _value()
}

func _as_unsigned_integer(): UnsignedInteger {
    return _value()
}

func _as_long(): Long {
    return _value()
}

func _as_unsigned_long(): UnsignedLong {
    return _value()
}

func _as_float(): Float {
    return _value()
}

func _as_double(): Double {
    return _value()
}
