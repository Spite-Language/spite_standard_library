# ../docs/memory.md#the-list

generic $element_type

var _buffer = Buffer(0)
var _length = 0
var _capacity = 0

func _item_size(): Integer

func _read_value(index: Integer): $element_type

func _write_value(index: Integer, value: $element_type)

func _forget_value(index: Integer)

func _item_held_once(index: Integer): Boolean

func _shrink_to(kept_count: Integer) {
    var index = kept_count
    while index < _length {
        _forget_value(index)
        index = index + 1
    }
    _length = kept_count
}

func count(): Integer {
    return _length
}

func is_empty(): Boolean {
    return _length == 0
}

func append(value: $element_type) {
    _make_room()
    _write_value(_length, value)
    _length = _length + 1
}

func prepend(value: $element_type) {
    insert(0, value)
}

func insert(index: Integer, value: $element_type) {
    var at = index.clamp(0, _length)
    _make_room()
    if at == _length {
        _write_value(_length, value)
        _length = _length + 1
        return
    }
    var final_item = _read_value(_length - 1)
    _write_value(_length, final_item)
    _move_values_up(at, _length - 1 - at)
    _write_value(at, value)
    _length = _length + 1
}

func get_at(index: Integer): $element_type? {
    if index >= 0 and index < _length {
        return _read_value(index)
    }
    return null
}

func set_at(index: Integer, value: $element_type) {
    crash index >= 0 and index < _length
    _write_value(index, value)
}

func remove_at(index: Integer) {
    crash index >= 0 and index < _length
    _move_values(index + 1, index, _length - index - 1)
    _shrink_to(_length - 1)
}

func remove_last(): $element_type? {
    if _length > 0 {
        var back = _read_value(_length - 1)
        _shrink_to(_length - 1)
        return back
    }
    return null
}

func remove_first(): $element_type? {
    if _length > 0 {
        var front = _read_value(0)
        remove_at(0)
        return front
    }
    return null
}

func first(): $element_type? {
    if _length > 0 {
        return _read_value(0)
    }
    return null
}

func last(): $element_type? {
    if _length > 0 {
        return _read_value(_length - 1)
    }
    return null
}

func clear() {
    _shrink_to(0)
}

func _renew_lists(wanted: Integer) {
    var index = 0
    while index < _length and index < wanted {
        if _item_held_once(index) {
            var kept = _read_value(index)
            kept.clear()
        } else {
            var fresh = $element_type()
            _write_value(index, fresh)
        }
        index = index + 1
    }
    _shrink_to(index)
    while index < wanted {
        var made = $element_type()
        append(made)
        index = index + 1
    }
}

func contains(value: $element_type): Boolean {
    var index = 0
    while index < _length {
        var held = _read_value(index)
        if held == value {
            return true
        }
        index = index + 1
    }
    return false
}

func index_of(value: $element_type): Integer? {
    var index = 0
    while index < _length {
        var held = _read_value(index)
        if held == value {
            return index
        }
        index = index + 1
    }
    return null
}

func join(separator: String): String {
    var joined = String()
    var index = 0
    while index < _length {
        if index > 0 {
            joined._append_text(separator)
        }
        var held = _read_value(index)
        if $element_type == String {
            joined._append_text(held)
        } else {
            var written = held.to_string()
            joined._append_text(written)
        }
        index = index + 1
    }
    return joined
}

func copy(): List<$element_type> {
    var copied = List<$element_type>()
    var index = 0
    while index < _length {
        var held = _read_value(index)
        copied.append(held)
        index = index + 1
    }
    return copied
}

func each(callback: Spite.Function<$element_type, Nothing>) {
    var index = 0
    while index < _length {
        var held = _read_value(index)
        callback(held)
        index = index + 1
    }
}

func deep_copy(): List<$element_type> {
    var copied = List<$element_type>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var item_copy = _deep_copied(item)
        copied.append(item_copy)
        index = index + 1
    }
    return copied
}

func _deep_copy_in(table: Spite.CopyTable): List<$element_type> {
    var copied = List<$element_type>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var item_copy = _deep_copied_in(item, table)
        copied.append(item_copy)
        index = index + 1
    }
    return copied
}

func filter(test: Spite.Function<$element_type, Boolean>): List<$element_type> {
    var filtered = List<$element_type>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if test(item) {
            filtered.append(item)
        }
        index = index + 1
    }
    return filtered
}

func remove_where(test: Spite.Function<$element_type, Boolean>) {
    var kept = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if not test(item) {
            _write_value(kept, item)
            kept = kept + 1
        }
        index = index + 1
    }
    _shrink_to(kept)
}

func count_where(test: Spite.Function<$element_type, Boolean>): Integer {
    var counted = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if test(item) {
            counted = counted + 1
        }
        index = index + 1
    }
    return counted
}

func any(test: Spite.Function<$element_type, Boolean>): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if test(item) {
            return true
        }
        index = index + 1
    }
    return false
}

func all(test: Spite.Function<$element_type, Boolean>): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        fallback test(item)
        index = index + 1
    }
    return true
}

func find(test: Spite.Function<$element_type, Boolean>): $element_type? {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if test(item) {
            return item
        }
        index = index + 1
    }
    return null
}

func sum(measure: Spite.Function<$element_type, Integer>): Integer {
    var total = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        total = total + measure(item)
        index = index + 1
    }
    return total
}

func sort_by(measure: Spite.Function<$element_type, Integer>): List<$element_type> {
    var keys = List<Integer>()
    var order = List<Integer>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var key = measure(item)
        keys.append(key)
        order.append(index)
        index = index + 1
    }
    var spare = order.copy()
    var width = 1
    while width < _length {
        var start = 0
        while start < _length {
            var middle = start + width
            var end = start + width * 2
            if middle > _length {
                middle = _length
            }
            if end > _length {
                end = _length
            }
            var left = start
            var right = middle
            var place = start
            while place < end {
                var takes_left = left < middle
                if takes_left and right < end {
                    var left_index = order[left]
                    var right_index = order[right]
                    crash left_index
                    crash right_index
                    var left_key = keys[left_index]
                    var right_key = keys[right_index]
                    crash left_key
                    crash right_key
                    takes_left = not (right_key < left_key)
                }
                if takes_left {
                    var taken_left = order[left]
                    crash taken_left
                    spare[place] = taken_left
                    left = left + 1
                } else {
                    var taken_right = order[right]
                    crash taken_right
                    spare[place] = taken_right
                    right = right + 1
                }
                place = place + 1
            }
            start = end
        }
        var swapped = order
        order = spare
        spare = swapped
        width = width * 2
    }
    var sorted = List<$element_type>()
    index = 0
    while index < _length {
        var at = order[index]
        crash at
        var item = _read_value(at)
        sorted.append(item)
        index = index + 1
    }
    return sorted
}

func _make_room() {
    _reserve(_length + 1)
}

func _reserve(wanted: Integer) {
    fallback wanted > _capacity
    var grown = _capacity * 2
    if grown < wanted {
        grown = wanted
    }
    if grown < 4 {
        grown = 4
    }
    var size = _item_size()
    _buffer._reserve(grown * size)
    _capacity = grown
}

func _move_values_up(from: Integer, wanted: Integer) {
    var index = wanted - 1
    while index >= 0 {
        var held = _read_value(from + index)
        _write_value(from + index + 1, held)
        index = index - 1
    }
}

func _move_values(from: Integer, to: Integer, wanted: Integer) {
    var index = 0
    while index < wanted {
        var held = _read_value(from + index)
        _write_value(to + index, held)
        index = index + 1
    }
}

func reverse() {
    var low = 0
    var high = _length - 1
    while low < high {
        var front = _read_value(low)
        var second = _read_value(high)
        _write_value(low, second)
        _write_value(high, front)
        low = low + 1
        high = high - 1
    }
}

func swap(first_index: Integer, second_index: Integer) {
    fallback first_index >= 0 and first_index < _length and second_index >= 0 and second_index < _length
    var front = _read_value(first_index)
    var second = _read_value(second_index)
    _write_value(first_index, second)
    _write_value(second_index, front)
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < _length {
        _shrink_to(kept_count)
    }
}

func remove_swapping(index: Integer) {
    crash index >= 0 and index < _length
    var back = _read_value(_length - 1)
    _write_value(index, back)
    _shrink_to(_length - 1)
}

func filter_member(member: Spite.AttributeDeclaration): List<$element_type> {
    var filtered = List<$element_type>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            filtered.append(item)
        }
        index = index + 1
    }
    return filtered
}

func remove_where_member(member: Spite.AttributeDeclaration) {
    var kept = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if not item[member] {
            _write_value(kept, item)
            kept = kept + 1
        }
        index = index + 1
    }
    _shrink_to(kept)
}

func count_member(member: Spite.AttributeDeclaration): Integer {
    var counted = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            counted = counted + 1
        }
        index = index + 1
    }
    return counted
}

func any_member(member: Spite.AttributeDeclaration): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            return true
        }
        index = index + 1
    }
    return false
}

func all_member(member: Spite.AttributeDeclaration): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        fallback item[member]
        index = index + 1
    }
    return true
}

func sum_member(member: Spite.AttributeDeclaration): member.class {
    var total: member.class = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        total = total + item[member]
        index = index + 1
    }
    return total
}

func each_member(member: Spite.AttributeDeclaration) {
    _each_range_member(member, 0, _length)
}

func _each_range_member(member: Spite.AttributeDeclaration, start: Integer, end: Integer) {
    var index = start
    while index < end {
        var item = _read_value(index)
        item[member]
        index = index + 1
    }
}

func map_members(member: Spite.AttributeDeclaration): List<member.class> {
    var mapped = List<member.class>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var value = item[member]
        mapped.append(value)
        index = index + 1
    }
    return mapped
}

func find_by_member(member: Spite.AttributeDeclaration, value: member.class): $element_type? {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] == value {
            return item
        }
        index = index + 1
    }
    return null
}

func find_index_by_member(member: Spite.AttributeDeclaration, value: member.class): Integer? {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] == value {
            return index
        }
        index = index + 1
    }
    return null
}

func sort_by_member(member: Spite.AttributeDeclaration): List<$element_type> {
    var keys = List<member.class>()
    var order = List<Integer>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var key = item[member]
        keys.append(key)
        order.append(index)
        index = index + 1
    }
    var spare = order.copy()
    var width = 1
    while width < _length {
        var start = 0
        while start < _length {
            var middle = start + width
            var end = start + width * 2
            if middle > _length {
                middle = _length
            }
            if end > _length {
                end = _length
            }
            var left = start
            var right = middle
            var place = start
            while place < end {
                var takes_left = left < middle
                if takes_left and right < end {
                    var left_index = order[left]
                    var right_index = order[right]
                    crash left_index
                    crash right_index
                    var left_key = keys[left_index]
                    var right_key = keys[right_index]
                    crash left_key
                    crash right_key
                    takes_left = not (right_key < left_key)
                }
                if takes_left {
                    var taken_left = order[left]
                    crash taken_left
                    spare[place] = taken_left
                    left = left + 1
                } else {
                    var taken_right = order[right]
                    crash taken_right
                    spare[place] = taken_right
                    right = right + 1
                }
                place = place + 1
            }
            start = end
        }
        var swapped = order
        order = spare
        spare = swapped
        width = width * 2
    }
    var sorted = List<$element_type>()
    index = 0
    while index < _length {
        var at = order[index]
        crash at
        var item = _read_value(at)
        sorted.append(item)
        index = index + 1
    }
    return sorted
}

func to_debug(): String {
    var shown = List<String>()
    var index = 0
    while index < _length {
        var held = _read_value(index)
        var debugged = held.to_debug()
        shown.append(debugged)
        index = index + 1
    }
    var joined = shown.join(", ")
    return "[{joined}]"
}
