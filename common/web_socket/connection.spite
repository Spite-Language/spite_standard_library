var largest_message = 16777216
var _closed = true
var _close_code: Integer? = null
var _close_reason = ""
var _last_pong: Buffer? = null
var _connection = Tcp.Connection()
var _masking = false
var _close_sent = false
var _final = false
var _opcode = 0
var _message_opcode = 0
var _parts = Buffer(0)
var _random = SecureRandom()
var _base64 = Base64()

func Connection(connection: Tcp.Connection, masking: Boolean) {
    _connection = connection
    _masking = masking
}

func get_closed(): Boolean {
    return _closed
}

func get_close_code(): Integer? {
    return _close_code
}

func get_close_reason(): String {
    return _close_reason
}

func get_last_pong(): Buffer? {
    return _last_pong
}

func send_string(text: String): Boolean {
    var bytes = text.to_buffer()
    return _send_frame(1, bytes)
}

func send_buffer(bytes: Buffer): Boolean {
    return _send_frame(2, bytes)
}

func send_ping(bytes: Buffer): Boolean {
    var counted = bytes.count()
    crash counted <= 125
    return _send_frame(9, bytes)
}

func receive(): WebSocket.Message? {
    var message: WebSocket.Message? = null
    while not message {
        assert not _closed
        var already = _parts.count()
        var frame = _read_frame(already)
        assert frame
        if _opcode >= 8 {
            _answer_control(frame)
        } else {
            message = _take_data(frame)
        }
    }
    return message
}

func close() {
    assert not _closed and not _close_sent
    _send_close(1000)
}

func drop() {
    assert not _closed
    if not _close_sent {
        _send_close(1001)
    }
    _drain()
    _connection.close()
    _closed = true
}

func _take_data(frame: Buffer): WebSocket.Message? {
    var continuing = _opcode == 0
    var started = _message_opcode != 0
    if continuing != started {
        _fail(1002)
    }
    assert not _closed
    if started {
        var added = frame.count()
        _parts.append_buffer(frame, 0, added)
    } else {
        _message_opcode = _opcode
        _parts = frame
    }
    assert _final
    var kind = _message_opcode
    var whole = _parts
    _message_opcode = 0
    _parts = Buffer(0)
    if kind == 2 {
        return WebSocket.Message(whole, false)
    }
    var text = whole.read_as_string()
    if not text {
        _fail(1007)
    }
    assert text
    return WebSocket.Message(whole, true)
}

func _begin() {
    _closed = false
}

func _refusal(request: Http.Request): Integer {
    var version = request.header("sec-websocket-version")
    var upgrade = request.header("upgrade")
    var connection = request.header("connection")
    var key = request.header("sec-websocket-key")
    if request.method != "GET" or request.version != "HTTP/1.1" or not upgrade or not connection or not key {
        return 400
    }
    var upgrade_lowered = upgrade.lower_case()
    var upgrading = _has_token(connection, "upgrade")
    if upgrade_lowered != "websocket" or not upgrading {
        return 400
    }
    if not version or version != "13" {
        return 426
    }
    var nonce = _base64.decode(key)
    if not nonce or nonce.count() != 16 {
        return 400
    }
    return 101
}

func _answer_fits(key: String, request: Http.Request): Boolean {
    var status_line = _connection.read_line()
    if not status_line or not status_line.starts_with("HTTP/1.1 101") {
        return false
    }
    var headers = Dictionary<String, String>()
    var count = 0
    var ended = false
    while not ended {
        var line = _connection.read_line()
        if not line or count >= 200 {
            return false
        }
        if line.is_empty() {
            ended = true
        } else {
            var colon = line.index_of(":")
            if not colon or colon <= 0 {
                return false
            }
            var name = line.slice(0, colon)
            crash name
            var line_length = line.length()
            var value = line.slice(colon + 1, line_length)
            crash value
            var lowered = name.lower_case()
            var trimmed = value.trim()
            headers[lowered] = trimmed
            count = count + 1
        }
    }
    var upgrade = headers["upgrade"]
    var connection = headers["connection"]
    var accepted = headers["sec-websocket-accept"]
    var extensions = headers["sec-websocket-extensions"]
    if not upgrade or not connection or not accepted {
        return false
    }
    var upgrade_lowered = upgrade.lower_case()
    var upgrading = _has_token(connection, "upgrade")
    var expected = _accept_value(key)
    if upgrade_lowered != "websocket" or not upgrading or accepted != expected or extensions {
        return false
    }
    var chosen = headers["sec-websocket-protocol"]
    if not chosen {
        return true
    }
    var offered = request.header("sec-websocket-protocol")
    if not offered {
        return false
    }
    return _has_token(offered, chosen)
}

func _has_token(list: String, token: String): Boolean {
    var pieces = list.split(",")
    var wanted = token.lower_case()
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var trimmed = piece.trim()
        var lowered = trimmed.lower_case()
        if lowered == wanted {
            return true
        }
        index = index + 1
    }
    return false
}

func _accept_value(key: String): String {
    var joined = "{key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    var bytes = joined.to_buffer()
    var digest = _sha1(bytes)
    return _base64.encode(digest)
}

func _write_string(text: String): Boolean {
    var bytes = text.to_buffer()
    return _connection.write_buffer(bytes)
}

func _byte_of(room: Buffer, at: Integer): Integer {
    var held = room[at]
    crash held
    return held.to_integer()
}

func _send_control(opcode: Integer, payload: Buffer) {
    assert _send_frame(opcode, payload)
}

func _send_frame(opcode: Integer, payload: Buffer): Boolean {
    if _closed or _close_sent {
        return false
    }
    var count = payload.count()
    var length_mark = count
    var extended = 0
    if count > 65535 {
        length_mark = 127
        extended = 8
    } else if count > 125 {
        length_mark = 126
        extended = 2
    }
    if _masking {
        length_mark = length_mark + 128
    }
    var frame = Buffer(count + 14)
    var opening = 128 + opcode
    frame.append(opening)
    frame.append(length_mark)
    if extended == 2 {
        var short_length = count.to_unsigned_short()
        frame.append_unsigned_short_big_endian(short_length)
    } else if extended == 8 {
        var long_length = count.to_long()
        frame.append_long_big_endian(long_length)
    }
    if _masking {
        var mask = _random.random_buffer(4)
        if not mask {
            return false
        }
        frame.append_buffer(mask, 0, 4)
        var index = 0
        while index < count {
            var key = _byte_of(mask, index % 4)
            var value = _byte_of(payload, index)
            var masked = value.bits_exclusive_or(key)
            frame.append(masked)
            index = index + 1
        }
    } else {
        frame.append_buffer(payload, 0, count)
    }
    var sent = _connection.write_buffer(frame)
    if not sent {
        _lost()
    }
    return sent
}

func _send_close(code: Integer) {
    var payload = Buffer(2)
    if code != 1005 {
        var high = code.shifted_right(8)
        var low = code.bits_and(255)
        payload.append(high)
        payload.append(low)
    }
    _send_control(8, payload)
    _close_sent = true
}

func _read_frame(already: Integer): Buffer? {
    var head = _read_bytes(2)
    assert head
    var first = _byte_of(head, 0)
    var second = _byte_of(head, 1)
    _final = first.bits_and(128) != 0
    _opcode = first.bits_and(15)
    var masked = second.bits_and(128) != 0
    var length: Long = second.bits_and(127)
    var reserved_bits = first.bits_and(112) != 0
    var known = _opcode <= 2 or _opcode >= 8 and _opcode <= 10
    var control = _opcode >= 8
    var control_fits = not control or _final and length <= 125
    if reserved_bits or masked == _masking or not known or not control_fits {
        _fail(1002)
    }
    assert not _closed
    if length == 126 {
        var extended = _read_bytes(2)
        assert extended
        length = _read_length(extended, 2)
        if length < 126 {
            _fail(1002)
        }
    } else if length == 127 {
        var extended = _read_bytes(8)
        assert extended
        var top = _byte_of(extended, 0)
        if top >= 128 {
            _fail(1002)
        }
        assert not _closed
        length = _read_length(extended, 8)
        if length < 65536 {
            _fail(1002)
        }
    }
    assert not _closed
    var room: Long = largest_message - already
    if not control and length > room {
        _fail(1009)
    }
    assert not _closed
    var mask: Buffer? = null
    if masked {
        mask = _read_bytes(4)
        assert mask
    }
    var count: Integer = length
    var payload = _read_bytes(count)
    assert payload
    if masked {
        crash mask
        var index = 0
        while index < count {
            var key = _byte_of(mask, index % 4)
            var value = _byte_of(payload, index)
            var unmasked = value.bits_exclusive_or(key)
            payload[index] = unmasked
            index = index + 1
        }
    }
    return payload
}

func _read_length(room: Buffer, count: Integer): Long {
    var length: Long = 0
    var index = 0
    while index < count {
        var piece: Long = _byte_of(room, index)
        length = length * 256 + piece
        index = index + 1
    }
    return length
}

func _read_bytes(count: Integer): Buffer? {
    var bytes = _connection._read_exactly(count)
    if not bytes {
        _lost()
    }
    assert bytes
    return bytes
}

func _answer_control(frame: Buffer) {
    if _opcode == 9 {
        if not _close_sent {
            _send_control(10, frame)
        }
    } else if _opcode == 10 {
        _last_pong = frame
    } else {
        _answer_close(frame)
    }
}

func _answer_close(frame: Buffer) {
    var count = frame.count()
    var code = 1005
    var reason = ""
    if count == 1 {
        _fail(1002)
    }
    assert not _closed
    if count >= 2 {
        var high = _byte_of(frame, 0)
        var low = _byte_of(frame, 1)
        code = high * 256 + low
        var allowed = code >= 1000 and code <= 1003 or code >= 1007 and code <= 1014 or code >= 3000 and code <= 4999
        if not allowed {
            _fail(1002)
        }
        assert not _closed
        var rest = frame.read_buffer_at(2, count - 2)
        crash rest
        var text = rest.read_as_string()
        if not text {
            _fail(1007)
        }
        assert text
        reason = text
    }
    if not _close_sent {
        _send_close(code)
    }
    _drain()
    _connection.close()
    _closed = true
    _close_code = code
    _close_reason = reason
}

func _fail(code: Integer) {
    assert not _closed
    if not _close_sent {
        _send_close(code)
    }
    _drain()
    _connection.close()
    _closed = true
    _close_code = code
}

func _drain() {
    var got = _connection._read_as_buffer_now()
    while got.count() > 0 {
        got = _connection._read_as_buffer_now()
    }
}

func _lost() {
    assert not _closed
    _connection.close()
    _closed = true
    _close_code = 1006
}

func _zeroed(size: Integer): Buffer {
    var room = Buffer(size)
    var filled = 0
    while filled < size {
        room.append(0)
        filled = filled + 1
    }
    return room
}

func _word_in(room: Buffer, at: Integer): UnsignedInteger {
    var held = room.read_unsigned_integer_big_endian_at(at)
    crash held
    return held
}

func _sha1(source: Buffer): Buffer {
    var length = source.count()
    var padded = (length + 8) / 64 * 64 + 64
    var block = _zeroed(padded)
    var copied = 0
    while copied < length {
        var held = _byte_of(source, copied)
        block[copied] = held
        copied = copied + 1
    }
    block[length] = 128
    var bits: Long = length
    bits = bits * 8
    block.write_long_big_endian_at(padded - 8, bits)
    var state = _zeroed(20)
    var initial_a: UnsignedInteger = 1732584193
    var initial_b: UnsignedInteger = 4023233417
    var initial_c: UnsignedInteger = 2562383102
    var initial_d: UnsignedInteger = 271733878
    var initial_e: UnsignedInteger = 3285377520
    state.write_unsigned_integer_big_endian_at(0, initial_a)
    state.write_unsigned_integer_big_endian_at(4, initial_b)
    state.write_unsigned_integer_big_endian_at(8, initial_c)
    state.write_unsigned_integer_big_endian_at(12, initial_d)
    state.write_unsigned_integer_big_endian_at(16, initial_e)
    var schedule = _zeroed(320)
    var offset = 0
    while offset < padded {
        _sha1_compress(state, block, offset, schedule)
        offset = offset + 64
    }
    return state
}

func _sha1_compress(state: Buffer, source: Buffer, source_at: Integer, schedule: Buffer) {
    var index = 0
    while index < 16 {
        var word = _word_in(source, source_at + index * 4)
        schedule.write_unsigned_integer_big_endian_at(index * 4, word)
        index = index + 1
    }
    while index < 80 {
        var three_back = _word_in(schedule, index * 4 - 12)
        var eight_back = _word_in(schedule, index * 4 - 32)
        var fourteen_back = _word_in(schedule, index * 4 - 56)
        var sixteen_back = _word_in(schedule, index * 4 - 64)
        var mixed = three_back.bits_exclusive_or(eight_back)
        mixed = mixed.bits_exclusive_or(fourteen_back)
        mixed = mixed.bits_exclusive_or(sixteen_back)
        var word = _rotated_left(mixed, 1)
        schedule.write_unsigned_integer_big_endian_at(index * 4, word)
        index = index + 1
    }
    var working_a = _word_in(state, 0)
    var working_b = _word_in(state, 4)
    var working_c = _word_in(state, 8)
    var working_d = _word_in(state, 12)
    var working_e = _word_in(state, 16)
    var round = 0
    while round < 80 {
        var mixed: UnsignedInteger = 0
        var constant: UnsignedInteger = 0
        if round < 20 {
            var chosen = working_b.bits_and(working_c)
            var inverted = working_b.bits_inverted()
            var others = inverted.bits_and(working_d)
            mixed = chosen.bits_or(others)
            constant = 1518500249
        } else if round < 40 {
            mixed = working_b.bits_exclusive_or(working_c)
            mixed = mixed.bits_exclusive_or(working_d)
            constant = 1859775393
        } else if round < 60 {
            var both_bc = working_b.bits_and(working_c)
            var both_bd = working_b.bits_and(working_d)
            var both_cd = working_c.bits_and(working_d)
            mixed = both_bc.bits_or(both_bd)
            mixed = mixed.bits_or(both_cd)
            constant = 2400959708
        } else {
            mixed = working_b.bits_exclusive_or(working_c)
            mixed = mixed.bits_exclusive_or(working_d)
            constant = 3395469782
        }
        var scheduled = _word_in(schedule, round * 4)
        var rotated_a = _rotated_left(working_a, 5)
        var sum = rotated_a.wrapping_sum(mixed)
        sum = sum.wrapping_sum(working_e)
        sum = sum.wrapping_sum(constant)
        sum = sum.wrapping_sum(scheduled)
        working_e = working_d
        working_d = working_c
        working_c = _rotated_left(working_b, 30)
        working_b = working_a
        working_a = sum
        round = round + 1
    }
    _add_to(state, 0, working_a)
    _add_to(state, 4, working_b)
    _add_to(state, 8, working_c)
    _add_to(state, 12, working_d)
    _add_to(state, 16, working_e)
}

func _add_to(state: Buffer, at: Integer, value: UnsignedInteger) {
    var held = _word_in(state, at)
    var sum = held.wrapping_sum(value)
    state.write_unsigned_integer_big_endian_at(at, sum)
}

func _rotated_left(value: UnsignedInteger, count: Integer): UnsignedInteger {
    var left = value.shifted_left(count)
    var right = value.shifted_right(32 - count)
    return left.bits_or(right)
}
