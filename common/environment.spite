singleton

var _arguments = Arguments()

func Environment() {
    _arguments = Arguments()
}

func boolean_setting(name: String, declared: Boolean): Boolean {
    var text = _setting(name)
    if not text {
        return declared
    }
    crash text == "true" or text == "false"
    return text == "true"
}

func integer_setting(name: String, declared: Integer): Integer {
    var text = _setting(name)
    if not text {
        return declared
    }
    var number = text.to_integer()
    crash number
    return number
}

func text_setting(name: String, declared: String): String {
    var text = _setting(name)
    if not text {
        return declared
    }
    return text
}

func _setting(name: String): String? {
    _refuse_snake_case(name)
    var flag = name.replace("_", "-")
    var given = _arguments.named(flag)
    if given {
        return given
    }
    var program = Program()
    var variable = name.upper_case()
    return program.environment(variable)
}

func _refuse_snake_case(name: String) {
    if name.contains("_") {
        var written = _arguments.named(name)
        if written {
            _stop_on_snake_case(name)
        }
    }
}

func _stop_on_snake_case(name: String) {
    var kebab = name.replace("_", "-")
    var console = Console()
    var first = "error: '--{name}' is written '--{kebab}'"
    var second = "a program's setting is kebab-case on the command line, like the compiler's flags"
    console.error("{first}: {second}, and it sets Environment.{name}")
    var program = Program()
    program.exit(1)
}
