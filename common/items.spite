generic $element_type

var _buffer = Buffer(0)
var _length = 0
var _capacity = 0

func _item_size(): Integer

func _read_value(index: Integer): $element_type

func _write_value(index: Integer, value: $element_type)

func _forget_value(index: Integer)

func _shrink_to(kept_count: Integer) {
    var index = kept_count
    while index < _length {
        _forget_value(index)
        index = index + 1
    }
    _length = kept_count
}

func count(): Integer {
    return _length
}

func is_empty(): Boolean {
    return _length == 0
}

func append(value: $element_type) {
    make_room()
    _write_value(_length, value)
    _length = _length + 1
}

func get_at(index: Integer): $element_type? {
    if index >= 0 and index < _length {
        return _read_value(index)
    }
    return null
}

func set_at(index: Integer, value: $element_type) {
    crash index >= 0 and index < _length
    _write_value(index, value)
}

func remove_at(index: Integer) {
    crash index >= 0 and index < _length
    _move_values(index + 1, index, _length - index - 1)
    _shrink_to(_length - 1)
}

func remove_swapping(index: Integer) {
    crash index >= 0 and index < _length
    var last = _read_value(_length - 1)
    _write_value(index, last)
    _shrink_to(_length - 1)
}

func truncate(kept_count: Integer) {
    crash kept_count >= 0
    if kept_count < _length {
        _shrink_to(kept_count)
    }
}

func swap(first_index: Integer, second_index: Integer) {
    crash first_index >= 0 and first_index < _length and second_index >= 0 and second_index < _length
    var first = _read_value(first_index)
    var second = _read_value(second_index)
    _write_value(first_index, second)
    _write_value(second_index, first)
}

func clear() {
    _shrink_to(0)
}

func copy(): Items<$element_type> {
    var copied = Items<$element_type>()
    copied.reserve(_length)
    var index = 0
    while index < _length {
        var held = _read_value(index)
        copied.append(held)
        index = index + 1
    }
    return copied
}

func deep_copy(): Items<$element_type> {
    var copied = Items<$element_type>()
    copied.reserve(_length)
    var index = 0
    while index < _length {
        var held = _read_value(index)
        if $element_type.is_fixed_size {
            copied.append(held)
        } else {
            var held_copy = held.deep_copy()
            copied.append(held_copy)
        }
        index = index + 1
    }
    return copied
}

func make_room() {
    if _length == _capacity {
        reserve(_length + 1)
    }
}

func reserve(wanted: Integer) {
    if wanted > _capacity {
        var grown = _capacity * 2
        if grown < wanted {
            grown = wanted
        }
        if grown < 4 {
            grown = 4
        }
        var size = _item_size()
        _buffer.reserve(grown * size)
        _capacity = grown
    }
}

func _move_values(from: Integer, to: Integer, wanted: Integer) {
    var index = 0
    while index < wanted {
        var held = _read_value(from + index)
        _write_value(to + index, held)
        index = index + 1
    }
}

func filter_member(member: Spite.AttributeDeclaration): Items<$element_type> {
    var filtered = Items<$element_type>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            filtered.append(item)
        }
        index = index + 1
    }
    return filtered
}

func remove_where_member(member: Spite.AttributeDeclaration) {
    var kept = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if not item[member] {
            _write_value(kept, item)
            kept = kept + 1
        }
        index = index + 1
    }
    _shrink_to(kept)
}

func count_member(member: Spite.AttributeDeclaration): Integer {
    var counted = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            counted = counted + 1
        }
        index = index + 1
    }
    return counted
}

func any_member(member: Spite.AttributeDeclaration): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] {
            return true
        }
        index = index + 1
    }
    return false
}

func all_member(member: Spite.AttributeDeclaration): Boolean {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if not item[member] {
            return false
        }
        index = index + 1
    }
    return true
}

func sum_member(member: Spite.AttributeDeclaration): member.class {
    var total: member.class = 0
    var index = 0
    while index < _length {
        var item = _read_value(index)
        total = total + item[member]
        index = index + 1
    }
    return total
}

func each_member(member: Spite.AttributeDeclaration) {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        item[member]
        index = index + 1
    }
}

func map_members(member: Spite.AttributeDeclaration): List<member.class> {
    var mapped = List<member.class>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var value = item[member]
        mapped.append(value)
        index = index + 1
    }
    return mapped
}

func find_by_member(member: Spite.AttributeDeclaration, value: member.class): $element_type? {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] == value {
            return item
        }
        index = index + 1
    }
    return null
}

func find_index_by_member(member: Spite.AttributeDeclaration, value: member.class): Integer? {
    var index = 0
    while index < _length {
        var item = _read_value(index)
        if item[member] == value {
            return index
        }
        index = index + 1
    }
    return null
}

func sort_by_member(member: Spite.AttributeDeclaration): Items<$element_type> {
    var keys = List<member.class>()
    var order = List<Integer>()
    var index = 0
    while index < _length {
        var item = _read_value(index)
        var key = item[member]
        keys.append(key)
        order.append(index)
        index = index + 1
    }
    var spare = order.copy()
    var width = 1
    while width < _length {
        var start = 0
        while start < _length {
            var middle = start + width
            var end = start + width * 2
            if middle > _length {
                middle = _length
            }
            if end > _length {
                end = _length
            }
            var left = start
            var right = middle
            var place = start
            while place < end {
                var takes_left = left < middle
                if takes_left and right < end {
                    var left_index = order[left]
                    var right_index = order[right]
                    crash left_index
                    crash right_index
                    var left_key = keys[left_index]
                    var right_key = keys[right_index]
                    crash left_key
                    crash right_key
                    takes_left = not (right_key < left_key)
                }
                if takes_left {
                    var taken_left = order[left]
                    crash taken_left
                    spare[place] = taken_left
                    left = left + 1
                } else {
                    var taken_right = order[right]
                    crash taken_right
                    spare[place] = taken_right
                    right = right + 1
                }
                place = place + 1
            }
            start = end
        }
        var swapped = order
        order = spare
        spare = swapped
        width = width * 2
    }
    var sorted = Items<$element_type>()
    index = 0
    while index < _length {
        var at = order[index]
        crash at
        var item = _read_value(at)
        sorted.append(item)
        index = index + 1
    }
    return sorted
}
