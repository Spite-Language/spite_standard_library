# ../docs/memory.md#the-numbers

var _buffer = Buffer(2)
var _smallest_half_subnormal_bits: UnsignedInteger = 864026624
var _half_exponent_rebias: Long = 112
var _float_infinity_bits: UnsignedInteger = 2139095040
var _float_not_a_number_bits: UnsignedInteger = 2143289344
var _smallest_value: Long = 0
var _largest_value: Long = 65535

func UnsignedShort(from: String): UnsignedShort? {
    var value: Long? = from
    fallback value and value >= 0 and value <= UnsignedShort.Largest()
    return value
}

func Largest(): UnsignedShort {
    return 65535
}

func Smallest(): UnsignedShort {
    return 0
}

# ../docs/memory.md#the-numbers
func set_this(value: Long) {
    crash value >= _smallest_value and value <= _largest_value
    _buffer._write_unsigned_short_at(0, value)
}

func get_this(): UnsignedShort {
    return _buffer._read_unsigned_short_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(2)
}

func half_precision_to_float(): Float {
    var bits: Long = get_this()
    var sign: Long = bits / 32768
    var exponent: Long = (bits / 1024) % 32
    var mantissa: Long = bits % 1024
    var result: Float = 0.0
    if exponent == 31 {
        result = _half_special(mantissa)
    } else if exponent == 0 {
        var scale = _smallest_half_subnormal_bits
        var mantissa_float: Float = mantissa
        result = mantissa_float * scale.bits_as_float()
    } else {
        var wide: Long = (exponent + _half_exponent_rebias) * 8388608 + mantissa * 8192
        var wide_unsigned_integer: UnsignedInteger = wide
        result = wide_unsigned_integer.bits_as_float()
    }
    if sign == 1 {
        return -result
    }
    return result
}

func _half_special(mantissa: Long): Float {
    var infinity = _float_infinity_bits
    var not_a_number = _float_not_a_number_bits
    if mantissa == 0 {
        return infinity.bits_as_float()
    }
    return not_a_number.bits_as_float()
}

func absolute(): UnsignedShort {
    return get_this()
}

func _bits_and(other: UnsignedShort): UnsignedShort

func _bits_or(other: UnsignedShort): UnsignedShort

func _bits_xor(other: UnsignedShort): UnsignedShort

func _bits_not(): UnsignedShort

func _shifted_left(count: Integer): UnsignedShort

func _shifted_right(count: Integer): UnsignedShort

func _wrapping_sum(other: UnsignedShort): UnsignedShort

func _wrapping_subtract(other: UnsignedShort): UnsignedShort

func _wrapping_multiply(other: UnsignedShort): UnsignedShort

func bits_and(other: UnsignedShort): UnsignedShort {
    return _bits_and(other)
}

func bits_or(other: UnsignedShort): UnsignedShort {
    return _bits_or(other)
}

func bits_exclusive_or(other: UnsignedShort): UnsignedShort {
    return _bits_xor(other)
}

func bits_inverted(): UnsignedShort {
    return _bits_not()
}

func shifted_left(count: Integer): UnsignedShort {
    crash count >= 0
    fallback count < 16
    return _shifted_left(count)
}

func shifted_right(count: Integer): UnsignedShort {
    crash count >= 0
    if count >= 16 {
        var almost = _shifted_right(15)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: UnsignedShort): UnsignedShort {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: UnsignedShort): UnsignedShort {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: UnsignedShort): UnsignedShort {
    return _wrapping_multiply(other)
}

func clamp(lowest: UnsignedShort, highest: UnsignedShort): UnsignedShort {
    var value = get_this()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_signed(): Short

func bits_as_signed(): Short {
    return _bits_as_signed()
}

func sum(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    return left + right
}

func subtract(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    return left - right
}

func multiply(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    return left * right
}

func divide(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    return left / right
}

func remainder(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    return left % right
}

func minimum(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    if left < right {
        return left
    }
    return right
}

func maximum(other: UnsignedShort): UnsignedShort {
    var left = get_this()
    var right = other.get_this()
    if left > right {
        return left
    }
    return right
}

func equals(other: UnsignedShort): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left == right
}

func less_than(other: UnsignedShort): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left < right
}

func greater_than(other: UnsignedShort): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left > right
}

func to_string(): String {
    var value: Long = get_this()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 16 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 15
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 16 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}

func _as_byte(): Byte {
    return get_this()
}

func _as_tiny(): Tiny {
    return get_this()
}

func _as_short(): Short {
    return get_this()
}

func _as_unsigned_short(): UnsignedShort {
    return get_this()
}

func _as_integer(): Integer {
    return get_this()
}

func _as_unsigned_integer(): UnsignedInteger {
    return get_this()
}

func _as_long(): Long {
    return get_this()
}

func _as_unsigned_long(): UnsignedLong {
    return get_this()
}

func _as_float(): Float {
    return get_this()
}

func _as_double(): Double {
    return get_this()
}
