# ../docs/memory.md#the-numbers

var _buffer = Buffer(2)

func _value(): UnsignedShort {
    return _buffer._read_unsigned_short_at(0)
}

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(2)
}

func to_boolean(): Boolean {
    return _value() != 0
}

func to_byte(): Byte {
    return _value()
}

func to_tiny(): Tiny {
    return _value()
}

func to_short(): Short {
    return _value()
}

func to_unsigned_short(): UnsignedShort {
    return _value()
}

func to_integer(): Integer {
    return _value()
}

func to_unsigned_integer(): UnsignedInteger {
    return _value()
}

func to_long(): Long {
    return _value()
}

func to_unsigned_long(): UnsignedLong {
    return _value()
}

func absolute(): UnsignedShort {
    return _value()
}

func _bits_and(other: UnsignedShort): UnsignedShort

func _bits_or(other: UnsignedShort): UnsignedShort

func _bits_xor(other: UnsignedShort): UnsignedShort

func _bits_not(): UnsignedShort

func _shifted_left(count: Integer): UnsignedShort

func _shifted_right(count: Integer): UnsignedShort

func _wrapping_sum(other: UnsignedShort): UnsignedShort

func _wrapping_subtract(other: UnsignedShort): UnsignedShort

func _wrapping_multiply(other: UnsignedShort): UnsignedShort

func bits_and(other: UnsignedShort): UnsignedShort {
    return _bits_and(other)
}

func bits_or(other: UnsignedShort): UnsignedShort {
    return _bits_or(other)
}

func bits_exclusive_or(other: UnsignedShort): UnsignedShort {
    return _bits_xor(other)
}

func bits_inverted(): UnsignedShort {
    return _bits_not()
}

func shifted_left(count: Integer): UnsignedShort {
    crash count >= 0
    if count >= 16 {
        return 0
    }
    return _shifted_left(count)
}

func shifted_right(count: Integer): UnsignedShort {
    crash count >= 0
    if count >= 16 {
        var almost = _shifted_right(15)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: UnsignedShort): UnsignedShort {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: UnsignedShort): UnsignedShort {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: UnsignedShort): UnsignedShort {
    return _wrapping_multiply(other)
}

func clamp(lowest: UnsignedShort, highest: UnsignedShort): UnsignedShort {
    crash lowest <= highest
    var value = _value()
    if value < lowest {
        return lowest
    }
    if value > highest {
        return highest
    }
    return value
}

func _bits_as_signed(): Short

func bits_as_signed(): Short {
    return _bits_as_signed()
}

func sum(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: UnsignedShort): UnsignedShort {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: UnsignedShort): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: UnsignedShort): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: UnsignedShort): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value = _value()
    if value == 0 {
        return "0"
    }
    var digits = Buffer(20)
    while value != 0 {
        var remainder = value % 10
        var code: Integer = remainder
        digits.append(code + 48)
        value = value / 10
    }
    var made = ""
    var index = digits.count() - 1
    while index >= 0 {
        var digit = digits._read_byte_at(index)
        made.append_code(digit)
        index = index - 1
    }
    return made
}

func to_debug(): String {
    return to_string()
}
