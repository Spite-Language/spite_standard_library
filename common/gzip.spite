singleton

var _second_magic_byte: Byte = 139
var _unknown_operating_system: Byte = 255
var _reserved_flags_mask = 224
var _low_short_mask: UnsignedInteger = 65535
var _crc_polynomial: UnsignedInteger = 3988292384
var _crc_all_ones: UnsignedInteger = 4294967295
var _low_byte_mask: UnsignedInteger = 255

func compress(bytes: Buffer): Buffer {
    var deflate = Deflate()
    var body = deflate.compress(bytes)
    var body_count = body.count()
    var output = Buffer(body_count + 18)
    output.append(31)
    output.append(_second_magic_byte)
    output.append(8)
    var index = 3
    while index < 9 {
        output.append(0)
        index = index + 1
    }
    output.append(_unknown_operating_system)
    output.append_buffer(body, 0, body_count)
    var total = bytes.count()
    var checksum = _crc32(bytes, 0, total)
    output.append_unsigned_integer_little_endian(checksum)
    var size: UnsignedInteger = total
    output.append_unsigned_integer_little_endian(size)
    return output
}

func decompress(bytes: Buffer): Buffer? {
    var total = bytes.count()
    fallback total >= 18
    var first = _byte_at(bytes, 0)
    var second = _byte_at(bytes, 1)
    var method = _byte_at(bytes, 2)
    var flags = _byte_at(bytes, 3)
    fallback first == 31 and second == _second_magic_byte and method == 8
    fallback flags.bits_and(_reserved_flags_mask) == 0
    var position = 10
    if flags.bits_and(4) != 0 {
        fallback position + 2 <= total
        var low = _byte_at(bytes, position)
        var high = _byte_at(bytes, position + 1)
        position = position + 2 + high * 256 + low
    }
    if flags.bits_and(8) != 0 {
        position = _skip_text(bytes, position, total)
    }
    if flags.bits_and(16) != 0 {
        position = _skip_text(bytes, position, total)
    }
    if flags.bits_and(2) != 0 {
        fallback position + 2 <= total
        var header_crc = _crc32(bytes, 0, position)
        var header_check = header_crc.bits_and(_low_short_mask)
        var stored_value = bytes.read_unsigned_short_little_endian_at(position)
        fallback stored_value
        var stored: UnsignedInteger = stored_value
        fallback header_check == stored
        position = position + 2
    }
    fallback position + 8 <= total
    var body_count = total - 8 - position
    var body = bytes.read_buffer_at(position, body_count)
    fallback body
    var deflate = Deflate()
    var output = deflate.decompress(body)
    fallback output
    var expected = bytes.read_unsigned_integer_little_endian_at(total - 8)
    fallback expected
    var output_count = output.count()
    var computed = _crc32(output, 0, output_count)
    fallback expected == computed
    var expected_size = bytes.read_unsigned_integer_little_endian_at(total - 4)
    fallback expected_size
    var size: UnsignedInteger = output_count
    fallback expected_size == size
    return output
}

func _byte_at(room: Buffer, at: Integer): Integer {
    var held = room[at]
    crash held
    return held
}

func _skip_text(bytes: Buffer, from: Integer, total: Integer): Integer {
    var position = from
    while position < total and _byte_at(bytes, position) != 0 {
        position = position + 1
    }
    return position + 1
}

func _crc32(bytes: Buffer, from: Integer, total: Integer): UnsignedInteger {
    var table = Buffer(1024)
    var polynomial = _crc_polynomial
    var entry = 0
    while entry < 256 {
        var value: UnsignedInteger = entry
        var bit = 0
        while bit < 8 {
            var odd = value.bits_and(1) != 0
            value = value.shifted_right(1)
            if odd {
                value = value.bits_exclusive_or(polynomial)
            }
            bit = bit + 1
        }
        table.append_unsigned_integer_little_endian(value)
        entry = entry + 1
    }
    var crc = _crc_all_ones
    var index = from
    while index < total {
        var byte_value: UnsignedInteger = _byte_at(bytes, index)
        var mixed = crc.bits_exclusive_or(byte_value)
        var slot_value = mixed.bits_and(_low_byte_mask)
        var slot: Integer = slot_value
        var looked = table.read_unsigned_integer_little_endian_at(slot * 4)
        crash looked
        var shifted = crc.shifted_right(8)
        crc = shifted.bits_exclusive_or(looked)
        index = index + 1
    }
    return crc.bits_exclusive_or(_crc_all_ones)
}
