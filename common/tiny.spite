# ../docs/memory.md#the-numbers

var _buffer = Buffer(1)
var _smallest_value: Long = -128
var _largest_value: Long = 127

func Tiny(from: String): Tiny? {
    var value: Long? = from
    fallback value and value >= Tiny.Smallest() and value <= Tiny.Largest()
    return value
}

func Largest(): Tiny {
    return 127
}

func Smallest(): Tiny {
    return -128
}

# ../docs/memory.md#the-numbers
func set_this(value: Long) {
    crash value >= _smallest_value and value <= _largest_value
    _buffer._write_tiny_at(0, value)
}

func get_this(): Tiny {
    return _buffer._read_tiny_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(1)
}

func absolute(): Tiny {
    var value = get_this()
    if value >= 0 {
        return value
    }
    var zero: Tiny = 0
    return zero - value
}

func _bits_and(other: Tiny): Tiny

func _bits_or(other: Tiny): Tiny

func _bits_xor(other: Tiny): Tiny

func _bits_not(): Tiny

func _shifted_left(count: Integer): Tiny

func _shifted_right(count: Integer): Tiny

func _wrapping_sum(other: Tiny): Tiny

func _wrapping_subtract(other: Tiny): Tiny

func _wrapping_multiply(other: Tiny): Tiny

func bits_and(other: Tiny): Tiny {
    return _bits_and(other)
}

func bits_or(other: Tiny): Tiny {
    return _bits_or(other)
}

func bits_exclusive_or(other: Tiny): Tiny {
    return _bits_xor(other)
}

func bits_inverted(): Tiny {
    return _bits_not()
}

func shifted_left(count: Integer): Tiny {
    crash count >= 0
    fallback count < 8
    return _shifted_left(count)
}

func shifted_right(count: Integer): Tiny {
    crash count >= 0
    if count >= 8 {
        var almost = _shifted_right(7)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: Tiny): Tiny {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: Tiny): Tiny {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: Tiny): Tiny {
    return _wrapping_multiply(other)
}

func clamp(lowest: Tiny, highest: Tiny): Tiny {
    var value = get_this()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_unsigned(): Byte

func bits_as_unsigned(): Byte {
    return _bits_as_unsigned()
}

func sum(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    return left + right
}

func subtract(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    return left - right
}

func multiply(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    return left * right
}

func divide(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    return left / right
}

func remainder(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    return left % right
}

func minimum(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Tiny): Tiny {
    var left = get_this()
    var right = other.get_this()
    if left > right {
        return left
    }
    return right
}

func equals(other: Tiny): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left == right
}

func less_than(other: Tiny): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left < right
}

func greater_than(other: Tiny): Boolean {
    var left = get_this()
    var right = other.get_this()
    return left > right
}

func to_string(): String {
    var value: Long = get_this()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 8 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 7
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 8 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}

func _as_byte(): Byte {
    return get_this()
}

func _as_tiny(): Tiny {
    return get_this()
}

func _as_short(): Short {
    return get_this()
}

func _as_unsigned_short(): UnsignedShort {
    return get_this()
}

func _as_integer(): Integer {
    return get_this()
}

func _as_unsigned_integer(): UnsignedInteger {
    return get_this()
}

func _as_long(): Long {
    return get_this()
}

func _as_unsigned_long(): UnsignedLong {
    return get_this()
}

func _as_float(): Float {
    return get_this()
}

func _as_double(): Double {
    return get_this()
}
