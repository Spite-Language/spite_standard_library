# ../docs/memory.md#the-numbers

var _buffer = Buffer(4)

func _value(): Integer {
    return _buffer._read_integer_at(0)
}

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(4)
}

func to_boolean(): Boolean {
    return _value() != 0
}

func to_byte(): Byte {
    return _value()
}

func to_tiny(): Tiny {
    return _value()
}

func to_short(): Short {
    return _value()
}

func to_unsigned_short(): UnsignedShort {
    return _value()
}

func to_integer(): Integer {
    return _value()
}

func to_unsigned_integer(): UnsignedInteger {
    return _value()
}

func to_long(): Long {
    return _value()
}

func to_unsigned_long(): UnsignedLong {
    return _value()
}

func absolute(): Integer {
    var value = _value()
    if value >= 0 {
        return value
    }
    var zero: Integer = 0
    return zero - value
}

func sum(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Integer): Integer {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: Integer): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: Integer): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: Integer): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value = _value()
    if value == 0 {
        return "0"
    }
    var negative = value < 0
    var digits = Buffer(20)
    while value != 0 {
        var remainder = value % 10
        var code: Integer = remainder
        if code < 0 {
            code = 0 - code
        }
        digits.append(code + 48)
        value = value / 10
    }
    var made = ""
    if negative {
        made.append_code(45)
    }
    var index = digits.count() - 1
    while index >= 0 {
        var digit = digits._read_byte_at(index)
        made.append_code(digit)
        index = index - 1
    }
    return made
}

func to_debug(): String {
    return to_string()
}
