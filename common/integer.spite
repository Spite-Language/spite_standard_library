func to_string(): String {
    var value: Long = get_this()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func _written_with_digits(width: Integer): String {
    var value: Long = get_this()
    var sign = ""
    if value < 0 {
        sign = "-"
        value = -value
    }
    var digits = value.to_string()
    while digits.length() < width {
        digits = "0{digits}"
    }
    return "{sign}{digits}"
}

func _written_as_fraction(): String {
    var nanoseconds = get_this()
    fallback nanoseconds != 0
    var digits = nanoseconds._written_with_digits(9)
    var length = digits.length()
    while digits.byte_at(length - 1) == 48 {
        length = length - 1
    }
    var kept = digits.slice(0, length)
    crash kept
    return ".{kept}"
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 32 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 31
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 32 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}

