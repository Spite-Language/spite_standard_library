func remainder(other: Integer): Integer {
    var left = get_this()
    var right = other.get_this()
    return left % right
}

func minimum(other: Integer): Integer {
    var left = get_this()
    var right = other.get_this()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Integer): Integer {
    var left = get_this()
    var right = other.get_this()
    if left > right {
