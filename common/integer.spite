# ../docs/memory.md#the-numbers

var _buffer = Buffer(4)
var _smallest_value: Long = -2147483648
var _largest_value: Long = 2147483647

func Integer(from: String): Integer? {
    var value: Long? = from
    fallback value and value >= Integer.Smallest() and value <= Integer.Largest()
    return value
}

func Largest(): Integer {
    return 2147483647
}

func Smallest(): Integer {
    return -2147483648
}

# ../docs/memory.md#the-numbers
func set_this(value: Long) {
    crash value >= _smallest_value and value <= _largest_value
    _buffer._write_integer_at(0, value)
}

func get_this(): Integer {
    return _buffer._read_integer_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(4)
}

func absolute(): Integer {
    var value = get_this()
    if value >= 0 {
        return value
    }
    var zero: Integer = 0
    return zero - value
}

func _bits_and(other: Integer): Integer

func _bits_or(other: Integer): Integer

func _bits_xor(other: Integer): Integer

func _bits_not(): Integer

func _shifted_left(count: Integer): Integer

func _shifted_right(count: Integer): Integer

func _wrapping_sum(other: Integer): Integer

func _wrapping_subtract(other: Integer): Integer

func _wrapping_multiply(other: Integer): Integer

func bits_and(other: Integer): Integer {
    return _bits_and(other)
}

func bits_or(other: Integer): Integer {
    return _bits_or(other)
}

func bits_exclusive_or(other: Integer): Integer {
    return _bits_xor(other)
}

func bits_inverted(): Integer {
    return _bits_not()
}

func shifted_left(count: Integer): Integer {
    crash count >= 0
    fallback count < 32
    return _shifted_left(count)
}

func shifted_right(count: Integer): Integer {
    crash count >= 0
    if count >= 32 {
        var almost = _shifted_right(31)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: Integer): Integer {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: Integer): Integer {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: Integer): Integer {
    return _wrapping_multiply(other)
}

func clamp(lowest: Integer, highest: Integer): Integer {
    var value = get_this()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_unsigned(): UnsignedInteger

func bits_as_unsigned(): UnsignedInteger {
    return _bits_as_unsigned()
}

