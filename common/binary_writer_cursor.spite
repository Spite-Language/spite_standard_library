var _bytes: Buffer? = null
var walked = 0
var found = 0

func BinaryWriterCursor(target: Buffer) {
    _bytes = target
}

func write_byte(value: Integer) {
    var low_bits = value.bits_and(255)
    var byte = low_bits.to_byte()
    var target = _target()
    target.append(byte)
}

func write_short(value: Integer) {
    var low_bits = value.bits_and(65535)
    var short = low_bits.to_unsigned_short()
    var target = _target()
    target.append_unsigned_short_little_endian(short)
}

func write_integer(value: Integer) {
    var target = _target()
    target.append_integer_little_endian(value)
}

func write_long(value: Long) {
    var target = _target()
    target.append_long_little_endian(value)
}

func write_float(value: Float) {
    var target = _target()
    target.append_float_little_endian(value)
}

func write_double(value: Double) {
    var target = _target()
    target.append_double_little_endian(value)
}

func write_count(count: Integer) {
    var rest = count
    while rest >= 128 {
        write_byte(rest % 128 + 128)
        rest = rest / 128
    }
    write_byte(rest)
}

func write_text(text: String) {
    var length = text.length()
    write_count(length)
    var target = _target()
    var used = target.count()
    target.reserve(used + length)
    var index = 0
    while index < length {
        var code = text.code_at(index)
        var byte = code.to_byte()
        target.append(byte)
        index = index + 1
    }
}

func write_index() {
    if walked <= 256 {
        write_byte(found)
    } else if walked <= 65536 {
        write_short(found)
    } else {
        write_integer(found)
    }
}

func _target(): Buffer {
    var target = _bytes
    crash target
    return target
}
