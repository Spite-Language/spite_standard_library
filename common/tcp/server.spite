var handle: Long = -1
var closed = true

func listen_locally(port: Integer): Boolean {
    var address = IpAddress()
    address._parts = [127, 0, 0, 1]
    return listen_at(address, port)
}

func listen_everywhere(port: Integer): Boolean {
    var any_ipv6 = IpAddress()
    any_ipv6._parts = [0, 0, 0, 0, 0, 0, 0, 0]
    if listen_at(any_ipv6, port) {
        return true
    }
    var any_ipv4 = IpAddress()
    return listen_at(any_ipv4, port)
}

func listen_at(address: IpAddress, port: Integer): Boolean {
    close()
    _start_sockets()
    var as_ipv6 = address.is_ipv6()
    var family = address._system_family(as_ipv6)
    var system_address = address._system_address(port, as_ipv6)
    var length = address._system_address_length(as_ipv6)
    handle = _open_handle(family, as_ipv6)
    closed = false
    var listening = handle != -1 and _bind_address(system_address, length) and _listen_for_clients()
    if not listening {
        close()
    }
    return listening
}

func accept(): Tcp.Connection? {
    fallback not closed
    _use_blocking_calls()
    var accepted = _accept_handle()
    fallback accepted != -1
    var connection = Tcp.Connection()
    connection._take_over(accepted)
    return connection
}

func close() {
    closed = true
    if handle != -1 {
        _close_handle()
        handle = -1
    }
}

func drop() {
    close()
}

func _accept_now(): Tcp.Connection? {
    fallback not closed
    var accepted = _accept_handle_now()
    fallback accepted != -1
    var connection = Tcp.Connection()
    connection._take_over(accepted)
    return connection
}
