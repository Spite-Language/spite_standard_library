var console = Console()
var program = Program()
var _namespace: Spite.Namespace? = null
var _chosen: String? = null
var _passed = 0
var _failed = 0

func Test(starting_namespace: Spite.Namespace) {
    _namespace = starting_namespace
    _chosen = program.environment("SPITE_TEST")
}

func run() {
    crash _namespace
    _run_namespace(_namespace)
    fallback not _chosen
    var total = _passed + _failed
    console.print(total, "tests,", _passed, "passed,", _failed, "failed")
    if _failed > 0 {
        program.exit(1)
    }
}

func _run_namespace(walked: Spite.Namespace) {
    var classes = walked.classes
    var index = 0
    while index < classes.count() {
        var tested = classes[index]
        _run_class(tested)
        index = index + 1
    }
    var below = walked.namespaces
    var below_index = 0
    while below_index < below.count() {
        var inner = below[below_index]
        _run_namespace(inner)
        below_index = below_index + 1
    }
}

func _run_class(tested: Spite.Class) {
    var functions = tested.functions.values()
    var index = 0
    while index < functions.count() {
        var declaration = functions[index]
        if _is_test(declaration.name) {
            _run_function(tested, declaration)
        }
        index = index + 1
    }
}

func _is_test(name: String): Boolean {
    return name == "test" or name.starts_with("test_")
}

func _run_function(tested: Spite.Class, declaration: Spite.FunctionDeclaration) {
    var named = "{tested.name_with_namespaces}.{declaration.name}"
    if not _chosen {
        _run_apart(named)
    } else if _chosen == named {
        var instance = tested()
        var call = Spite.Call(declaration, instance)
        call.call()
    }
}

func _run_apart(named: String) {
    var path = program.executable_path()
    crash path
    var no_arguments = List<String>()
    var process = Process(path, no_arguments)
    process.environment_variables["SPITE_TEST"] = named
    process.with_errors = true
    var code = process.run()
    var output = process.read_output_as_string()
    if code == 0 {
        _passed = _passed + 1
        console.print("pass", named)
    } else {
        _failed = _failed + 1
        console.print("fail", named)
    }
    if output {
        _print_indented(output)
    }
}

func _print_indented(output: String) {
    var lines = output.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.trim()
        if not trimmed.is_empty() {
            console.print("    {trimmed}")
        }
        index = index + 1
    }
}
