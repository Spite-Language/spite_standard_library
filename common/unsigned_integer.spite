# ../docs/memory.md#the-numbers

var _buffer = Buffer(4)

func _value(): UnsignedInteger {
    return _buffer._read_unsigned_integer_at(0)
}

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(4)
}

func to_boolean(): Boolean {
    return _value() != 0
}

func to_byte(): Byte {
    return _value()
}

func to_tiny(): Tiny {
    return _value()
}

func to_short(): Short {
    return _value()
}

func to_unsigned_short(): UnsignedShort {
    return _value()
}

func to_integer(): Integer {
    return _value()
}

func to_unsigned_integer(): UnsignedInteger {
    return _value()
}

func to_long(): Long {
    return _value()
}

func to_unsigned_long(): UnsignedLong {
    return _value()
}

func to_float(): Float {
    return _value()
}

func to_double(): Double {
    return _value()
}

func absolute(): UnsignedInteger {
    return _value()
}

func _bits_and(other: UnsignedInteger): UnsignedInteger

func _bits_or(other: UnsignedInteger): UnsignedInteger

func _bits_xor(other: UnsignedInteger): UnsignedInteger

func _bits_not(): UnsignedInteger

func _shifted_left(count: Integer): UnsignedInteger

func _shifted_right(count: Integer): UnsignedInteger

func _wrapping_sum(other: UnsignedInteger): UnsignedInteger

func _wrapping_subtract(other: UnsignedInteger): UnsignedInteger

func _wrapping_multiply(other: UnsignedInteger): UnsignedInteger

func bits_and(other: UnsignedInteger): UnsignedInteger {
    return _bits_and(other)
}

func bits_or(other: UnsignedInteger): UnsignedInteger {
    return _bits_or(other)
}

func bits_exclusive_or(other: UnsignedInteger): UnsignedInteger {
    return _bits_xor(other)
}

func bits_inverted(): UnsignedInteger {
    return _bits_not()
}

func shifted_left(count: Integer): UnsignedInteger {
    crash count >= 0
    if count >= 32 {
        return 0
    }
    return _shifted_left(count)
}

func shifted_right(count: Integer): UnsignedInteger {
    crash count >= 0
    if count >= 32 {
        var almost = _shifted_right(31)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: UnsignedInteger): UnsignedInteger {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: UnsignedInteger): UnsignedInteger {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: UnsignedInteger): UnsignedInteger {
    return _wrapping_multiply(other)
}

func clamp(lowest: UnsignedInteger, highest: UnsignedInteger): UnsignedInteger {
    var value = _value()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_signed(): Integer

func bits_as_signed(): Integer {
    return _bits_as_signed()
}

func get_largest(): UnsignedInteger {
    return 4294967295
}

func get_smallest(): UnsignedInteger {
    return 0
}

func _bits_as_float(): Float

func bits_as_float(): Float {
    return _bits_as_float()
}

func sum(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: UnsignedInteger): UnsignedInteger {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: UnsignedInteger): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: UnsignedInteger): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: UnsignedInteger): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value: Long = _value()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 32 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 31
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 32 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}
