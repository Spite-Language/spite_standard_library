var handle: Long = -1
var _as_ipv6 = false
var _port = 0

func open_locally(port: Integer): Boolean {
    var address = IpAddress()
    address._parts = [127, 0, 0, 1]
    return open_at(address, port)
}

func open_everywhere(port: Integer): Boolean {
    var any_ipv6 = IpAddress()
    any_ipv6._parts = [0, 0, 0, 0, 0, 0, 0, 0]
    if open_at(any_ipv6, port) {
        return true
    }
    var any_ipv4 = IpAddress()
    return open_at(any_ipv4, port)
}

func open_at(address: IpAddress, port: Integer): Boolean {
    close()
    _start_sockets()
    _as_ipv6 = address.is_ipv6()
    var family = address._system_family(_as_ipv6)
    var system_address = address._system_address(port, _as_ipv6)
    var length = address._system_address_length(_as_ipv6)
    handle = _open_handle(family, _as_ipv6)
    var bound = handle != -1 and _bind(system_address, length)
    if not bound {
        close()
        return false
    }
    var local_port = _local_port()
    if not local_port {
        close()
        return false
    }
    _port = local_port
    return true
}

func send_to(address: IpAddress, port: Integer, bytes: Buffer): Boolean {
    crash handle != -1
    if address.is_ipv6() and not _as_ipv6 {
        return false
    }
    var system_address = address._system_address(port, _as_ipv6)
    var length = address._system_address_length(_as_ipv6)
    var counted = bytes.count()
    var sent = _send(system_address, length, bytes, counted)
    return sent == counted
}

func receive(): Udp.Datagram? {
    assert handle != -1
    var room = Buffer(65536)
    var sender = Buffer(28)
    var index = 0
    while index < 28 {
        sender.append(0)
        index = index + 1
    }
    var received = _receive_from(room, 65536, sender)
    assert received >= 0
    room.take_written(received)
    var sender_address = IpAddress()
    var read = sender_address._read_system_address(sender)
    assert read
    var sender_port = sender_address._system_port(sender)
    var bytes = room.copy()
    return Udp.Datagram(bytes, sender_address, sender_port)
}

func get_port(): Integer {
    crash handle != -1
    return _port
}

func close() {
    if handle != -1 {
        _close_handle()
        handle = -1
        _port = 0
    }
}

func drop() {
    close()
}
