var handle: Long = -1
var _family = 0
var _port = 0

func open(): Boolean {
    return open_everywhere(0)
}

func open_locally(port: Integer): Boolean {
    var address = _local_address(port)
    return _bound(address)
}

func open_everywhere(port: Integer): Boolean {
    var address = _any_ipv6_address(port)
    if _bound(address) {
        return true
    }
    var fallback = _any_address(port)
    return _bound(fallback)
}

func open_at(host: String, port: Integer): Boolean {
    var addresses = _resolved_addresses(host, port, 2)
    if addresses.is_empty() {
        return false
    }
    var address = addresses[0]
    crash address
    return _bound(address)
}

func send_to(host: String, port: Integer, bytes: Buffer): Boolean {
    crash handle != -1
    var address = _destination(host, port)
    if not address {
        return false
    }
    var counted = bytes.count()
    var sent = _send(address, bytes, counted)
    return sent == counted
}

func receive(): Udp.Datagram? {
    assert handle != -1
    return _received()
}

func receive_now(): Udp.Datagram? {
    assert handle != -1
    assert _ready_now()
    return _received()
}

func get_port(): Integer {
    crash handle != -1
    return _port
}

func close() {
    if handle != -1 {
        _close_handle()
        handle = -1
        _port = 0
    }
}

func drop() {
    close()
}

func _bound(address: Buffer): Boolean {
    close()
    _start_sockets()
    _family = _read_family(address)
    handle = _open_handle(_family)
    var bound = handle != -1 and _bind(address)
    if not bound {
        close()
        return false
    }
    _port = _local_port()
    return true
}

func _destination(host: String, port: Integer): Buffer? {
    var addresses = _resolved_addresses(host, port, 2)
    var ipv4 = _ipv4_family()
    var chosen: Buffer? = null
    var index = 0
    while index < addresses.count() {
        var address = addresses[index]
        crash address
        var family = _read_family(address)
        if not chosen and (family == ipv4 or _family != ipv4) {
            chosen = address
        }
        index = index + 1
    }
    assert chosen
    var destination = _empty_address()
    if _family != ipv4 and _read_family(chosen) == ipv4 {
        _write_family(destination, _family)
        destination[18] = 255
        destination[19] = 255
        var offset = 0
        while offset < 4 {
            var code = _byte_in(chosen, 4 + offset)
            destination[20 + offset] = code
            offset = offset + 1
        }
    } else {
        var offset = 0
        while offset < 28 {
            var code = _byte_in(chosen, offset)
            destination[offset] = code
            offset = offset + 1
        }
    }
    _write_port(destination, port)
    return destination
}

func _received(): Udp.Datagram? {
    var room = Buffer(65536)
    var sender = _empty_address()
    var received = _receive_from(room, 65536, sender)
    assert received >= 0
    room.take_written(received)
    var sender_host = _address_text(sender)
    var sender_port = _read_port(sender)
    var bytes = room.copy()
    return Udp.Datagram(bytes, sender_host, sender_port)
}

func _local_address(port: Integer): Buffer {
    var address = _any_address(port)
    address[4] = 127
    address[7] = 1
    return address
}

func _any_address(port: Integer): Buffer {
    var address = _empty_address()
    var family = _ipv4_family()
    _write_family(address, family)
    _write_port(address, port)
    return address
}

func _any_ipv6_address(port: Integer): Buffer {
    var address = _empty_address()
    var family = _ipv6_family()
    _write_family(address, family)
    _write_port(address, port)
    return address
}

func _empty_address(): Buffer {
    return _zeroed(28)
}

func _address_length(address: Buffer): Integer {
    if _read_family(address) == _ipv6_family() {
        return 28
    }
    return 16
}

func _write_family(address: Buffer, family: Integer) {
    var narrow = family.to_unsigned_short()
    address.write_unsigned_short_little_endian_at(0, narrow)
}

func _read_family(address: Buffer): Integer {
    return _short_in(address, 0)
}

func _write_port(address: Buffer, port: Integer) {
    var narrow = port.to_unsigned_short()
    address.write_unsigned_short_big_endian_at(2, narrow)
}

func _read_port(address: Buffer): Integer {
    var port = address.read_unsigned_short_big_endian_at(2)
    crash port
    return port.to_integer()
}

func _resolved_addresses(host: String, port: Integer, kind: Integer): List<Buffer> {
    _start_sockets()
    var addresses = List<Buffer>()
    var hints = _zeroed(48)
    hints.write_integer_little_endian_at(8, kind)
    var found = _zeroed(8)
    var failed = _resolve_name(host, hints, found) != 0
    var first = _long_in(found, 0)
    if failed or first == 0 {
        return addresses
    }
    var ipv4_count = 0
    var entry_place = first
    while entry_place != 0 {
        var entry = _read_foreign(entry_place, 48)
        var family = _integer_in(entry, 4)
        if family == _ipv4_family() or family == _ipv6_family() {
            var resolved_length = _integer_in(entry, 16)
            if resolved_length > 28 {
                resolved_length = 28
            }
            var offset = _resolved_address_offset()
            var resolved_place = _long_in(entry, offset)
            var resolved = _read_foreign(resolved_place, resolved_length)
            var address = _empty_address()
            var index = 0
            while index < resolved_length {
                var code = _byte_in(resolved, index)
                address[index] = code
                index = index + 1
            }
            _write_port(address, port)
            if family == _ipv4_family() {
                addresses.insert(ipv4_count, address)
                ipv4_count = ipv4_count + 1
            } else {
                addresses.append(address)
            }
        }
        var next_offset = _next_entry_offset()
        entry_place = _long_in(entry, next_offset)
    }
    _free_resolved(first)
    return addresses
}

func _address_text(address: Buffer): String {
    if _read_family(address) != _ipv6_family() {
        return _dotted_text(address, 4)
    }
    var mapped = true
    var index = 8
    while index < 20 {
        var expected = 0
        if index >= 18 {
            expected = 255
        }
        var byte = _byte_in(address, index)
        mapped = mapped and byte == expected
        index = index + 1
    }
    if mapped {
        return _dotted_text(address, 20)
    }
    var groups = List<Integer>()
    index = 0
    while index < 8 {
        var high_at = 8 + index * 2
        var high = _byte_in(address, high_at)
        var low = _byte_in(address, high_at + 1)
        groups.append(high * 256 + low)
        index = index + 1
    }
    var text = _ipv6_groups_text(groups)
    var scope = _integer_in(address, 24)
    if scope != 0 {
        return "{text}%{scope}"
    }
    return text
}

func _dotted_text(address: Buffer, start: Integer): String {
    var first = _byte_in(address, start)
    var second = _byte_in(address, start + 1)
    var third = _byte_in(address, start + 2)
    var fourth = _byte_in(address, start + 3)
    return "{first}.{second}.{third}.{fourth}"
}

func _ipv6_groups_text(groups: List<Integer>): String {
    var longest_start = -1
    var longest_length = 1
    var run_start = -1
    var index = 0
    while index <= 8 {
        var zero = false
        if index < 8 {
            zero = groups[index] == 0
        }
        if zero and run_start < 0 {
            run_start = index
        }
        if not zero and run_start >= 0 {
            if index - run_start > longest_length {
                longest_start = run_start
                longest_length = index - run_start
            }
            run_start = -1
        }
        index = index + 1
    }
    var text = ""
    index = 0
    while index < 8 {
        if index == longest_start {
            text = "{text}::"
            index = index + longest_length
        } else {
            if not text.is_empty() and not text.ends_with(":") {
                text = "{text}:"
            }
            var group = groups[index]
            crash group
            var digits = _hex_text(group)
            text = "{text}{digits}"
            index = index + 1
        }
    }
    return text
}

func _hex_text(value: Integer): String {
    var digits = "0123456789abcdef"
    var text = ""
    var rest = value
    while rest > 0 or text.is_empty() {
        var digit = rest.bits_and(15)
        var character = digits.slice(digit, digit + 1)
        text = "{character}{text}"
        rest = rest.shifted_right(4)
    }
    return text
}

func _byte_in(room: Buffer, at: Integer): Integer {
    var read = room[at]
    crash read
    return read.to_integer()
}

func _short_in(room: Buffer, at: Integer): Integer {
    var read = room.read_unsigned_short_little_endian_at(at)
    crash read
    return read.to_integer()
}

func _zeroed(bytes: Integer): Buffer {
    var room = Buffer(bytes)
    var index = 0
    while index < bytes {
        room.append(0)
        index = index + 1
    }
    return room
}

func _long_in(room: Buffer, at: Integer): Long {
    var read = room.read_long_little_endian_at(at)
    crash read
    return read
}

func _integer_in(room: Buffer, at: Integer): Integer {
    var read = room.read_integer_little_endian_at(at)
    crash read
    return read
}
