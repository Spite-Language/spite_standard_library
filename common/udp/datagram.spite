var _bytes = Buffer(0)
var _sender_address = IpAddress()
var _sender_port = 0

func Datagram(bytes: Buffer, sender_address: IpAddress, sender_port: Integer) {
    _bytes = bytes
    _sender_address = sender_address
    _sender_port = sender_port
}

func read_as_string(): String? {
    return _bytes.read_as_string()
}

func read_as_buffer(): Buffer {
    return _bytes
}

func get_sender_address(): IpAddress {
    return _sender_address
}

func get_sender_port(): Integer {
    return _sender_port
}
