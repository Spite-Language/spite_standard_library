singleton

func read(text: String): Color? {
    var trimmed = text.trim()
    var cleaned = trimmed.lower_case()
    if cleaned.starts_with("#") {
        return _read_hex(cleaned)
    }
    if cleaned.starts_with("rgb") or cleaned.starts_with("hsl") {
        return _read_function(cleaned)
    }
    var named = named_hex(cleaned)
    var unnamed = named.is_empty()
    assert not unnamed
    return _read_hex(named)
}

func _read_hex(text: String): Color? {
    var text_length = text.length()
    var digits = text.slice(1, text_length)
    var count = digits.length()
    assert count == 3 or count == 4 or count == 6 or count == 8
    var valid = _all_hex(digits)
    assert valid
    if count <= 4 {
        var short_red = _hex_value(digits, 0) * 17
        var short_green = _hex_value(digits, 1) * 17
        var short_blue = _hex_value(digits, 2) * 17
        var short_alpha = 255
        if count == 4 {
            short_alpha = _hex_value(digits, 3) * 17
        }
        return _from_bytes(short_red, short_green, short_blue, short_alpha)
    }
    var long_red = _hex_pair(digits, 0)
    var long_green = _hex_pair(digits, 2)
    var long_blue = _hex_pair(digits, 4)
    var long_alpha = 255
    if count == 8 {
        long_alpha = _hex_pair(digits, 6)
    }
    return _from_bytes(long_red, long_green, long_blue, long_alpha)
}

func _hex_pair(digits: String, position: Integer): Integer {
    var high = _hex_value(digits, position)
    var low = _hex_value(digits, position + 1)
    return high * 16 + low
}

func _all_hex(digits: String): Boolean {
    var index = 0
    var valid = true
    var digit_count = digits.length()
    while valid and index < digit_count {
        var value = _hex_value(digits, index)
        valid = value >= 0
        index = index + 1
    }
    return valid
}

func _hex_value(digits: String, position: Integer): Integer {
    var code = digits.code_at(position)
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    return -1
}

func _from_bytes(red_byte: Integer, green_byte: Integer, blue_byte: Integer, alpha_byte: Integer): Color {
    var red: Float = red_byte
    var green: Float = green_byte
    var blue: Float = blue_byte
    var alpha: Float = alpha_byte
    return Color(red / 255.0, green / 255.0, blue / 255.0, alpha / 255.0)
}

func _read_function(text: String): Color? {
    var open = text.index_of("(")
    assert open
    var closed = text.ends_with(")")
    assert closed
    var function_name = text.slice(0, open)
    var is_hue = function_name == "hsl" or function_name == "hsla"
    assert is_hue or function_name == "rgb" or function_name == "rgba"
    var text_length = text.length()
    var inside = text.slice(open + 1, text_length - 1)
    var commas_removed = inside.replace(",", " ")
    var spaced = commas_removed.replace("/", " ")
    var parts = _pieces(spaced)
    var part_count = parts.count()
    assert part_count == 3 or part_count == 4
    var first = parts[0]
    var second = parts[1]
    var third = parts[2]
    crash first
    crash second
    crash third
    var alpha = 1.0
    if part_count == 4 {
        var fourth = parts[3]
        crash fourth
        var alpha_share = _fraction(fourth, 1.0)
        assert alpha_share
        var alpha_value: Float = alpha_share
        alpha = alpha_value
    }
    if is_hue {
        var hue = _number_of(first)
        var saturation = _fraction(second, 100.0)
        var lightness = _fraction(third, 100.0)
        assert hue
        assert saturation
        assert lightness
        var hue_degrees: Float = hue
        var saturation_share: Float = saturation
        var lightness_share: Float = lightness
        return _from_hue(hue_degrees, saturation_share, lightness_share, alpha)
    }
    var red = _fraction(first, 255.0)
    var green = _fraction(second, 255.0)
    var blue = _fraction(third, 255.0)
    assert red
    assert green
    assert blue
    var red_share: Float = red
    var green_share: Float = green
    var blue_share: Float = blue
    return Color(red_share, green_share, blue_share, alpha)
}

func _pieces(spaced: String): List<String> {
    var split_pieces = spaced.split(" ")
    var kept = List<String>()
    var index = 0
    while index < split_pieces.count() {
        var piece = split_pieces[index]
        var empty = piece.is_empty()
        if not empty {
            kept.append(piece)
        }
        index = index + 1
    }
    return kept
}

func _without_unit(part: String): String {
    var part_length = part.length()
    if part.ends_with("%") {
        return part.slice(0, part_length - 1)
    }
    if part.ends_with("deg") {
        return part.slice(0, part_length - 3)
    }
    return part
}

func _number_of(part: String): Float? {
    var body = _without_unit(part)
    return body.to_float()
}

func _fraction(part: String, whole: Float): Float? {
    var value = _number_of(part)
    assert value
    var share = value / whole
    if part.ends_with("%") {
        share = value / 100.0
    }
    return share.clamp(0.0, 1.0)
}

func _from_hue(hue: Float, saturation: Float, lightness: Float, alpha: Float): Color {
    var turns = hue / 360.0
    var whole_turns = turns.floor()
    var sector = (turns - whole_turns) * 6.0
    var centered = 2.0 * lightness - 1.0
    var centered_size = centered.absolute()
    var lightness_share = 1.0 - centered_size
    var chroma = lightness_share * saturation
    var half_sector = sector * 0.5
    var half_floor = half_sector.floor()
    var within_pair = (half_sector - half_floor) * 2.0
    var sector_share = within_pair - 1.0
    var sector_size = sector_share.absolute()
    var middle = chroma * (1.0 - sector_size)
    var red = 0.0
    var green = 0.0
    var blue = 0.0
    if sector < 1.0 {
        red = chroma
        green = middle
    } else if sector < 2.0 {
        red = middle
        green = chroma
    } else if sector < 3.0 {
        green = chroma
        blue = middle
    } else if sector < 4.0 {
        green = middle
        blue = chroma
    } else if sector < 5.0 {
        red = middle
        blue = chroma
    } else {
        red = chroma
        blue = middle
    }
    var lift = lightness - chroma * 0.5
    return Color(red + lift, green + lift, blue + lift, alpha)
}

