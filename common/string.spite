var _two_byte_lead_start = 192
var _three_byte_lead_start = 224
var _four_byte_lead_start = 240
var _seconds_per_day: Long = 86400
var _seconds_per_hour = 3600
var _largest_integer = 2147483647
var _lowercase_e_code = 101
var _lowercase_f_code = 102
var _lowercase_i_code = 105
var _lowercase_n_code = 110
var _lowercase_o_code = 111
var _lowercase_t_code = 116
var _lowercase_u_code = 117
var _lowercase_y_code = 121
var _lowercase_z_code = 122

func length(): Integer {
    return _length
}

func is_empty(): Boolean {
    return _length == 0
}

func byte_at(index: Integer): Integer {
    crash index >= 0 and index < _length
    return _buffer._read_byte_at(index)
}

func append_code(code: Integer) {
    _buffer.append(code)
    _length = _length + 1
}

func _append_text(other: String) {
    var count = other._length
    var wanted = _length + count
    _buffer._reserve(wanted)
    _buffer._copy_bytes(_length, other._buffer, 0, count)
    _buffer.item_count = wanted
    _length = wanted
}

func _append_bytes(source: Buffer, start: Integer, count: Integer) {
    var wanted = _length + count
    _buffer._reserve(wanted)
    _buffer._copy_bytes(_length, source, start, count)
    _buffer.item_count = wanted
    _length = wanted
}

func _make_room(added: Integer) {
    var wanted = _length + added
    _buffer._reserve(wanted)
}

func _make_room_for(added: Long) {
    var wanted: Long = _length
    wanted = wanted + added
    var room: Integer = wanted
    _buffer._reserve(room)
}

func _append_whole(value: Long) {
    var digits = 1
    var left = value / 10
    while left != 0 {
        digits = digits + 1
        left = left / 10
    }
    var start = _length
    if value < 0 {
        digits = digits + 1
    }
    var wanted = start + digits
    _buffer._reserve(wanted)
    if value < 0 {
        _buffer._write_byte_at(start, 45)
    }
    var position = wanted - 1
    left = value
    var more = true
    while more {
        var remainder: Integer = left % 10
        if remainder < 0 {
            remainder = 0 - remainder
        }
        _buffer._write_byte_at(position, remainder + 48)
        position = position - 1
        left = left / 10
        more = left != 0
    }
    _buffer.item_count = wanted
    _length = wanted
}

func _append_unsigned_whole(value: UnsignedLong) {
    var digits = 1
    var left = value / 10
    while left != 0 {
        digits = digits + 1
        left = left / 10
    }
    var wanted = _length + digits
    _buffer._reserve(wanted)
    var position = wanted - 1
    left = value
    var more = true
    while more {
        var remainder: Integer = left % 10
        _buffer._write_byte_at(position, remainder + 48)
        position = position - 1
        left = left / 10
        more = left != 0
    }
    _buffer.item_count = wanted
    _length = wanted
}

func get_at(index: Integer): String? {
    fallback index >= 0 and index < _length
    var lead = _buffer._read_byte_at(index)
    var size = _character_size(lead)
    fallback size > 0 and index + size <= _length
    var character = String()
    character._append_bytes(_buffer, index, size)
    return character
}

func _character_size(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    fallback lead >= _two_byte_lead_start
    if lead < _three_byte_lead_start {
        return 2
    }
    if lead < _four_byte_lead_start {
        return 3
    }
    return 4
}

func slice(start: Integer, end: Integer): String? {
    fallback start >= 0 and start <= end and end <= _length
    var sliced = String()
    sliced._append_bytes(_buffer, start, end - start)
    return sliced
}

func sum(other: String): String {
    var summed = String()
    var total = _length + other._length
    summed._make_room(total)
    summed._append_text(this)
    summed._append_text(other)
    return summed
}

func equals(other: String): Boolean {
    fallback _length == other._length
    return _matches_at(0, other)
}

func _matches_at(start: Integer, text: String): Boolean {
    var count = text._length
    var index = 0
    while index + 8 <= count {
        fallback _buffer._read_long_at(start + index) == text._buffer._read_long_at(index)
        index = index + 8
    }
    while index < count {
        fallback _buffer._read_byte_at(start + index) == text._buffer._read_byte_at(index)
        index = index + 1
    }
    return true
}

func _found_at(text: String, from: Integer): Integer {
    var count = text._length
    var last = _length - count
    if count == 0 {
        return from
    }
    var lead = text._buffer._read_byte_at(0)
    var index = from
    while index <= last {
        if _buffer._read_byte_at(index) == lead and _matches_at(index, text) {
            return index
        }
        index = index + 1
    }
    return -1
}

func less_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = byte_at(index)
        var theirs = other.byte_at(index)
        if mine != theirs {
            return mine < theirs
        }
        index = index + 1
    }
    return _length < other.length()
}

func greater_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = byte_at(index)
        var theirs = other.byte_at(index)
        if mine != theirs {
            return mine > theirs
        }
        index = index + 1
    }
    return _length > other.length()
}

func starts_with(text: String): Boolean {
    fallback text._length <= _length
    return _matches_at(0, text)
}

func ends_with(text: String): Boolean {
    fallback text._length <= _length
    return _matches_at(_length - text._length, text)
}

func contains(text: String): Boolean {
    fallback text._length <= _length
    return _found_at(text, 0) >= 0
}

func split(separator: String): List<String> {
    if separator.is_empty() {
        return _characters()
    }
    var pieces = List<String>()
    var start = 0
    var found = _found_at(separator, 0)
    while found >= 0 {
        var piece = slice(start, found)
        crash piece
        pieces.append(piece)
        start = found + separator._length
        found = _found_at(separator, start)
    }
    var rest = slice(start, _length)
    crash rest
    pieces.append(rest)
    return pieces
}

func _characters(): List<String> {
    var characters = List<String>()
    var index = 0
    while index < _length {
        var code = byte_at(index)
        var character = String()
        character.append_code(code)
        characters.append(character)
        index = index + 1
    }
    return characters
}


func _as_date(): Date? {
    return _date_between(0, _length)
}

func _as_time(): Time? {
    return _time_between(0, _length)
}

func _as_date_time(): DateTime? {
    return _date_time_between(0, _length)
}

func _as_instant(): Instant? {
    var offset_start = _date_end_at(0) + 1
    while offset_start < _length and not _is_offset_start_at(offset_start) {
        offset_start = offset_start + 1
    }
    var annotations_start = offset_start
    while annotations_start < _length and byte_at(annotations_start) != 91 {
        annotations_start = annotations_start + 1
    }
    fallback offset_start < annotations_start
    var local = _date_time_between(0, offset_start)
    var offset_seconds = _offset_between(offset_start, annotations_start)
    fallback local and offset_seconds
    var date = local.date
    var time = local.time
    var second_of_day: Long = time.second_of_day
    var offset: Long = offset_seconds
    var seconds = date.days_since_1970 * _seconds_per_day + second_of_day - offset
    var whole = Duration(seconds, 'seconds')
    var part = Duration(time.nanosecond, 'nanoseconds')
    var since_1970 = whole + part
    var instant = Instant(since_1970)
    var offset_is_unknown = _code_at(offset_start) == 90 or _code_at(offset_start) == _lowercase_z_code
    var position = annotations_start
    var is_first = true
    while position < _length {
        var close = _found_at("]", position)
        fallback byte_at(position) == 91 and close > position
        var name_start = position + 1
        if _code_at(name_start) == 33 {
            name_start = name_start + 1
        }
        var annotation = slice(name_start, close)
        crash annotation
        var agrees = annotation._annotation_agrees(is_first, instant, offset_seconds, offset_is_unknown)
        fallback agrees
        is_first = false
        position = close + 1
    }
    return instant
}

func _as_duration(): Duration? {
    var index = 0
    var negative = false
    if _length > 0 and _is_sign_at(0) {
        negative = byte_at(0) == 45
        index = 1
    }
    fallback _code_at(index) == 80 and _code_at(index + 1) == 84
    index = index + 2
    fallback index < _length
    var seconds: Long = 0
    var nanoseconds = 0
    var order = 0
    while index < _length {
        fallback order < 3
        var number_end = _digits_end(index)
        var digit_count = number_end - index
        fallback digit_count >= 1 and digit_count <= 15
        var number_text = slice(index, number_end)
        crash number_text
        var number: Long? = number_text
        fallback number
        var unit_at = number_end
        var fraction = 0
        var has_fraction = false
        if _code_at(unit_at) == 46 or _code_at(unit_at) == 44 {
            var fraction_end = _digits_end(unit_at + 1)
            var read_fraction = _fraction_between(unit_at, fraction_end)
            fallback read_fraction
            fraction = read_fraction
            has_fraction = true
            unit_at = fraction_end
        }
        var unit = _code_at(unit_at)
        if unit == 72 and order < 1 and not has_fraction {
            seconds = seconds + number * _seconds_per_hour
            order = 1
        } else if unit == 77 and order < 2 and not has_fraction {
            seconds = seconds + number * 60
            order = 2
        } else if unit == 83 {
            seconds = seconds + number
            nanoseconds = fraction
            order = 3
        } else {
            return null
        }
        index = unit_at + 1
    }
    var whole = Duration(seconds, 'seconds')
    var part = Duration(nanoseconds, 'nanoseconds')
    var duration = whole + part
    if negative {
        return -duration
    }
    return duration
}

func _as_period(): Period? {
    var index = 0
    var negative = false
    if _length > 0 and _is_sign_at(0) {
        negative = byte_at(0) == 45
        index = 1
    }
    fallback _code_at(index) == 80
    index = index + 1
    fallback index < _length
    var years = 0
    var months = 0
    var days: Long = 0
    var order = 0
    while index < _length {
        var component_negative = false
        if _is_sign_at(index) {
            component_negative = byte_at(index) == 45
            index = index + 1
        }
        var number_end = _digits_end(index)
        var digit_count = number_end - index
        fallback digit_count >= 1 and digit_count <= 10
        var number_text = slice(index, number_end)
        crash number_text
        var number: Long? = number_text
        fallback number and number <= _largest_integer
        var signed = number
        if component_negative {
            signed = -number
        }
        var unit = _code_at(number_end)
        if unit == 89 and order < 1 {
            years = signed
            order = 1
        } else if unit == 77 and order < 2 {
            months = signed
            order = 2
        } else if unit == 87 and order < 3 {
            days = signed * 7
            order = 3
        } else if unit == 68 and order < 4 {
            days = days + signed
            order = 4
        } else {
            return null
        }
        index = number_end + 1
    }
    fallback days <= _largest_integer and days >= -_largest_integer
    var days_count: Integer = days
    var whole_years = Period(years, 'years')
    var whole_months = Period(months, 'months')
    var whole_days = Period(days_count, 'days')
    var period = whole_years + whole_months + whole_days
    if negative {
        return -period
    }
    return period
}

func _code_at(index: Integer): Integer {
    fallback index >= 0 and index < _length
    return byte_at(index)
}

func _digits_at(start: Integer, count: Integer): Integer? {
    var value = 0
    var index = start
    while index < start + count {
        var code = _code_at(index)
        fallback code >= 48 and code <= 57
        value = value * 10 + code - 48
        index = index + 1
    }
    return value
}

func _date_end_at(start: Integer): Integer {
    var sign = _code_at(start)
    if sign == 43 or sign == 45 {
        return start + 13
    }
    return start + 10
}

func _date_between(start: Integer, end: Integer): Date? {
    var date_end = _date_end_at(start)
    fallback end == date_end
    var month_start = date_end - 5
    var sign = _code_at(start)
    var year_start = start
    if sign == 43 or sign == 45 {
        year_start = start + 1
    }
    var year = _digits_at(year_start, month_start - 1 - year_start)
    var month = _digits_at(month_start, 2)
    var day = _digits_at(month_start + 3, 2)
    fallback year and month and day
    fallback _code_at(month_start - 1) == 45 and _code_at(month_start + 2) == 45
    fallback month >= 1 and month <= 12 and day >= 1
    var signed_year = year
    if sign == 45 {
        fallback year != 0
        signed_year = -year
    }
    var first = Date(signed_year, month, 1)
    fallback day <= first.days_in_month
    return Date(signed_year, month, day)
}

func _time_between(start: Integer, end: Integer): Time? {
    var size = end - start
    fallback size == 5 or size >= 8
    var hour = _digits_at(start, 2)
    var minute = _digits_at(start + 3, 2)
    fallback hour and minute and _code_at(start + 2) == 58
    var second = 0
    var nanosecond = 0
    if size >= 8 {
        var read_second = _digits_at(start + 6, 2)
        fallback read_second and _code_at(start + 5) == 58
        second = read_second
    }
    if size > 8 {
        var fraction = _fraction_between(start + 8, end)
        fallback fraction
        nanosecond = fraction
    }
    fallback hour <= 23 and minute <= 59 and second <= 59
    return Time(hour, minute, second, nanosecond)
}

func _fraction_between(start: Integer, end: Integer): Integer? {
    var separator = _code_at(start)
    fallback separator == 46 or separator == 44
    var count = end - start - 1
    fallback count >= 1 and count <= 9
    var digits = _digits_at(start + 1, count)
    fallback digits
    var value = digits
    var index = count
    while index < 9 {
        value = value * 10
        index = index + 1
    }
    return value
}

func _date_time_between(start: Integer, end: Integer): DateTime? {
    var date_end = _date_end_at(start)
    fallback end > date_end
    var date = _date_between(start, date_end)
    var separator = _code_at(date_end)
    fallback separator == 84 or separator == _lowercase_t_code or separator == 32
    var time = _time_between(date_end + 1, end)
    fallback date and time
    return DateTime(date, time)
}

func _is_offset_start_at(index: Integer): Boolean {
    var code = _code_at(index)
    return code == 90 or code == _lowercase_z_code or code == 43 or code == 45
}

func _offset_between(start: Integer, end: Integer): Integer? {
    var sign = _code_at(start)
    if sign == 90 or sign == _lowercase_z_code {
        fallback end == start + 1
        return 0
    }
    fallback sign == 43 or sign == 45
    fallback end == start + 6 or end == start + 9
    var hours = _digits_at(start + 1, 2)
    var minutes = _digits_at(start + 4, 2)
    fallback hours and minutes and _code_at(start + 3) == 58
    var seconds = 0
    if end == start + 9 {
        var read_seconds = _digits_at(start + 7, 2)
        fallback read_seconds and _code_at(start + 6) == 58
        seconds = read_seconds
    }
    fallback hours <= 23 and minutes <= 59 and seconds <= 59
    var offset = hours * _seconds_per_hour + minutes * 60 + seconds
    if sign == 45 {
        return -offset
    }
    return offset
}

func _annotation_agrees(is_first: Boolean, instant: Instant, offset_seconds: Integer, offset_is_unknown: Boolean): Boolean {
    if contains("=") {
        return this == "u-ca=iso8601"
    }
    fallback is_first
    if _code_at(0) == 43 or _code_at(0) == 45 {
        var named_offset = _offset_between(0, _length)
        fallback named_offset
        return offset_is_unknown or named_offset == offset_seconds
    }
    var zones = TimeZones()
    var zone = zones.find(this)
    fallback zone
    if offset_is_unknown {
        return true
    }
    var zone_offset = zone.offset_at(instant)
    var zone_seconds = zone_offset.total('seconds')
    return zone_seconds == offset_seconds
}

func _is_decimal(): Boolean {
    var index = 0
    if _length > 0 and _is_sign_at(0) {
        index = 1
    }
    var whole_end = _digits_end(index)
    var digits = whole_end - index
    index = whole_end
    if index < _length and byte_at(index) == 46 {
        var fraction_end = _digits_end(index + 1)
        digits = digits + fraction_end - index - 1
        index = fraction_end
    }
    fallback digits != 0
    if index < _length and (byte_at(index) == _lowercase_e_code or byte_at(index) == 69) {
        index = index + 1
        if index < _length and _is_sign_at(index) {
            index = index + 1
        }
        var exponent_end = _digits_end(index)
        fallback exponent_end != index
        index = exponent_end
    }
    return index == _length
}

func _is_sign_at(index: Integer): Boolean {
    var code = byte_at(index)
    return code == 45 or code == 43
}

func _digits_end(start: Integer): Integer {
    var index = start
    while index < _length and byte_at(index) >= 48 and byte_at(index) <= 57 {
        index = index + 1
    }
    return index
}

func to_string(): String {
    var sliced = slice(0, _length)
    crash sliced
    return sliced
}

func to_debug(): String {
    var quoted = String()
    quoted.append_code(34)
    var index = 0
    while index < _length {
        var code = byte_at(index)
        if code == 34 or code == 92 {
            quoted.append_code(92)
            quoted.append_code(code)
        } else if code == 10 {
            quoted.append_code(92)
            quoted.append_code(_lowercase_n_code)
        } else {
            quoted.append_code(code)
        }
        index = index + 1
    }
    quoted.append_code(34)
    return quoted
}

func index_of(text: String): Integer? {
    var found = _found_at(text, 0)
    fallback found >= 0
    return found
}

func replace(from: String, to: String): String {
    crash not from.is_empty()
    var replaced = String()
    var start = 0
    var found = _found_at(from, 0)
    while found >= 0 {
        replaced._append_bytes(_buffer, start, found - start)
        replaced._append_text(to)
        start = found + from._length
        found = _found_at(from, start)
    }
    replaced._append_bytes(_buffer, start, _length - start)
    return replaced
}

func lines(): List<String> {
    var pieces = split("\n")
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if piece.ends_with("\r") {
            var piece_length = piece.length()
            var kept = piece.slice(0, piece_length - 1)
            crash kept
            pieces[index] = kept
        }
        index = index + 1
    }
    return pieces
}

func _is_space_at(index: Integer): Boolean {
    var code = byte_at(index)
    return code == 32 or code == 9 or code == 10 or code == 13
}

func trim(): String {
    var start = 0
    while start < _length and _is_space_at(start) {
        start = start + 1
    }
    var end = _length
    while end > start and _is_space_at(end - 1) {
        end = end - 1
    }
    var sliced = slice(start, end)
    crash sliced
    return sliced
}

func upper_case(): String {
    return _shifted_case(97, _lowercase_z_code, -32)
}

func lower_case(): String {
    return _shifted_case(65, 90, 32)
}

func _shifted_case(first: Integer, last: Integer, shift: Integer): String {
    var shifted = String()
    shifted._append_bytes(_buffer, 0, _length)
    var index = 0
    while index < _length {
        var code: Integer = _buffer._read_byte_at(index)
        if code >= first and code <= last {
            shifted._buffer._write_byte_at(index, code + shift)
        }
        index = index + 1
    }
    return shifted
}

func pluralize(): String {
    return _inflected(true)
}

func singularize(): String {
    return _inflected(false)
}

func _inflected(to_plural: Boolean): String {
    var own_length = length()
    var start = _last_word_start()
    var head = slice(0, start)
    crash head
    var word = slice(start, own_length)
    crash word
    var lower = word.lower_case()
    var changed = lower
    if to_plural {
        changed = _plural_word(lower)
    } else {
        changed = _singular_word(lower)
    }
    return head + _cased_like(word, changed)
}

func _last_word_start(): Integer {
    var index = length() - 1
    while index > 0 {
        var code = byte_at(index)
        if code == 95 or code == 32 {
            return index + 1
        }
        var previous = byte_at(index - 1)
        if code >= 65 and code <= 90 and previous >= 97 and previous <= _lowercase_z_code {
            return index
        }
        index = index - 1
    }
    return 0
}

func _cased_like(original: String, changed: String): String {
    var upper_form = original.upper_case()
    var lower_form = original.lower_case()
    if original.length() > 1 and original == upper_form and upper_form != lower_form {
        return changed.upper_case()
    }
    if original.is_empty() {
        return changed
    }
    var first = original.byte_at(0)
    if first >= 65 and first <= 90 {
        var first_letter = changed.slice(0, 1)
        crash first_letter
        var head = first_letter.upper_case()
        var changed_length = changed.length()
        var rest = changed.slice(1, changed_length)
        crash rest
        return head + rest
    }
    return changed
}



func _is_uncountable(word: String): Boolean {
    return uncountables.contains(word)
}

func _irregular(word: String, to_plural: Boolean): String {
    if to_plural {
        return _irregular_plural(word)
    }
    return _irregular_singular(word)
}

func _irregular_plural(word: String): String {
    var table = irregulars
    var plural = table[word]
    if plural {
        return plural
    }
    var plurals = table.values()
    if plurals.contains(word) {
        return word
    }
    return ""
}

func _irregular_singular(word: String): String {
    var table = irregulars
    if table.contains(word) {
        return word
    }
    var singulars = table.keys()
    var plurals = table.values()
    var index = 0
    while index < plurals.count() {
        if plurals[index] == word {
            var singular = singulars[index]
            crash singular
            return singular
        }
        index = index + 1
    }
    return ""
}

func _cut(word: String, count: Integer): String {
    var kept = word.length() - count
    var sliced = word.slice(0, kept)
    crash sliced
    return sliced
}

func _code_before(word: String, suffix_length: Integer): Integer {
    var position = word.length() - suffix_length - 1
    if position < 0 {
        return -1
    }
    return word.byte_at(position)
}

func _is_vowel_or_y(code: Integer): Boolean {
    return code == 97 or code == _lowercase_e_code or code == _lowercase_i_code or code == _lowercase_o_code or code == _lowercase_u_code or code == _lowercase_y_code
}

func _plural_word(word: String): String {
    if word.is_empty() or _is_uncountable(word) {
        return word
    }
    var irregular = _irregular(word, true)
    if not irregular.is_empty() {
        return irregular
    }
    var special = _plural_special(word)
    if not special.is_empty() {
        return special
    }
    if word.ends_with("quiz") {
        return "{word}zes"
    }
    var conditional = _plural_conditional(word)
    if not conditional.is_empty() {
        return conditional
    }
    return _plural_by_ending(word)
}

func _plural_special(word: String): String {
    if word == "oxen" {
        return word
    } else if word == "mice" {
        return word
    } else if word == "lice" {
        return word
    } else if word == "ox" {
        return "oxen"
    } else if word == "mouse" {
        return "mice"
    } else if word == "louse" {
        return "lice"
    } else if word == "axis" {
        return "axes"
    } else if word == "testis" {
        return "testes"
    } else {
        return ""
    }
}

func _plural_conditional(word: String): String {
    var latin = _plural_latin_index(word)
    if not latin.is_empty() {
        return latin
    }
    var consonant_y = _plural_consonant_y(word)
    if not consonant_y.is_empty() {
        return consonant_y
    }
    return _plural_fe(word)
}

func _plural_latin_index(word: String): String {
    fallback word.ends_with("ix") or word.ends_with("ex")
    var stem = _cut(word, 2)
    if stem.ends_with("matr") or stem.ends_with("vert") or stem.ends_with("ind") {
        return "{stem}ices"
    }
    return ""
}

func _plural_consonant_y(word: String): String {
    fallback word.ends_with("y")
    var before_y = _code_before(word, 1)
    if before_y >= 0 and not _is_vowel_or_y(before_y) or word.ends_with("quy") {
        return _ending(word, 1, "ies")
    }
    return ""
}

func _plural_fe(word: String): String {
    fallback word.ends_with("fe") and not word.ends_with("hive")
    var before_fe = _code_before(word, 2)
    if before_fe >= 0 and before_fe != _lowercase_f_code {
        return _ending(word, 2, "ves")
    }
    return ""
}

func _plural_by_ending(word: String): String {
    if word.ends_with("x") or word.ends_with("ch") or word.ends_with("ss") or word.ends_with("sh") {
        return "{word}es"
    }
    if word.ends_with("hive") {
        return "{word}s"
    }
    if word.ends_with("lf") or word.ends_with("rf") {
        return _ending(word, 1, "ves")
    }
    if word.ends_with("sis") {
        return _ending(word, 2, "es")
    }
    if word.ends_with("ta") or word.ends_with("ia") {
        return word
    }
    if word.ends_with("tum") or word.ends_with("ium") {
        return _ending(word, 2, "a")
    }
    if word.ends_with("buffalo") or word.ends_with("tomato") {
        return "{word}es"
    }
    if word.ends_with("bus") or word.ends_with("alias") or word.ends_with("status") {
        return "{word}es"
    }
    if word.ends_with("octopi") or word.ends_with("viri") {
        return word
    }
    if word.ends_with("octopus") or word.ends_with("virus") {
        return _ending(word, 2, "i")
    }
    if word.ends_with("s") {
        return word
    }
    return "{word}s"
}

func _singular_word(word: String): String {
    if word.is_empty() or _is_uncountable(word) {
        return word
    }
    var irregular = _irregular(word, false)
    if not irregular.is_empty() {
        return irregular
    }
    var special = _singular_special(word)
    if not special.is_empty() {
        return special
    }
    var conditional = _singular_conditional(word)
    if not conditional.is_empty() {
        return conditional
    }
    return _singular_by_ending(word)
}

func _singular_special(word: String): String {
    if word == "oxen" {
        return "ox"
    } else if word == "axis" {
        return "axis"
    } else if word == "axes" {
        return "axis"
    } else if word == "mice" {
        return "mouse"
    } else if word == "lice" {
        return "louse"
    } else {
        return ""
    }
}

func _singular_conditional(word: String): String {
    var consonant_ies = _singular_consonant_ies(word)
    if not consonant_ies.is_empty() {
        return consonant_ies
    }
    var fe = _singular_ves(word)
    if not fe.is_empty() {
        return fe
    }
    return _singular_sis(word)
}

func _singular_consonant_ies(word: String): String {
    fallback word.ends_with("ies") and not word.ends_with("movies") and not word.ends_with("series")
    var before_ies = _code_before(word, 3)
    if before_ies >= 0 and not _is_vowel_or_y(before_ies) or word.ends_with("quies") {
        return _ending(word, 3, "y")
    }
    return ""
}

func _singular_ves(word: String): String {
    fallback word.ends_with("ves") and not word.ends_with("lves") and not word.ends_with("rves") and not word.ends_with("tives") and not word.ends_with("hives")
    var before_ves = _code_before(word, 3)
    if before_ves >= 0 and before_ves != _lowercase_f_code {
        return _ending(word, 3, "fe")
    }
    return ""
}

func _singular_sis(word: String): String {
    fallback (word.ends_with("sis") or word.ends_with("ses")) and not word.ends_with("databases")
    var stem = _cut(word, 3)
    if stem.ends_with("analy") or stem.ends_with("ba") or stem.ends_with("diagno") or stem.ends_with("parenthe") or stem.ends_with("progno") or stem.ends_with("synop") or stem.ends_with("the") {
        return "{stem}sis"
    }
    return ""
}

func _singular_by_ending(word: String): String {
    if word.ends_with("databases") {
        return _cut(word, 1)
    }
    if word.ends_with("quizzes") {
        return _cut(word, 3)
    }
    if word.ends_with("matrices") {
        return _ending(word, 4, "ix")
    }
    if word.ends_with("vertices") or word.ends_with("indices") {
        return _ending(word, 4, "ex")
    }
    if word.ends_with("aliases") or word.ends_with("statuses") {
        return _cut(word, 2)
    }
    if word.ends_with("alias") or word.ends_with("status") or word.ends_with("octopus") or word.ends_with("virus") {
        return word
    }
    if word.ends_with("octopi") or word.ends_with("viri") {
        return _ending(word, 1, "us")
    }
    if word.ends_with("crisis") or word.ends_with("testis") or word.ends_with("crises") or word.ends_with("testes") {
        return _ending(word, 2, "is")
    }
    if word.ends_with("shoes") {
        return _cut(word, 1)
    }
    if word.ends_with("oes") or word.ends_with("buses") {
        return _cut(word, 2)
    }
    if word.ends_with("bus") {
        return word
    }
    if word.ends_with("xes") or word.ends_with("ches") or word.ends_with("sses") or word.ends_with("shes") {
        return _cut(word, 2)
    }
    if word.ends_with("movies") {
        return _cut(word, 1)
    }
    if word.ends_with("series") {
        return word
    }
    if word.ends_with("lves") or word.ends_with("rves") {
        return _ending(word, 3, "f")
    }
    if word.ends_with("tives") or word.ends_with("hives") {
        return _cut(word, 1)
    }
    if word.ends_with("ta") or word.ends_with("ia") {
        return _ending(word, 1, "um")
    }
    if word.ends_with("news") or word.ends_with("ss") {
        return word
    }
    if word.ends_with("s") {
        return _cut(word, 1)
    }
    return word
}

func _ending(word: String, count: Integer, ending: String): String {
    var kept = _cut(word, count)
    return "{kept}{ending}"
}

func to_buffer(): Buffer {
    var bytes = Buffer(_length)
    bytes.append_buffer(_buffer, 0, _length)
    return bytes
}
