# ../docs/memory.md#the-string

var _buffer = Buffer(16)
var _length = 0

func length(): Integer {
    return _length
}

func is_empty(): Boolean {
    return _length == 0
}

func code_at(index: Integer): Integer {
    return _buffer._read_byte_at(index)
}

func append_code(code: Integer) {
    _buffer.append(code)
    _length = _length + 1
}

func _is_held_once(): Boolean

func _ready_to_grow(): String {
    if _is_held_once() {
        return this
    }
    var grown = String()
    var room = _length * 2
    grown._buffer.reserve(room)
    grown._append_text(this)
    return grown
}

func _append_text(other: String) {
    var count = other.length()
    var index = 0
    while index < count {
        var code = other.code_at(index)
        append_code(code)
        index = index + 1
    }
}

func character_at(index: Integer): String {
    var character = String()
    if index < 0 or index >= _length {
        return character
    }
    var code = code_at(index)
    character.append_code(code)
    return character
}

func slice(start: Integer, end: Integer): String {
    var first = _clamped(start)
    var last = _clamped(end)
    if last <= first {
        return String()
    }
    var sliced = String()
    var index = first
    while index < last {
        var code = code_at(index)
        sliced.append_code(code)
        index = index + 1
    }
    return sliced
}

func _clamped(position: Integer): Integer {
    if position < 0 {
        return 0
    }
    if _length < position {
        return _length
    }
    return position
}

func sum(other: String): String {
    var summed = String()
    var index = 0
    while index < _length {
        var code = code_at(index)
        summed.append_code(code)
        index = index + 1
    }
    var other_index = 0
    while other_index < other.length() {
        var code = other.code_at(other_index)
        summed.append_code(code)
        other_index = other_index + 1
    }
    return summed
}

func equals(other: String): Boolean {
    if _length != other.length() {
        return false
    }
    var index = 0
    while index < _length {
        if code_at(index) != other.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func less_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = code_at(index)
        var theirs = other.code_at(index)
        if mine != theirs {
            return mine < theirs
        }
        index = index + 1
    }
    return _length < other.length()
}

func greater_than(other: String): Boolean {
    var index = 0
    while index < _length and index < other.length() {
        var mine = code_at(index)
        var theirs = other.code_at(index)
        if mine != theirs {
            return mine > theirs
        }
        index = index + 1
    }
    return _length > other.length()
}

func starts_with(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var index = 0
    while index < text.length() {
        if code_at(index) != text.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func ends_with(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var index = text.length()
    while index > 0 {
        var text_length = text.length()
        var mine = code_at(_length - text_length + index - 1)
        var theirs = text.code_at(index - 1)
        if mine != theirs {
            return false
        }
        index = index - 1
    }
    return true
}

func contains(text: String): Boolean {
    if text.length() > _length {
        return false
    }
    var start = 0
    while start + text.length() <= _length {
        if _starts_the_text_at(start, text) {
            return true
        }
        start = start + 1
    }
    return false
}

func _starts_the_text_at(start: Integer, text: String): Boolean {
    var index = 0
    while index < text.length() {
        if code_at(start + index) != text.code_at(index) {
            return false
        }
        index = index + 1
    }
    return true
}

func split(separator: String): List<String> {
    if separator.is_empty() {
        return _characters()
    }
    var pieces = List<String>()
    var piece = String()
    var index = 0
    while index < _length {
        if _starts_the_separator_at(index, separator) {
            pieces.append(piece)
            piece = String()
            index = index + separator.length()
        } else {
            var code = code_at(index)
            piece.append_code(code)
            index = index + 1
        }
    }
    pieces.append(piece)
    return pieces
}

func _characters(): List<String> {
    var characters = List<String>()
    var index = 0
    while index < _length {
        var code = code_at(index)
        var character = String()
        character.append_code(code)
        characters.append(character)
        index = index + 1
    }
    return characters
}

func _starts_the_separator_at(index: Integer, separator: String): Boolean {
    if index + separator.length() > _length {
        return false
    }
    return _starts_the_text_at(index, separator)
}

func to_long(): Long? {
    var text = trim()
    var size = text._length
    var index = 0
    var negative = false
    if size > 0 and (text.code_at(0) == 45 or text.code_at(0) == 43) {
        negative = text.code_at(0) == 45
        index = 1
    }
    var digits_start = index
    var value: Long = 0
    while index < size and text.code_at(index) >= 48 and text.code_at(index) <= 57 {
        var digit: Long = text.code_at(index) - 48
        assert value >= (Long.smallest + digit) / 10
        value = value * 10 - digit
        index = index + 1
    }
    assert index > digits_start and index == size
    if negative {
        return value
    }
    assert value != Long.smallest
    return 0 - value
}

func to_double(): Double? {
    var text = trim()
    var valid = text._is_decimal()
    assert valid
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    var end: Long = 0
    return library.strtod_as_double(text, end)
}

func to_float(): Float? {
    var text = trim()
    var valid = text._is_decimal()
    assert valid
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    var end: Long = 0
    return library.strtof_as_float(text, end)
}

func _is_decimal(): Boolean {
    var index = 0
    if _length > 0 and _is_sign_at(0) {
        index = 1
    }
    var whole_end = _digits_end(index)
    var digits = whole_end - index
    index = whole_end
    if index < _length and code_at(index) == 46 {
        var fraction_end = _digits_end(index + 1)
        digits = digits + fraction_end - index - 1
        index = fraction_end
    }
    if digits == 0 {
        return false
    }
    if index < _length and (code_at(index) == 101 or code_at(index) == 69) {
        index = index + 1
        if index < _length and _is_sign_at(index) {
            index = index + 1
        }
        var exponent_end = _digits_end(index)
        if exponent_end == index {
            return false
        }
        index = exponent_end
    }
    return index == _length
}

func _is_sign_at(index: Integer): Boolean {
    var code = code_at(index)
    return code == 45 or code == 43
}

func _digits_end(start: Integer): Integer {
    var index = start
    while index < _length and code_at(index) >= 48 and code_at(index) <= 57 {
        index = index + 1
    }
    return index
}

func to_integer(): Integer? {
    var value = to_long()
    assert value and value >= Integer.smallest and value <= Integer.largest
    return value
}

func to_tiny(): Tiny? {
    var value = to_long()
    assert value and value >= Tiny.smallest and value <= Tiny.largest
    return value
}

func to_short(): Short? {
    var value = to_long()
    assert value and value >= Short.smallest and value <= Short.largest
    return value
}

func to_byte(): Byte? {
    var value = to_long()
    assert value and value >= 0 and value <= Byte.largest
    return value
}

func to_unsigned_short(): UnsignedShort? {
    var value = to_long()
    assert value and value >= 0 and value <= UnsignedShort.largest
    return value
}

func to_unsigned_integer(): UnsignedInteger? {
    var value = to_long()
    assert value and value >= 0 and value <= UnsignedInteger.largest
    return value
}

func to_unsigned_long(): UnsignedLong? {
    var text = trim()
    var size = text._length
    var index = 0
    if size > 0 and text.code_at(0) == 43 {
        index = 1
    }
    var digits_start = index
    var value: UnsignedLong = 0
    while index < size and text.code_at(index) >= 48 and text.code_at(index) <= 57 {
        var digit: UnsignedLong = text.code_at(index) - 48
        assert value <= (UnsignedLong.largest - digit) / 10
        value = value * 10 + digit
        index = index + 1
    }
    assert index > digits_start and index == size
    return value
}

func to_string(): String {
    return slice(0, _length)
}

func to_debug(): String {
    var quoted = String()
    quoted.append_code(34)
    var index = 0
    while index < _length {
        var code = code_at(index)
        if code == 34 or code == 92 {
            quoted.append_code(92)
            quoted.append_code(code)
        } else if code == 10 {
            quoted.append_code(92)
            quoted.append_code(110)
        } else {
            quoted.append_code(code)
        }
        index = index + 1
    }
    quoted.append_code(34)
    return quoted
}

func index_of(text: String): Integer? {
    var index = 0
    while index + text.length() <= _length {
        if _starts_the_text_at(index, text) {
            return index
        }
        index = index + 1
    }
    return null
}

func replace(from: String, to: String): String {
    crash not from.is_empty()
    var replaced = String()
    var index = 0
    while index < _length {
        if _starts_the_separator_at(index, from) {
            replaced = replaced.sum(to)
            index = index + from.length()
        } else {
            var code = code_at(index)
            replaced.append_code(code)
            index = index + 1
        }
    }
    return replaced
}

func lines(): List<String> {
    var pieces = split("\n")
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if piece.ends_with("\r") {
            var piece_length = piece.length()
            var kept = piece.slice(0, piece_length - 1)
            pieces[index] = kept
        }
        index = index + 1
    }
    return pieces
}

func _is_space_at(index: Integer): Boolean {
    var code = code_at(index)
    return code == 32 or code == 9 or code == 10 or code == 13
}

func trim(): String {
    var start = 0
    while start < _length and _is_space_at(start) {
        start = start + 1
    }
    var end = _length
    while end > start and _is_space_at(end - 1) {
        end = end - 1
    }
    return slice(start, end)
}

func upper_case(): String {
    return _shifted_case(97, 122, -32)
}

func lower_case(): String {
    return _shifted_case(65, 90, 32)
}

func _shifted_case(first: Integer, last: Integer, shift: Integer): String {
    var shifted = String()
    var index = 0
    while index < _length {
        var code = code_at(index)
        if code >= first and code <= last {
            code = code + shift
        }
        shifted.append_code(code)
        index = index + 1
    }
    return shifted
}

func pluralize(): String {
    return _inflected(true)
}

func singularize(): String {
    return _inflected(false)
}

func _inflected(to_plural: Boolean): String {
    var own_length = length()
    var start = _last_word_start()
    var head = slice(0, start)
    var word = slice(start, own_length)
    var lower = word.lower_case()
    var changed = _singular_word(lower)
    if to_plural {
        changed = _plural_word(lower)
    }
    return head + _cased_like(word, changed)
}

func _last_word_start(): Integer {
    var index = length() - 1
    while index > 0 {
        var code = code_at(index)
        if code == 95 or code == 32 {
            return index + 1
        }
        var previous = code_at(index - 1)
        if code >= 65 and code <= 90 and previous >= 97 and previous <= 122 {
            return index
        }
        index = index - 1
    }
    return 0
}

func _cased_like(original: String, changed: String): String {
    var upper_form = original.upper_case()
    var lower_form = original.lower_case()
    if original.length() > 1 and original == upper_form and upper_form != lower_form {
        return changed.upper_case()
    }
    var first = original.code_at(0)
    if first >= 65 and first <= 90 {
        var head = changed.slice(0, 1).upper_case()
        var changed_length = changed.length()
        return head + changed.slice(1, changed_length)
    }
    return changed
}

func _is_uncountable(word: String): Boolean {
    var inflection = Inflection()
    return inflection.is_uncountable(word)
}

func _irregular(word: String, to_plural: Boolean): String {
    var inflection = Inflection()
    var found = inflection.singular_of(word)
    if to_plural {
        found = inflection.plural_of(word)
    }
    if found {
        return found
    }
    return ""
}

func _cut(word: String, count: Integer): String {
    var kept = word.length() - count
    return word.slice(0, kept)
}

func _code_before(word: String, suffix_length: Integer): Integer {
    var position = word.length() - suffix_length - 1
    if position < 0 {
        return -1
    }
    return word.code_at(position)
}

func _is_vowel_or_y(code: Integer): Boolean {
    return code == 97 or code == 101 or code == 105 or code == 111 or code == 117 or code == 121
}

func _plural_word(word: String): String {
    if word.is_empty() or _is_uncountable(word) {
        return word
    }
    var irregular = _irregular(word, true)
    if not irregular.is_empty() {
        return irregular
    }
    var special = _plural_special(word)
    if not special.is_empty() {
        return special
    }
    if word.ends_with("quiz") {
        return "{word}zes"
    }
    var conditional = _plural_conditional(word)
    if not conditional.is_empty() {
        return conditional
    }
    return _plural_by_ending(word)
}

func _plural_special(word: String): String {
    switch word {
        "oxen": return word
        "mice": return word
        "lice": return word
        "ox": return "oxen"
        "mouse": return "mice"
        "louse": return "lice"
        "axis": return "axes"
        "testis": return "testes"
        _: return ""
    }
}

func _plural_conditional(word: String): String {
    var latin = _plural_latin_index(word)
    if not latin.is_empty() {
        return latin
    }
    var consonant_y = _plural_consonant_y(word)
    if not consonant_y.is_empty() {
        return consonant_y
    }
    return _plural_fe(word)
}

func _plural_latin_index(word: String): String {
    if not word.ends_with("ix") and not word.ends_with("ex") {
        return ""
    }
    var stem = _cut(word, 2)
    if stem.ends_with("matr") or stem.ends_with("vert") or stem.ends_with("ind") {
        return "{stem}ices"
    }
    return ""
}

func _plural_consonant_y(word: String): String {
    if not word.ends_with("y") {
        return ""
    }
    var before_y = _code_before(word, 1)
    if before_y >= 0 and not _is_vowel_or_y(before_y) or word.ends_with("quy") {
        return _ending(word, 1, "ies")
    }
    return ""
}

func _plural_fe(word: String): String {
    if not word.ends_with("fe") or word.ends_with("hive") {
        return ""
    }
    var before_fe = _code_before(word, 2)
    if before_fe >= 0 and before_fe != 102 {
        return _ending(word, 2, "ves")
    }
    return ""
}

func _plural_by_ending(word: String): String {
    if word.ends_with("x") or word.ends_with("ch") or word.ends_with("ss") or word.ends_with("sh") {
        return "{word}es"
    }
    if word.ends_with("hive") {
        return "{word}s"
    }
    if word.ends_with("lf") or word.ends_with("rf") {
        return _ending(word, 1, "ves")
    }
    if word.ends_with("sis") {
        return _ending(word, 2, "es")
    }
    if word.ends_with("ta") or word.ends_with("ia") {
        return word
    }
    if word.ends_with("tum") or word.ends_with("ium") {
        return _ending(word, 2, "a")
    }
    if word.ends_with("buffalo") or word.ends_with("tomato") {
        return "{word}es"
    }
    if word.ends_with("bus") or word.ends_with("alias") or word.ends_with("status") {
        return "{word}es"
    }
    if word.ends_with("octopi") or word.ends_with("viri") {
        return word
    }
    if word.ends_with("octopus") or word.ends_with("virus") {
        return _ending(word, 2, "i")
    }
    if word.ends_with("s") {
        return word
    }
    return "{word}s"
}

func _singular_word(word: String): String {
    if word.is_empty() or _is_uncountable(word) {
        return word
    }
    var irregular = _irregular(word, false)
    if not irregular.is_empty() {
        return irregular
    }
    var special = _singular_special(word)
    if not special.is_empty() {
        return special
    }
    var conditional = _singular_conditional(word)
    if not conditional.is_empty() {
        return conditional
    }
    return _singular_by_ending(word)
}

func _singular_special(word: String): String {
    switch word {
        "oxen": return "ox"
        "axis": return "axis"
        "axes": return "axis"
        "mice": return "mouse"
        "lice": return "louse"
        _: return ""
    }
}

func _singular_conditional(word: String): String {
    var consonant_ies = _singular_consonant_ies(word)
    if not consonant_ies.is_empty() {
        return consonant_ies
    }
    var fe = _singular_ves(word)
    if not fe.is_empty() {
        return fe
    }
    return _singular_sis(word)
}

func _singular_consonant_ies(word: String): String {
    if not word.ends_with("ies") or word.ends_with("movies") or word.ends_with("series") {
        return ""
    }
    var before_ies = _code_before(word, 3)
    if before_ies >= 0 and not _is_vowel_or_y(before_ies) or word.ends_with("quies") {
        return _ending(word, 3, "y")
    }
    return ""
}

func _singular_ves(word: String): String {
    if not word.ends_with("ves") or word.ends_with("lves") or word.ends_with("rves") or word.ends_with("tives") or word.ends_with("hives") {
        return ""
    }
    var before_ves = _code_before(word, 3)
    if before_ves >= 0 and before_ves != 102 {
        return _ending(word, 3, "fe")
    }
    return ""
}

func _singular_sis(word: String): String {
    if not word.ends_with("sis") and not word.ends_with("ses") or word.ends_with("databases") {
        return ""
    }
    var stem = _cut(word, 3)
    if stem.ends_with("analy") or stem.ends_with("ba") or stem.ends_with("diagno") or stem.ends_with("parenthe") or stem.ends_with("progno") or stem.ends_with("synop") or stem.ends_with("the") {
        return "{stem}sis"
    }
    return ""
}

func _singular_by_ending(word: String): String {
    if word.ends_with("databases") {
        return _cut(word, 1)
    }
    if word.ends_with("quizzes") {
        return _cut(word, 3)
    }
    if word.ends_with("matrices") {
        return _ending(word, 4, "ix")
    }
    if word.ends_with("vertices") or word.ends_with("indices") {
        return _ending(word, 4, "ex")
    }
    if word.ends_with("aliases") or word.ends_with("statuses") {
        return _cut(word, 2)
    }
    if word.ends_with("alias") or word.ends_with("status") or word.ends_with("octopus") or word.ends_with("virus") {
        return word
    }
    if word.ends_with("octopi") or word.ends_with("viri") {
        return _ending(word, 1, "us")
    }
    if word.ends_with("crisis") or word.ends_with("testis") or word.ends_with("crises") or word.ends_with("testes") {
        return _ending(word, 2, "is")
    }
    if word.ends_with("shoes") {
        return _cut(word, 1)
    }
    if word.ends_with("oes") or word.ends_with("buses") {
        return _cut(word, 2)
    }
    if word.ends_with("bus") {
        return word
    }
    if word.ends_with("xes") or word.ends_with("ches") or word.ends_with("sses") or word.ends_with("shes") {
        return _cut(word, 2)
    }
    if word.ends_with("movies") {
        return _cut(word, 1)
    }
    if word.ends_with("series") {
        return word
    }
    if word.ends_with("lves") or word.ends_with("rves") {
        return _ending(word, 3, "f")
    }
    if word.ends_with("tives") or word.ends_with("hives") {
        return _cut(word, 1)
    }
    if word.ends_with("ta") or word.ends_with("ia") {
        return _ending(word, 1, "um")
    }
    if word.ends_with("news") or word.ends_with("ss") {
        return word
    }
    if word.ends_with("s") {
        return _cut(word, 1)
    }
    return word
}

func _ending(word: String, count: Integer, ending: String): String {
    var kept = _cut(word, count)
    return "{kept}{ending}"
}

func to_bytes(): Buffer {
    var bytes = Buffer(_length)
    var index = 0
    while index < _length {
        var code = _buffer._read_byte_at(index)
        bytes.append(code)
        index = index + 1
    }
    return bytes
}
