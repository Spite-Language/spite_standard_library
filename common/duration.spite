enum Unit {
    'nanoseconds'
    'microseconds'
    'milliseconds'
    'seconds'
    'minutes'
    'hours'
}

var _seconds: Long = 0
var _nanoseconds: Long = 0

func Duration(amount: Long, unit: Unit) {
    var per_second = _units_per_second(unit)
    var seconds_per_unit = _seconds_per_unit(unit)
    var nanoseconds_per_unit = _nanoseconds_per_unit(unit)
    _seconds = amount / per_second * seconds_per_unit
    _nanoseconds = amount % per_second * nanoseconds_per_unit
}

func Duration(from: String): Duration? {
    return from._as_duration()
}

func total(unit: Unit): Long {
    var per_second = _units_per_second(unit)
    var seconds_per_unit = _seconds_per_unit(unit)
    var nanoseconds_per_unit = _nanoseconds_per_unit(unit)
    return _seconds * per_second / seconds_per_unit + _nanoseconds / nanoseconds_per_unit
}

func part(unit: Unit): Long {
    switch unit {
        'hours': return _seconds / 3600
        'minutes': return _seconds / 60 % 60
        'seconds': return _seconds % 60
        _: return _nanoseconds / _nanoseconds_per_unit(unit)
    }
}

func get_is_negative(): Boolean {
    return _seconds < 0 or _nanoseconds < 0
}

func get_is_zero(): Boolean {
    return _seconds == 0 and _nanoseconds == 0
}

func sum(other: Duration): Duration {
    return _made(_seconds + other._seconds, _nanoseconds + other._nanoseconds)
}

func subtract(other: Duration): Duration {
    return _made(_seconds - other._seconds, _nanoseconds - other._nanoseconds)
}

func multiply(times: Long): Duration {
    return _made(_seconds * times, _nanoseconds * times)
}

func negate(): Duration {
    return _made(-_seconds, -_nanoseconds)
}

func equals(other: Duration): Boolean {
    return _seconds == other._seconds and _nanoseconds == other._nanoseconds
}

func less_than(other: Duration): Boolean {
    if _seconds != other._seconds {
        return _seconds < other._seconds
    }
    return _nanoseconds < other._nanoseconds
}

func greater_than(other: Duration): Boolean {
    return other < this
}

func to_string(): String {
    if get_is_zero() {
        return "PT0S"
    }
    var sign = ""
    var size = this
    if get_is_negative() {
        sign = "-"
        size = -this
    }
    var hours = size.part('hours')
    var minutes = size.part('minutes')
    var seconds = size.part('seconds')
    var nanoseconds: Integer = size._nanoseconds
    var fraction = nanoseconds._written_as_fraction()
    var written = "{sign}PT"
    if hours != 0 {
        written = "{written}{hours}H"
    }
    if minutes != 0 {
        written = "{written}{minutes}M"
    }
    if seconds != 0 or not fraction.is_empty() {
        written = "{written}{seconds}{fraction}S"
    }
    return written
}

func _written_as_offset(): String {
    var sign = "+"
    var size = this
    if get_is_negative() {
        sign = "-"
        size = -this
    }
    var seconds_long = size.total('seconds')
    var seconds: Integer = seconds_long
    var hours = seconds / 3600
    var minutes = seconds / 60 % 60
    var remaining = seconds % 60
    var hours_text = hours._written_with_digits(2)
    var minutes_text = minutes._written_with_digits(2)
    if remaining == 0 {
        return "{sign}{hours_text}:{minutes_text}"
    }
    var remaining_text = remaining._written_with_digits(2)
    return "{sign}{hours_text}:{minutes_text}:{remaining_text}"
}

func _made(seconds: Long, nanoseconds: Long): Duration {
    var whole = seconds + nanoseconds / 1000000000
    var part_value = nanoseconds % 1000000000
    if whole > 0 and part_value < 0 {
        whole = whole - 1
        part_value = part_value + 1000000000
    }
    if whole < 0 and part_value > 0 {
        whole = whole + 1
        part_value = part_value - 1000000000
    }
    var made = Duration(whole, 'seconds')
    made._nanoseconds = part_value
    return made
}

func _units_per_second(unit: Unit): Long {
    switch unit {
        'nanoseconds': return 1000000000
        'microseconds': return 1000000
        'milliseconds': return 1000
        _: return 1
    }
}

func _nanoseconds_per_unit(unit: Unit): Long {
    switch unit {
        'nanoseconds': return 1
        'microseconds': return 1000
        'milliseconds': return 1000000
        _: return 1000000000
    }
}

func _seconds_per_unit(unit: Unit): Long {
    if unit == 'hours' {
        return 3600
    }
    if unit == 'minutes' {
        return 60
    }
    return 1
}
