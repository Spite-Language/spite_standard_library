# ../docs/memory.md#the-numbers

var _buffer = Buffer(4)
var _lowest_subnormal_exponent: Long = -149
var _half_infinity: Long = 31744
var _half_not_a_number: Long = 32256
var _special_exponent_field: Long = 255
var _largest_finite_half_exponent: Long = 142
var _smallest_normal_half_exponent: Long = 113
var _half_exponent_rebias: Long = 112
var _subnormal_shift_origin: Long = 126

func Float(from: String): Float? {
    var text = from.trim()
    var valid = text._is_decimal()
    fallback valid
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    var end: Long = 0
    return library.strtof_as_float(text, end)
}

func Pi(): Float {
    return 3.1415927
}

func Tau(): Float {
    return 6.2831855
}

func EulerNumber(): Float {
    return 2.7182817
}

func Infinity(): Float {
    var one: Float = 1.0
    var zero: Float = 0.0
    return one / zero
}

func NotANumber(): Float {
    var pattern: UnsignedInteger = 2143289344
    return pattern.bits_as_float()
}

func Largest(): Float {
    var pattern: UnsignedInteger = 2139095039
    return pattern.bits_as_float()
}

func Smallest(): Float {
    var largest = Float.Largest()
    var zero: Float = 0.0
    return zero - largest
}

func _value(): Float {
    return _buffer._read_float_at(0)
}

func _bits(): UnsignedInteger

func _square_root(): Float

func _sine(): Float

func _cosine(): Float

func _tangent(): Float

func _arc_sine(): Float

func _arc_cosine(): Float

func _arc_tangent(): Float

func _arc_tangent_over(run: Float): Float

func _raised_to(exponent: Float): Float

func _exponential(): Float

func _logarithm(): Float

func _logarithm_base_2(): Float

func _logarithm_base_10(): Float

func _floor(): Float

func _ceiling(): Float

func _truncate(): Float

func _round(): Float

func bits(): UnsignedInteger {
    return _bits()
}

func square_root(): Float {
    return _square_root()
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(4)
}

func absolute(): Float {
    var value = _value()
    if value <= 0.0 {
        var zero: Float = 0.0
        return zero - value
    }
    return value
}

func sum(other: Float): Float {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: Float): Float {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: Float): Float {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: Float): Float {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: Float): Float {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: Float): Float {
    var left = _value()
    var right = other._value()
    if right < left or right != right {
        return right
    }
    return left
}

func maximum(other: Float): Float {
    var left = _value()
    var right = other._value()
    if right > left or right != right {
        return right
    }
    return left
}

func equals(other: Float): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: Float): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: Float): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var wide: Double = _value()
    return wide._shortest_text(wide, 16777216, _lowest_subnormal_exponent, 9)
}

func to_debug(): String {
    return to_string()
}

func sine(): Float {
    return _sine()
}

func cosine(): Float {
    return _cosine()
}

func tangent(): Float {
    return _tangent()
}

func arc_sine(): Float {
    return _arc_sine()
}

func arc_cosine(): Float {
    return _arc_cosine()
}

func arc_tangent(): Float {
    return _arc_tangent()
}

func arc_tangent_over(run: Float): Float {
    return _arc_tangent_over(run)
}

func power(exponent: Float): Float {
    return _raised_to(exponent)
}

func exponential(): Float {
    return _exponential()
}

func logarithm(): Float {
    return _logarithm()
}

func logarithm_base_2(): Float {
    return _logarithm_base_2()
}

func logarithm_base_10(): Float {
    return _logarithm_base_10()
}

func floor(): Float {
    return _floor()
}

func ceiling(): Float {
    return _ceiling()
}

func truncate(): Float {
    return _truncate()
}

func round(): Float {
    return _round()
}

func clamp(low: Float, high: Float): Float {
    var value = _value()
    var lowest = low._value()
    var highest = high._value()
    if value != value {
        return value
    }
    if lowest != lowest {
        return lowest
    }
    if highest != highest {
        return highest
    }
    var held = value
    if held < lowest {
        held = lowest
    }
    if held > highest {
        held = highest
    }
    return held
}

func is_not_a_number(): Boolean {
    var value = _value()
    return value != value
}

func is_finite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference == 0.0
}

func is_infinite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference != 0.0 and value == value
}

func negate(): Float {
    var value = _value()
    var minus_one: Float = -1.0
    return value * minus_one
}

func to_half_precision(): UnsignedShort {
    var pattern: Long = bits()
    var sign: Long = pattern / 2147483648
    var exponent: Long = (pattern / 8388608) % 256
    var mantissa: Long = pattern % 8388608
    var magnitude = _half_infinity
    if exponent == _special_exponent_field {
        magnitude = _half_special(mantissa)
    } else if exponent > _largest_finite_half_exponent {
        magnitude = _half_infinity
    } else if exponent >= _smallest_normal_half_exponent {
        var half_mantissa = _rounded_to_even(mantissa, 8192)
        magnitude = (exponent - _half_exponent_rebias) * 1024 + half_mantissa
    } else if exponent == 0 {
        magnitude = 0
    } else {
        magnitude = _half_subnormal(exponent, mantissa)
    }
    return sign * 32768 + magnitude
}

func _half_special(mantissa: Long): Long {
    if mantissa != 0 {
        return _half_not_a_number
    }
    return _half_infinity
}

func _half_subnormal(exponent: Long, mantissa: Long): Long {
    var shift = _subnormal_shift_origin - exponent
    fallback shift <= 25
    var one: Long = 1
    var divisor = one.shifted_left(shift)
    return _rounded_to_even(mantissa + 8388608, divisor)
}

func _rounded_to_even(numerator: Long, divisor: Long): Long {
    var quotient: Long = numerator / divisor
    var rest: Long = numerator % divisor
    var halfway: Long = divisor / 2
    if rest > halfway {
        return quotient + 1
    }
    if rest == halfway and quotient % 2 == 1 {
        return quotient + 1
    }
    return quotient
}

func _as_integer(): Integer {
    return _value()
}

func _as_long(): Long {
    return _value()
}

func _as_float(): Float {
