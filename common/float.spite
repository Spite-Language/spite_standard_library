func clamp(low: Float, high: Float): Float {
    var value = _value()
    var lowest = low._value()
    var highest = high._value()
    if value != value {
        return value
    }
    if lowest != lowest {
        return lowest
    }
    if highest != highest {
        return highest
    }
    var held = value
    if held < lowest {
        held = lowest
    }
    if held > highest {
        held = highest
    }
    return held
}

func is_not_a_number(): Boolean {
    var value = _value()
    return value != value
}

func is_finite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference == 0.0
}

func is_infinite(): Boolean {
    var value = _value()
    var difference = value - value
    return difference != 0.0 and value == value
}

func negate(): Float {
    var value = _value()
    var minus_one: Float = -1.0
    return value * minus_one
}

func to_half_precision(): UnsignedShort {
    var bits: Long = bits().to_long()
    var sign: Long = bits / 2147483648
    var exponent: Long = (bits / 8388608) % 256
    var mantissa: Long = bits % 8388608
    var magnitude: Long = 31744
    if exponent == 255 {
        magnitude = _half_special(mantissa)
    } else if exponent > 142 {
        magnitude = 31744
    } else if exponent >= 113 {
        var half_mantissa = _rounded_to_even(mantissa, 8192)
        magnitude = (exponent - 112) * 1024 + half_mantissa
    } else if exponent == 0 {
        magnitude = 0
    } else {
        magnitude = _half_subnormal(exponent, mantissa)
    }
    return sign * 32768 + magnitude
}

func _half_special(mantissa: Long): Long {
    if mantissa != 0 {
        return 32256
    }
    return 31744
}

func _half_subnormal(exponent: Long, mantissa: Long): Long {
    var shift = 126 - exponent
    if shift > 25 {
        return 0
    }
    var one: Long = 1
    var divisor = one.shifted_left(shift)
    return _rounded_to_even(mantissa + 8388608, divisor)
}

func _rounded_to_even(numerator: Long, divisor: Long): Long {
    var quotient: Long = numerator / divisor
    var remainder: Long = numerator % divisor
    var halfway: Long = divisor / 2
    if remainder > halfway {
        return quotient + 1
    }
    if remainder == halfway and quotient % 2 == 1 {
        return quotient + 1
    }
    return quotient
}

func get_pi(): Float {
    return 3.1415927
}

func get_tau(): Float {
    return 6.2831855
}

func get_euler_number(): Float {
    return 2.7182817
}

func get_infinity(): Float {
    var one: Float = 1.0
    var zero: Float = 0.0
    return one / zero
}

func get_not_a_number(): Float {
    var bits: UnsignedInteger = 2143289344
    return bits.bits_as_float()
}

func get_largest(): Float {
    var bits: UnsignedInteger = 2139095039
    return bits.bits_as_float()
}

func get_smallest(): Float {
    var largest = get_largest()
    var zero: Float = 0.0
    return zero - largest
}
