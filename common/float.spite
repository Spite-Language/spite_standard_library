    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    return library.acosf_as_float(value)
}

func arc_tangent(): Float {
    var value = _value()
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    return library.atanf_as_float(value)
}

func arc_tangent_over(run: Float): Float {
    var rise = _value()
    var across = run._value()
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    return library.atan2f_as_float(rise, across)
}

func power(exponent: Float): Float {
    var base = _value()
    var raised = exponent._value()
    var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
    return library.powf_as_float(base, raised)
}

