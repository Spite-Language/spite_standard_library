# ../docs/memory.md#the-numbers

var _buffer = Buffer(4)

func _value(): Float {
    return _buffer._read_float_at(0)
}

func _bits(): UnsignedInteger

func _square_root(): Float

func _sine(): Float

func _cosine(): Float

func _tangent(): Float

func _arc_sine(): Float

func _arc_cosine(): Float

func _arc_tangent(): Float

func _arc_tangent_over(run: Float): Float

