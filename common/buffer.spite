# ../docs/memory.md#the-buffer

enum ByteOrder {
    'little_endian'
    'big_endian'
}

var _room = Buffer(1024)
var item_count = 0
var capacity = 1024
var position = 0

func _read_byte_at(at: Integer): Integer

func _write_byte_at(at: Integer, value: Integer)

func Buffer(size: Integer) {
    crash size <= 1024
    capacity = size
}

func count(): Integer {
    return item_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func remaining(): Integer {
    return item_count - position
}

func get_at(index: Integer): Integer? {
    if index >= 0 {
        return _read_byte_at(index)
    }
    return null
}

func set_at(index: Integer, value: Integer) {
    crash index >= 0 and index < capacity
    _write_byte_at(index, value)
}

func append(value: Integer) {
    make_room()
    _write_byte_at(item_count, value)
    item_count = item_count + 1
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        item_count = kept_count
        if position > item_count {
            position = item_count
        }
    }
}

func clear() {
    item_count = 0
    position = 0
}

func reserve(wanted: Integer) {
    if wanted > capacity {
        crash wanted <= capacity
    }
}

func make_room() {
    if item_count == capacity {
        reserve(item_count + 1)
    }
}

func drop() {
    clear()
}

func copy(): Buffer {
    var copied = Buffer(item_count)
    var index = 0
    while index < item_count {
        var read = _read_byte_at(index)
        copied.append(read)
        index = index + 1
    }
    return copied
}

func copy_first_bytes(width: Integer): Buffer {
    var copied = Buffer(width)
    var index = 0
    while index < width {
        var read = _read_byte_at(index)
        copied.append(read)
        index = index + 1
    }
    return copied
}

func compare_bytes(other: Buffer, at: Integer, wanted: Integer): Integer {
    var index = 0
    while index < wanted {
        var mine = read_byte_at(at + index)
        var theirs = other.read_byte_at(at + index)
        if mine != theirs and mine < theirs {
            return -1
        }
        if mine != theirs {
            return 1
        }
        index = index + 1
    }
    return 0
}

func _inside(at: Integer, width: Integer): Boolean {
    return at >= 0 and at <= item_count - width
}

func read_byte(): Integer? {
    assert _inside(position, 1)
    var read = _read_byte_at(position)
    position = position + 1
    return read
}

func read_tiny(): Integer? {
    assert _inside(position, 1)
    var read = _read_tiny_at(position)
    position = position + 1
    return read
}

func read_byte_at(at: Integer): Integer {
    assert _inside(at, 1)
    return _read_byte_at(at)
}

func read_tiny_at(at: Integer): Integer {
    assert _inside(at, 1)
    return _read_tiny_at(at)
}

func _read_tiny_at(at: Integer): Integer {
    var read = _read_byte_at(at)
    if read > 127 {
        return read - 256
    }
    return read
}

func append_tiny(value: Integer) {
    reserve(item_count + 1)
    _write_byte_at(item_count, value)
    item_count = item_count + 1
}

func write_byte_at(at: Integer, value: Integer) {
    crash _inside(at, 1)
    _write_byte_at(at, value)
}

func write_tiny_at(at: Integer, value: Integer) {
    crash _inside(at, 1)
    _write_byte_at(at, value)
}

func read_short_little_endian(): Integer? {
    assert _inside(position, 2)
    var read = _load_short(position, false)
    position = position + 2
    return read
}

func read_short_big_endian(): Integer? {
