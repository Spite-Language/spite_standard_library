# ../docs/memory.md#the-buffer

var item_count = 0
var capacity = 0
var position = 0

func Buffer(size: Integer) {
    crash size >= 0
    _resize_room(size)
    capacity = size
}

func _resize_room(size: Integer)

func _read_byte_at(at: Integer): Byte

func _write_byte_at(at: Integer, value: Byte)

func _read_tiny_at(at: Integer): Tiny

func _write_tiny_at(at: Integer, value: Tiny)

func _read_short_at(at: Integer): Short

func _write_short_at(at: Integer, value: Short)

func _read_unsigned_short_at(at: Integer): UnsignedShort

func _write_unsigned_short_at(at: Integer, value: UnsignedShort)

func _read_integer_at(at: Integer): Integer

func _write_integer_at(at: Integer, value: Integer)

func _read_unsigned_integer_at(at: Integer): UnsignedInteger

func _write_unsigned_integer_at(at: Integer, value: UnsignedInteger)

func _read_long_at(at: Integer): Long

func _write_long_at(at: Integer, value: Long)

func _read_unsigned_long_at(at: Integer): UnsignedLong

func _write_unsigned_long_at(at: Integer, value: UnsignedLong)

func _read_float_at(at: Integer): Float

func _write_float_at(at: Integer, value: Float)

func _read_double_at(at: Integer): Double

func _write_double_at(at: Integer, value: Double)

func count(): Integer {
    return item_count
}

func take_written(written_count: Integer) {
    crash written_count >= 0 and written_count <= capacity
    item_count = written_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func remaining(): Integer {
    return item_count - position
}

func set_position(at: Integer) {
    crash at >= 0 and at <= item_count
    position = at
}

func get_at(index: Integer): Byte? {
    assert _inside(index, 1)
    return _read_byte_at(index)
}

func set_at(index: Integer, value: Byte) {
    crash _inside(index, 1)
    _write_byte_at(index, value)
}

func append(value: Byte) {
    reserve(item_count + 1)
    _write_byte_at(item_count, value)
    item_count = item_count + 1
}

func truncate(kept_count: Integer) {
    crash kept_count >= 0
    if kept_count < item_count {
        item_count = kept_count
    }
    if position > item_count {
        position = item_count
    }
}

func clear() {
    item_count = 0
    position = 0
}

func reserve(wanted: Integer) {
    assert wanted > capacity
    var grown = capacity * 2
    if grown < wanted {
        grown = wanted
    }
    _resize_room(grown)
    capacity = grown
}

func copy(): Buffer {
    var copied = Buffer(item_count)
    copied.append_bytes(this, 0, item_count)
    return copied
}

func copy_first_bytes(width: Integer): Buffer {
    var copied = Buffer(width)
    copied.append_bytes(this, 0, width)
    return copied
}

func _inside(at: Integer, width: Integer): Boolean {
    return at >= 0 and at <= item_count - width
}

func _reversed(at: Integer, width: Integer): Buffer {
    var reversed = Buffer(width)
    var index = width - 1
    while index >= 0 {
        var read = _read_byte_at(at + index)
        reversed.append(read)
        index = index - 1
    }
    return reversed
}

func _reverse_in_place(at: Integer, width: Integer) {
    var low = at
    var high = at + width - 1
    while low < high {
        var low_byte = _read_byte_at(low)
        var high_byte = _read_byte_at(high)
        _write_byte_at(low, high_byte)
        _write_byte_at(high, low_byte)
        low = low + 1
        high = high - 1
    }
}

func read_byte(): Byte? {
    assert _inside(position, 1)
    var read = _read_byte_at(position)
    position = position + 1
    return read
}

func read_tiny(): Tiny? {
    assert _inside(position, 1)
    var read = read_tiny_at(position)
    position = position + 1
    return read
}

func read_tiny_at(at: Integer): Tiny? {
    assert _inside(at, 1)
    return _read_tiny_at(at)
}

func append_tiny(value: Tiny) {
    reserve(item_count + 1)
    item_count = item_count + 1
    write_tiny_at(item_count - 1, value)
}

func write_tiny_at(at: Integer, value: Tiny) {
    crash _inside(at, 1)
    _write_tiny_at(at, value)
}

