func read_bytes(wanted: Integer): Buffer? {
    var run = read_bytes_at(position, wanted)
    if run {
        position = position + wanted
    }
    return run
}

func read_bytes_at(at: Integer, wanted: Integer): Buffer? {
    crash wanted >= 0
    assert _inside(at, wanted)
    var run = Buffer(wanted)
    var index = 0
    while index < wanted {
        var read = _read_byte_at(at + index)
        run.append(read)
        index = index + 1
    }
    return run
}

func append_bytes(other: Buffer, start: Integer, wanted: Integer) {
    crash start >= 0 and wanted >= 0 and start <= other.item_count - wanted
    var index = 0
    while index < wanted {
        var read = other._read_byte_at(start + index)
        append(read)
        index = index + 1
    }
}

func to_utf8_text(): String? {
    var index = 0
    while index < item_count {
        var sequence_length = _utf8_length_at(index)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if item_count == 0 {
        return ""
    }
    return text(0, item_count)
}

func text(at: Integer, wanted: Integer): String? {
    assert at >= 0 and wanted >= 0 and at <= item_count - wanted
    var end = at + wanted
    var index = at
    while index < end {
        var sequence_length = _utf8_length_before(index, end)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if wanted == 0 {
        return ""
    }
    return ""
}

func _utf8_length_at(index: Integer): Integer {
    return _utf8_length_before(index, item_count)
}

func _utf8_length_before(index: Integer, limit: Integer): Integer {
    var lead: Integer = _read_byte_at(index)
    var length = _utf8_length_of(lead)
    if length <= 1 {
        return length
    }
    if index + length > limit {
        return 0
    }
    var second: Integer = _read_byte_at(index + 1)
    if second < _utf8_lowest_second(lead) or second > _utf8_highest_second(lead) {
        return 0
    }
    var place = 2
    while place < length {
        var following: Integer = _read_byte_at(index + place)
        if following < 128 or following > 191 {
            return 0
        }
        place = place + 1
    }
    return length
}

func _utf8_length_of(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    if lead >= 194 and lead <= 223 {
        return 2
    }
    if lead >= 224 and lead <= 239 {
        return 3
    }
    if lead >= 240 and lead <= 244 {
        return 4
    }
    return 0
}

func _utf8_lowest_second(lead: Integer): Integer {
    if lead == 224 {
        return 160
    }
    if lead == 240 {
        return 144
    }
    return 128
}

func _utf8_highest_second(lead: Integer): Integer {
    if lead == 237 {
        return 159
    }
    if lead == 244 {
        return 143
    }
    return 191
}

func _load_short(at: Integer, big: Boolean): Integer {
    var read = _load_unsigned_short(at, big)
    if read > 32767 {
        return read - 65536
    }
    return read
}

func _store_short(at: Integer, value: Integer, big: Boolean) {
    _store_unsigned_short(at, value, big)
}

func _load_unsigned_short(at: Integer, big: Boolean): Integer {
    var first = _read_byte_at(at)
    var second = _read_byte_at(at + 1)
    if big {
        return first * 256 + second
    }
    return second * 256 + first
}

func _store_unsigned_short(at: Integer, value: Integer, big: Boolean) {
    var low = value % 256
    var high = value / 256
    if big {
        _write_byte_at(at, high)
        _write_byte_at(at + 1, low)
        return
    }
    _write_byte_at(at, low)
    _write_byte_at(at + 1, high)
}

func _load_integer(at: Integer, big: Boolean): Integer {
    return _load_unsigned_integer(at, big)
}

func _store_integer(at: Integer, value: Integer, big: Boolean) {
    _store_unsigned_integer(at, value, big)
}

func _load_unsigned_integer(at: Integer, big: Boolean): Integer {
    var first = _read_byte_at(at)
    var second = _read_byte_at(at + 1)
    var third = _read_byte_at(at + 2)
    var fourth = _read_byte_at(at + 3)
    if big {
        return first * 16777216 + second * 65536 + third * 256 + fourth
    }
    return fourth * 16777216 + third * 65536 + second * 256 + first
}

func _store_unsigned_integer(at: Integer, value: Integer, big: Boolean) {
    var first = value % 256
    var rest = value / 256
    var second = rest % 256
    rest = rest / 256
    var third = rest % 256
    var fourth = rest / 256
    if big {
        _write_byte_at(at, fourth)
        _write_byte_at(at + 1, third)
        _write_byte_at(at + 2, second)
        _write_byte_at(at + 3, first)
        return
    }
    _write_byte_at(at, first)
    _write_byte_at(at + 1, second)
    _write_byte_at(at + 2, third)
    _write_byte_at(at + 3, fourth)
}

func _load_long(at: Integer, big: Boolean): Integer {
    return _load_unsigned_long(at, big)
}

func _store_long(at: Integer, value: Integer, big: Boolean) {
    _store_unsigned_long(at, value, big)
}

func _load_unsigned_long(at: Integer, big: Boolean): Integer {
    var first = _read_byte_at(at)
    var second = _read_byte_at(at + 1)
    var third = _read_byte_at(at + 2)
    var fourth = _read_byte_at(at + 3)
    var fifth = _read_byte_at(at + 4)
    var sixth = _read_byte_at(at + 5)
    var seventh = _read_byte_at(at + 6)
    var eighth = _read_byte_at(at + 7)
    if big {
        return first * 72057594037927936 + second * 281474976710656 + third * 1099511627776 + fourth * 4294967296 + fifth * 16777216 + sixth * 65536 + seventh * 256 + eighth
    }
    return eighth * 72057594037927936 + seventh * 281474976710656 + sixth * 1099511627776 + fifth * 4294967296 + fourth * 16777216 + third * 65536 + second * 256 + first
}

func _store_unsigned_long(at: Integer, value: Integer, big: Boolean) {
    var first = value % 256
    var rest = value / 256
    var second = rest % 256
    rest = rest / 256
    var third = rest % 256
    rest = rest / 256
    var fourth = rest % 256
    rest = rest / 256
    var fifth = rest % 256
    rest = rest / 256
    var sixth = rest % 256
    rest = rest / 256
    var seventh = rest % 256
    var eighth = rest / 256
    if big {
        _write_byte_at(at, eighth)
        _write_byte_at(at + 1, seventh)
        _write_byte_at(at + 2, sixth)
        _write_byte_at(at + 3, fifth)
        _write_byte_at(at + 4, fourth)
        _write_byte_at(at + 5, third)
        _write_byte_at(at + 6, second)
        _write_byte_at(at + 7, first)
        return
    }
    _write_byte_at(at, first)
    _write_byte_at(at + 1, second)
    _write_byte_at(at + 2, third)
    _write_byte_at(at + 3, fourth)
    _write_byte_at(at + 4, fifth)
    _write_byte_at(at + 5, sixth)
    _write_byte_at(at + 6, seventh)
    _write_byte_at(at + 7, eighth)
}
