func _write_double_at(at: Integer, value: Double)

func _read_short_big_endian_at(at: Integer): Short

func _write_short_big_endian_at(at: Integer, value: Short)

func _read_unsigned_short_big_endian_at(at: Integer): UnsignedShort

func _write_unsigned_short_big_endian_at(at: Integer, value: UnsignedShort)

func _read_integer_big_endian_at(at: Integer): Integer

func _write_integer_big_endian_at(at: Integer, value: Integer)

func _read_unsigned_integer_big_endian_at(at: Integer): UnsignedInteger

func _write_unsigned_integer_big_endian_at(at: Integer, value: UnsignedInteger)

func _read_long_big_endian_at(at: Integer): Long

func _write_long_big_endian_at(at: Integer, value: Long)

func _read_unsigned_long_big_endian_at(at: Integer): UnsignedLong

func _write_unsigned_long_big_endian_at(at: Integer, value: UnsignedLong)

func _read_float_big_endian_at(at: Integer): Float

func _write_float_big_endian_at(at: Integer, value: Float)

func _read_double_big_endian_at(at: Integer): Double

func _write_double_big_endian_at(at: Integer, value: Double)

func count(): Integer {
    return item_count
}

func take_written(written_count: Integer) {
    crash written_count >= 0 and written_count <= _capacity
    item_count = written_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func get_at(index: Integer): Byte? {
    fallback _inside(index, 1)
    return _read_byte_at(index)
}

func set_at(index: Integer, value: Byte) {
    crash _inside(index, 1)
    _write_byte_at(index, value)
}

func append(value: Byte) {
    _reserve(item_count + 1)
    _write_byte_at(item_count, value)
    item_count = item_count + 1
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        item_count = kept_count
    }
}

func clear() {
    item_count = 0
}

func _reserve(wanted: Integer) {
    fallback wanted > _capacity
    var grown = _capacity * 2
    if grown < wanted {
        grown = wanted
    }
    _resize_room(grown)
    _capacity = grown
}

func copy(): Buffer {
    var copied = Buffer(item_count)
    copied.append_buffer(this, 0, item_count)
    return copied
}

func _copy_first_bytes(width: Integer): Buffer {
    var copied = Buffer(width)
    copied.append_buffer(this, 0, width)
    return copied
}

func _inside(at: Integer, width: Integer): Boolean {
    return at >= 0 and at <= item_count - width
}

func read_tiny_at(at: Integer): Tiny? {
    fallback _inside(at, 1)
    return _read_tiny_at(at)
}

func append_tiny(value: Tiny) {
    _reserve(item_count + 1)
    item_count = item_count + 1
    write_tiny_at(item_count - 1, value)
}

func write_tiny_at(at: Integer, value: Tiny) {
    crash _inside(at, 1)
    _write_tiny_at(at, value)
}

func read_short_little_endian_at(at: Integer): Short? {
    fallback _inside(at, 2)
    return _read_short_at(at)
}

