func _compare_bytes(other: Buffer, at: Integer, wanted: Integer): Integer {
    crash _inside(at, wanted) and other._inside(at, wanted)
    var index = 0
    while index < wanted {
        var mine = _read_byte_at(at + index)
        var theirs = other._read_byte_at(at + index)
        if mine < theirs {
            return -1
        }
        if mine > theirs {
            return 1
        }
        index = index + 1
    }
    return 0
}

func read_buffer_at(at: Integer, wanted: Integer): Buffer? {
    crash wanted >= 0
    fallback _inside(at, wanted)
    var run = Buffer(wanted)
    run.append_buffer(this, at, wanted)
    return run
}

func append_buffer(other: Buffer, start: Integer, wanted: Integer) {
    crash start >= 0 and wanted >= 0 and start <= other.item_count - wanted
    var kept = item_count
    _reserve(kept + wanted)
    _copy_bytes(kept, other, start, wanted)
    item_count = kept + wanted
}

func read_as_string(): String? {
    return read_string_at(0, item_count)
}

func read_string_at(at: Integer, wanted: Integer): String? {
    crash at >= 0 and wanted >= 0 and at <= item_count - wanted
    var end = at + wanted
    var index = at
    while index < end {
        var sequence_length = _utf8_length_before(index, end)
        fallback sequence_length != 0
        index = index + sequence_length
    }
    var made = String()
    made._append_bytes(this, at, wanted)
    return made
}

func _utf8_length_before(index: Integer, limit: Integer): Integer {
    var lead: Integer = _read_byte_at(index)
    var length = _utf8_length_of(lead)
    if length <= 1 {
        return length
    }
    fallback index + length <= limit
    var second: Integer = _read_byte_at(index + 1)
    fallback second >= _utf8_lowest_second(lead) and second <= _utf8_highest_second(lead)
    var place = 2
    while place < length {
        var following: Integer = _read_byte_at(index + place)
        fallback following >= 128 and following <= _highest_continuation_byte
        place = place + 1
    }
    return length
}

func _utf8_length_of(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    if lead >= _lowest_two_byte_lead and lead <= _highest_two_byte_lead {
        return 2
    }
    if lead >= _lowest_three_byte_lead and lead <= _highest_three_byte_lead {
        return 3
    }
    if lead >= _lowest_four_byte_lead and lead <= _highest_four_byte_lead {
        return 4
    }
    return 0
}

func _utf8_lowest_second(lead: Integer): Integer {
    if lead == _lowest_three_byte_lead {
        return _lowest_second_after_lowest_three_byte_lead
    }
    if lead == _lowest_four_byte_lead {
        return _lowest_second_after_lowest_four_byte_lead
    }
    return 128
}

func _utf8_highest_second(lead: Integer): Integer {
    if lead == _surrogate_range_lead {
        return _highest_second_before_surrogates
    }
    if lead == _highest_four_byte_lead {
        return _highest_second_below_largest_code_point
    }
    return _highest_continuation_byte
}
