func read_short_big_endian_at(at: Integer): Short? {
    assert _inside(at, 2)
    var reversed = _reversed(at, 2)
    return reversed._read_short_at(0)
}

func append_short_big_endian(value: Short) {
    reserve(item_count + 2)
    item_count = item_count + 2
    write_short_big_endian_at(item_count - 2, value)
