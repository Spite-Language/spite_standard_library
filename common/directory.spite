union Entry {
    Directory
    File
}

var path: String

func Directory(starting_path: Path) {
    path = starting_path.written
}

func move_to(new_path: Path): Boolean {
    if _has_volumes() {
        var place = _place_on_a_volume()
        fallback not place and not new_path.is_on_a_volume
    }
    var file_there = File(new_path)
    var folder_there = Directory(new_path)
    var file_exists = file_there.exists()
    var folder_exists = folder_there.exists()
    fallback not file_exists and not folder_exists
    var renamed = _rename_to(new_path.written)
    if renamed {
        path = new_path.written
    }
    return renamed
}

func get_folder_name(): String {
    if _has_volumes() {
        var place = _place_on_a_volume()
        if place {
            var volume_name = place._volume_name_of_a_root()
            if volume_name {
                return volume_name
            }
        }
    }
    var end = path.length()
    while end > 1 and path.byte_at(end - 1) == 47 {
        end = end - 1
    }
    var start = end
    while start > 0 and path.byte_at(start - 1) != 47 and path.byte_at(start - 1) != 92 {
        start = start - 1
    }
    var sliced = path.slice(start, end)
    crash sliced
    return sliced
}

func to_string(): String {
    return path
}

func entries(): List<Entry>? {
    var result = List<Entry>()
    var folder_names = _sorted_names(true)
    fallback folder_names
    var index = 0
    while index < folder_names.count() {
        var folder_name = folder_names[index]
        var folder_path = _inside(folder_name)
        var inside_path: Path? = folder_path
        crash inside_path
        var directory = Directory(inside_path)
        result.append(directory)
        index = index + 1
    }
    var file_names = _sorted_names(false)
    fallback file_names
    index = 0
    while index < file_names.count() {
        var file_name = file_names[index]
        var file_path = _inside(file_name)
        var inside_path: Path? = file_path
        crash inside_path
        var file = File(inside_path)
        result.append(file)
        index = index + 1
    }
    return result
}

func _inside(name: String): String {
    if path.ends_with("/") {
        return "{path}{name}"
    }
    return "{path}/{name}"
}

func _sorted_names(want_folders: Boolean): List<String>? {
    var names = _entry_names(want_folders)
    fallback names
    var count = names.count()
    var index = 1
    while index < count {
        var inner = index
        while inner > 0 {
            var before = names[inner - 1]
            crash before
            var here = names[inner]
            crash here
            if here < before {
                names.swap(inner - 1, inner)
            }
            inner = inner - 1
        }
        index = index + 1
    }
    return names
}

# ../../spite_documentation/programs.md#preloaded-files
func _has_volumes(): Boolean

func _place_on_a_volume(): Path? {
    var place: Path? = path
    fallback place
    fallback place.is_on_a_volume
    return place
}
