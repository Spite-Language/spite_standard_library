# ../docs/foreign_libraries.md#calling-back-into-spite

enum ContextPlace {
    'no_context'
    'context_first'
    'context_last'
}

var address: Long = 0
var context: Long = 0
var _function: Spite.Function? = null
var _cell: Long = 0

func ForeignCallback(function: Spite.Function, _where_context: ContextPlace) {
    _function = function
}

func drop() {
    _let_go(_cell)
}

func _let_go(cell: Long)
