singleton

func compress(bytes: Buffer): Buffer {
    var deflate = Deflate()
    var body = deflate.compress(bytes)
    var body_count = body.count()
    var output = Buffer(body_count + 6)
    output.append(120)
    output.append(156)
    output.append_buffer(body, 0, body_count)
    var checksum = _adler32(bytes)
    output.append_unsigned_integer_big_endian(checksum)
    return output
}

func decompress(bytes: Buffer): Buffer? {
    var total = bytes.count()
    fallback total >= 6
    var method = _byte_at(bytes, 0)
    var flags = _byte_at(bytes, 1)
    fallback method.bits_and(15) == 8
    fallback method.shifted_right(4) <= 7
    fallback (method * 256 + flags) % 31 == 0
    fallback flags.bits_and(32) == 0
    var body = bytes.read_buffer_at(2, total - 6)
    fallback body
    var deflate = Deflate()
    var output = deflate.decompress(body)
    fallback output
    var expected = bytes.read_unsigned_integer_big_endian_at(total - 4)
    fallback expected
    var computed = _adler32(output)
    fallback expected == computed
    return output
}

func _byte_at(room: Buffer, at: Integer): Integer {
    var held = room[at]
    crash held
    return held
}

func _adler32(bytes: Buffer): UnsignedInteger {
    var low: UnsignedInteger = 1
    var high: UnsignedInteger = 0
    var total = bytes.count()
    var index = 0
    while index < total {
        var chunk_limit = index + 5552
        var chunk_end = chunk_limit.minimum(total)
        while index < chunk_end {
            var value: UnsignedInteger = _byte_at(bytes, index)
            low = low + value
            high = high + low
            index = index + 1
        }
        low = low % 65521
        high = high % 65521
    }
    var shifted = high.shifted_left(16)
    return shifted.bits_or(low)
}
