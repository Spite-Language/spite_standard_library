var text = ""
var position = 0
var expected = ""
var crashes = false
var matched = false

func JsonCursor(starting_text: String) {
    text = starting_text
}

func failed(): Boolean {
    return not expected.is_empty()
}

func fail(wanted: String) {
    crash not crashes
    if expected.is_empty() {
        expected = wanted
    }
}

func finish() {
    skip_space()
    if position < text.length() {
        fail("the end of the text")
    }
}

func skip_space() {
    var spacing = true
    while spacing and position < text.length() {
        var code = text.code_at(position)
        spacing = code == 32 or code == 9 or code == 10 or code == 13
        if spacing {
            position = position + 1
        }
    }
}

func consume(token: String): Boolean {
    skip_space()
    var end = position + token.length()
    var found = text.slice(position, end)
    if found == token {
        position = end
        return true
    }
    return false
}

func expect(token: String) {
    var found = consume(token)
    if not found {
        fail("'{token}'")
    }
}

func read_null(): Boolean {
    return consume("null")
}

func read_boolean(): Boolean {
    var is_true = consume("true")
    if is_true {
        return true
    }
    var is_false = consume("false")
    if not is_false {
        fail("true or false")
    }
    return false
}

func read_number(): String {
    skip_space()
    var start = position
    skip_character(45)
    var whole_digits = skip_digits()
    if whole_digits == 0 {
        fail("a number")
        return "0"
    }
    if skip_character(46) {
        var fraction_digits = skip_digits()
        if fraction_digits == 0 {
            fail("a digit after '.'")
        }
    }
    if skip_character(101) or skip_character(69) {
        if not skip_character(43) {
            skip_character(45)
        }
        var exponent_digits = skip_digits()
        if exponent_digits == 0 {
            fail("a digit in the exponent")
        }
    }
    return text.slice(start, position)
}

func read_text(): String {
    var opened = consume("\"")
    if not opened {
        fail("text in double quotes")
        return ""
    }
    var made = String()
    var start = position
    var closed = false
    while not closed and position < text.length() and expected.is_empty() {
        var code = text.code_at(position)
        if code == 34 {
            var last_run = text.slice(start, position)
            made = made + last_run
            position = position + 1
            closed = true
        } else if code == 92 {
            var run = text.slice(start, position)
            var escaped = read_escape()
            made = made + run + escaped
            start = position
        } else {
            position = position + 1
        }
    }
    if not closed {
        fail("'\"' to close the text")
    }
    return made
}

func read_escape(): String {
    position = position + 1
    var code = 0
    if position < text.length() {
        code = text.code_at(position)
    }
    position = position + 1
    if code == 34 or code == 92 or code == 47 {
        return text.slice(position - 1, position)
    }
    switch code {
        110: return "\n"
        116: return "\t"
        114: return "\r"
        98: return text_of(8)
        102: return text_of(12)
        _: {
            if code != 117 {
                fail("an escape: one of \\\" \\\\ \\/ \\b \\f \\n \\r \\t \\u")
                return ""
            }
            var code_point = read_hexadecimal()
            if code_point >= 55296 and code_point < 56320 and consume("\\u") {
                var low = read_hexadecimal()
                code_point = 65536 + (code_point - 55296) * 1024 + low - 56320
            }
            return text_of(code_point)
        }
    }
}

func read_hexadecimal(): Integer {
    var value = 0
    var digits = 0
    while digits < 4 {
        var digit = hexadecimal_digit(position)
        if digit < 0 {
            fail("four hexadecimal digits after \\u")
            return 0
        }
        value = value * 16 + digit
        position = position + 1
        digits = digits + 1
    }
    return value
}

func hexadecimal_digit(at: Integer): Integer {
    if at >= text.length() {
        return -1
    }
    var code = text.code_at(at)
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    if code >= 65 and code <= 70 {
        return code - 55
    }
    return -1
}

func text_of(code_point: Integer): String {
    var result = String()
    var shift = 0
    var lead_marker = 0
    if code_point >= 65536 {
        shift = 18
        lead_marker = 240
    } else if code_point >= 2048 {
        shift = 12
        lead_marker = 224
    } else if code_point >= 128 {
        shift = 6
        lead_marker = 192
    }
    var moved = code_point.shifted_right(shift)
    var lead = moved.bits_or(lead_marker)
    result.append_code(lead)
    while shift > 0 {
        shift = shift - 6
        var part = code_point.shifted_right(shift)
        var low_bits = part.bits_and(63)
        var continuation = low_bits.bits_or(128)
        result.append_code(continuation)
    }
    return result
}

func skip_character(code: Integer): Boolean {
    if position < text.length() and text.code_at(position) == code {
        position = position + 1
        return true
    }
    return false
}

func skip_digits(): Integer {
    var start = position
    var digit = true
    while digit and position < text.length() {
        var code = text.code_at(position)
        digit = code >= 48 and code <= 57
        if digit {
            position = position + 1
        }
    }
    return position - start
}

func skip_value() {
    skip_space()
    if position >= text.length() {
        fail("a value")
        return
    }
    var code = text.code_at(position)
    if code == 34 {
        read_text()
    } else if code == 123 {
        skip_members()
    } else if code == 91 {
        skip_elements()
    } else {
        skip_word()
    }
}

func skip_word() {
    var is_true = consume("true")
    var is_false = consume("false")
    var is_null = read_null()
    if not is_true and not is_false and not is_null {
        read_number()
    }
}

func skip_members() {
    expect("\{")
    var more = not consume("}")
    while more and expected.is_empty() {
        read_text()
        expect(":")
        skip_value()
        more = consume(",")
        if not more {
            expect("}")
        }
    }
}

func skip_elements() {
    expect("[")
    var more = not consume("]")
    while more and expected.is_empty() {
        skip_value()
        more = consume(",")
        if not more {
            expect("]")
        }
    }
}
