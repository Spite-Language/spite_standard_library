union Target {
    Directory
    File
}

var clock = Clock()
var pending = List<String>()
var last_change = Duration(0, 'nanoseconds')
var _quiet_time = Duration(100, 'milliseconds')

func watch_for_changes(target: Target): Boolean {
    switch target {
        Directory: return watch_folder(target.path)
        File: return watch_file(target.path)
    }
}

func changes(): List<String> {
    _collect()
    var changed = List<String>()
    if not pending.is_empty() and _is_quiet() {
        changed = pending
        pending = List<String>()
    }
    return changed
}

func wait_for_changes() {
    _collect()
    while pending.is_empty() or not _is_quiet() {
        var waiting: Duration? = null
        if not pending.is_empty() {
            waiting = _quiet_left()
        }
        _wait_for_event(waiting)
        _collect()
    }
}

func _is_quiet(): Boolean {
    var left = _quiet_left()
    return left.is_negative or left.is_zero
}

func _quiet_left(): Duration {
    var now = clock.elapsed()
    var quiet_from = last_change + _quiet_time
    return quiet_from - now
}

func _note(path: String) {
    last_change = clock.elapsed()
    if not pending.contains(path) {
        pending.append(path)
    }
}

func _joined(folder: String, name: String): String {
    if folder.ends_with("/") {
        return "{folder}{name}"
    }
    return "{folder}/{name}"
}
