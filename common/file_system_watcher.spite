union Target {
    Directory
    File
}

var clock = Clock()
var pending = List<String>()
var last_change: Long = 0

func watch_for_changes(target: Target): Boolean {
    switch target {
        Directory: return watch_folder(target.path)
        File: return watch_file(target.path)
    }
}

func changes(): List<String> {
    _collect()
    var changed = List<String>()
    if not pending.is_empty() and _quiet_left() <= 0 {
        changed = pending
        pending = List<String>()
    }
    return changed
}

func wait_for_changes() {
    _collect()
    while pending.is_empty() or _quiet_left() > 0 {
        var waiting: Long = -1
        if not pending.is_empty() {
            waiting = _quiet_left()
        }
        _wait_for_event(waiting)
        _collect()
    }
}

func _quiet_left(): Long {
    var now = clock.elapsed_milliseconds()
    return last_change + 100 - now
}

func _note(path: String) {
    last_change = clock.elapsed_milliseconds()
    if not pending.contains(path) {
        pending.append(path)
    }
}

func _joined(folder: String, name: String): String {
    if folder.ends_with("/") {
        return "{folder}{name}"
    }
    return "{folder}/{name}"
}
