enum Weekday {
    'monday'
    'tuesday'
    'wednesday'
    'thursday'
    'friday'
    'saturday'
    'sunday'
}

var _year = 1970
var _month = 1
var _day = 1
var _days_in_leap_year = 366
var _days_in_common_year = 365
var _years_per_era = 400
var _last_year_of_era: Long = 399
var _days_in_march_to_july: Long = 153
var _days_in_400_years: Long = 146097
var _last_day_of_era: Long = 146096
var _days_in_4_common_years: Long = 1460
var _days_in_100_years: Long = 36524
var _days_from_year_0_march_to_1970: Long = 719468
var _largest_four_digit_year = 9999

func Date(year: Integer, month: Integer, day: Integer) {
    crash month >= 1 and month <= 12
    crash day >= 1 and day <= _days_in(year, month)
    _year = year
    _month = month
    _day = day
}

func Date(from: String): Date? {
    return from._as_date()
}

func get_year(): Integer {
    return _year
}

func get_month(): Integer {
    return _month
}

func get_day(): Integer {
    return _day
}

func get_is_leap_year(): Boolean {
    return _is_leap(_year)
}

func get_days_in_month(): Integer {
    return _days_in(_year, _month)
}

func get_days_in_year(): Integer {
    if _is_leap(_year) {
        return _days_in_leap_year
    }
    return _days_in_common_year
}

func get_day_of_year(): Integer {
    var first = Date(_year, 1, 1)
    var first_day = first.days_since_1970
    var this_day = get_days_since_1970()
    return this_day - first_day + 1
}

func get_weekday(): Weekday {
    var days = get_days_since_1970()
    var remainder = days % 7
    var shifted: Integer = remainder
    var index = (shifted + 10) % 7
    if index == 1 {
        return 'tuesday'
    } else if index == 2 {
        return 'wednesday'
    } else if index == 3 {
        return 'thursday'
    } else if index == 4 {
        return 'friday'
    } else if index == 5 {
        return 'saturday'
    } else if index == 6 {
        return 'sunday'
    } else {
        return 'monday'
    }
}

func get_days_since_1970(): Long {
    var year: Long = _year
    var month: Long = _month
    var day: Long = _day
    var shifted_month: Long = month - 3
    if _month <= 2 {
        year = year - 1
        shifted_month = month + 9
    }
    var era = year / _years_per_era
    if year < 0 {
        era = (year - _last_year_of_era) / _years_per_era
    }
    var year_of_era = year - era * _years_per_era
    var day_of_year = (_days_in_march_to_july * shifted_month + 2) / 5 + day - 1
    var day_of_era = year_of_era * _days_in_common_year + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * _days_in_400_years + day_of_era - _days_from_year_0_march_to_1970
}

func sum(period: Period): Date {
    var year: Long = _year
    var month: Long = _month
    var period_years: Long = period.years
    var period_months: Long = period.months
    var months = year * 12 + month - 1 + period_years * 12 + period_months
    var month_index = months % 12
    if month_index < 0 {
        month_index = month_index + 12
    }
    var moved_year_long = (months - month_index) / 12
    var moved_year: Integer = moved_year_long
    var moved_month_long = month_index + 1
    var moved_month: Integer = moved_month_long
    var day = _day
    var last_day = _days_in(moved_year, moved_month)
    if day > last_day {
        day = last_day
    }
    var moved = Date(moved_year, moved_month, day)
    var days_since_1970 = moved.days_since_1970
    var period_days: Long = period.days
    return _from_days(days_since_1970 + period_days)
}

func days_until(other: Date): Long {
    return other.days_since_1970 - get_days_since_1970()
}

func period_until(other: Date): Period {
    var months: Long = other._year * 12 + other._month - _year * 12 - _month
    var days: Long = other._day - _day
    if months > 0 and days < 0 {
        months = months - 1
        var whole_months_count: Integer = months
        var whole_months = Period(whole_months_count, 'months')
        var moved = this + whole_months
        days = moved.days_until(other)
    } else if months < 0 and days > 0 {
        months = months + 1
        var other_days_in_month: Long = other.days_in_month
        days = days - other_days_in_month
    }
    var years_long = months / 12
    var years_count: Integer = years_long
    var months_long = months % 12
    var months_count: Integer = months_long
    var days_count: Integer = days
    var whole_years = Period(years_count, 'years')
    var left_over_months = Period(months_count, 'months')
    var whole_days = Period(days_count, 'days')
    return whole_years + left_over_months + whole_days
}

func equals(other: Date): Boolean {
    return _year == other._year and _month == other._month and _day == other._day
}

func less_than(other: Date): Boolean {
    if _year != other._year {
        return _year < other._year
    }
    if _month != other._month {
        return _month < other._month
    }
    return _day < other._day
}

func greater_than(other: Date): Boolean {
    return other < this
}

func to_string(): String {
    var year = _written_year()
    var month = _month._written_with_digits(2)
    var day = _day._written_with_digits(2)
    return "{year}-{month}-{day}"
}

func _written_year(): String {
    if _year >= 0 and _year <= _largest_four_digit_year {
        return _year._written_with_digits(4)
    }
    var sign = "+"
    var size = _year
    if _year < 0 {
        sign = "-"
        size = -_year
    }
    var digits = size._written_with_digits(6)
    return "{sign}{digits}"
}

func _from_days(days_since_1970: Long): Date {
    var shifted = days_since_1970 + _days_from_year_0_march_to_1970
    var era = shifted / _days_in_400_years
    if shifted < 0 {
        era = (shifted - _last_day_of_era) / _days_in_400_years
    }
    var day_of_era = shifted - era * _days_in_400_years
    var year_of_era = (day_of_era - day_of_era / _days_in_4_common_years + day_of_era / _days_in_100_years - day_of_era / _last_day_of_era) / _days_in_common_year
    var day_of_year = day_of_era - (year_of_era * _days_in_common_year + year_of_era / 4 - year_of_era / 100)
    var shifted_month = (day_of_year * 5 + 2) / _days_in_march_to_july
    var day = day_of_year - (shifted_month * _days_in_march_to_july + 2) / 5 + 1
    var month = shifted_month + 3
    var year = year_of_era + era * _years_per_era
    if shifted_month >= 10 {
        month = shifted_month - 9
        year = year + 1
    }
    var year_count: Integer = year
    var month_count: Integer = month
    var day_count: Integer = day
    return Date(year_count, month_count, day_count)
}

func _is_leap(year: Integer): Boolean {
    return year % 4 == 0 and (year % 100 != 0 or year % _years_per_era == 0)
}

func _days_in(year: Integer, month: Integer): Integer {
    if month == 2 and _is_leap(year) {
        return 29
    }
    if month == 2 {
        return 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 {
        return 30
    }
    return 31
}
