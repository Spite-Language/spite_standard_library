# ../docs/memory.md#the-numbers

var _buffer = Buffer(8)
var _smallest_value_but_one: Long = -9223372036854775807
var _largest_value: Long = 9223372036854775807

func Long(from: String): Long? {
    var text = from.trim()
    var size = text._length
    var index = 0
    var negative = false
    if size > 0 and (text.byte_at(0) == 45 or text.byte_at(0) == 43) {
        negative = text.byte_at(0) == 45
        index = 1
    }
    var digits_start = index
    var value: Long = 0
    while index < size and text.byte_at(index) >= 48 and text.byte_at(index) <= 57 {
        var digit: Long? = text.byte_at(index) - 48
        var long_smallest = Long.Smallest()
        fallback value >= (long_smallest + digit) / 10
        value = value * 10 - digit
        index = index + 1
    }
    fallback index > digits_start and index == size
    if negative {
        return value
    }
    fallback value != Long.Smallest()
    return 0 - value
}

func Largest(): Long {
    return 9223372036854775807
}

func Smallest(): Long {
    var almost: Long = -9223372036854775807
    return almost - 1
}

# ../docs/memory.md#the-numbers
func _set_this(value: Long) {
    crash value >= _smallest_value_but_one - 1 and value <= _largest_value
    _buffer._write_long_at(0, value)
}

func _value(): Long {
    return _buffer._read_long_at(0)
}

func to_buffer(): Buffer {
    return _buffer._copy_first_bytes(8)
}

func absolute(): Long {
    var value = _value()
    if value >= 0 {
        return value
    }
    var zero: Long = 0
    return zero - value
}

func _bits_and(other: Long): Long

func _bits_or(other: Long): Long

func _bits_xor(other: Long): Long

func _bits_not(): Long

func _shifted_left(count: Integer): Long

func _shifted_right(count: Integer): Long

func _wrapping_sum(other: Long): Long

func _wrapping_subtract(other: Long): Long

func _wrapping_multiply(other: Long): Long

func bits_and(other: Long): Long {
    return _bits_and(other)
}

func bits_or(other: Long): Long {
    return _bits_or(other)
}

func bits_exclusive_or(other: Long): Long {
    return _bits_xor(other)
}

func bits_inverted(): Long {
    return _bits_not()
}

func shifted_left(count: Integer): Long {
    crash count >= 0
    fallback count < 64
    return _shifted_left(count)
}

func shifted_right(count: Integer): Long {
    crash count >= 0
    if count >= 64 {
        var almost = _shifted_right(63)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: Long): Long {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: Long): Long {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: Long): Long {
    return _wrapping_multiply(other)
}

func clamp(lowest: Long, highest: Long): Long {
    var value = _value()
    if value < lowest {
        value = lowest
    }
    if value > highest {
        value = highest
    }
    return value
}

func _bits_as_unsigned(): UnsignedLong

func bits_as_unsigned(): UnsignedLong {
    return _bits_as_unsigned()
}

func _bits_as_double(): Double

func bits_as_double(): Double {
    return _bits_as_double()
}

func sum(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: Long): Long {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Long): Long {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value: Long = _value()
    var made = String()
    made._append_whole(value)
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 64 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 63
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 64 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}

func _as_byte(): Byte {
    return _value()
}

func _as_tiny(): Tiny {
    return _value()
}

func _as_short(): Short {
    return _value()
}

func _as_unsigned_short(): UnsignedShort {
    return _value()
}

func _as_integer(): Integer {
    return _value()
}

func _as_unsigned_integer(): UnsignedInteger {
    return _value()
}

func _as_long(): Long {
    return _value()
}

func _as_unsigned_long(): UnsignedLong {
    return _value()
}

func _as_float(): Float {
    return _value()
}

func _as_double(): Double {
    return _value()
}
