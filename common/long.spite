# ../docs/memory.md#the-numbers

var _buffer = Buffer(8)

func _value(): Long {
    return _buffer._read_long_at(0)
}

func to_buffer(): Buffer {
    return _buffer.copy_first_bytes(8)
}

func to_boolean(): Boolean {
    return _value() != 0
}

func to_byte(): Byte {
    return _value()
}

func to_tiny(): Tiny {
    return _value()
}

func to_short(): Short {
    return _value()
}

func to_unsigned_short(): UnsignedShort {
    return _value()
}

func to_integer(): Integer {
    return _value()
}

func to_unsigned_integer(): UnsignedInteger {
    return _value()
}

func to_long(): Long {
    return _value()
}

func to_unsigned_long(): UnsignedLong {
    return _value()
}

func to_float(): Float {
    return _value()
}

func to_double(): Double {
    return _value()
}

func absolute(): Long {
    var value = _value()
    if value >= 0 {
        return value
    }
    var zero: Long = 0
    return zero - value
}

func _bits_and(other: Long): Long

func _bits_or(other: Long): Long

func _bits_xor(other: Long): Long

func _bits_not(): Long

func _shifted_left(count: Integer): Long

func _shifted_right(count: Integer): Long

func _wrapping_sum(other: Long): Long

func _wrapping_subtract(other: Long): Long

func _wrapping_multiply(other: Long): Long

func bits_and(other: Long): Long {
    return _bits_and(other)
}

func bits_or(other: Long): Long {
    return _bits_or(other)
}

func bits_exclusive_or(other: Long): Long {
    return _bits_xor(other)
}

func bits_inverted(): Long {
    return _bits_not()
}

func shifted_left(count: Integer): Long {
    crash count >= 0
    if count >= 64 {
        return 0
    }
    return _shifted_left(count)
}

func shifted_right(count: Integer): Long {
    crash count >= 0
    if count >= 64 {
        var almost = _shifted_right(63)
        return almost._shifted_right(1)
    }
    return _shifted_right(count)
}

func wrapping_sum(other: Long): Long {
    return _wrapping_sum(other)
}

func wrapping_subtract(other: Long): Long {
    return _wrapping_subtract(other)
}

func wrapping_multiply(other: Long): Long {
    return _wrapping_multiply(other)
}

func clamp(lowest: Long, highest: Long): Long {
    crash lowest <= highest
    var value = _value()
    if value < lowest {
        return lowest
    }
    if value > highest {
        return highest
    }
    return value
}

func _bits_as_unsigned(): UnsignedLong

func bits_as_unsigned(): UnsignedLong {
    return _bits_as_unsigned()
}

func get_largest(): Long {
    return 9223372036854775807
}

func get_smallest(): Long {
    var almost: Long = -9223372036854775807
    return almost - 1
}

func _bits_as_double(): Double

func bits_as_double(): Double {
    return _bits_as_double()
}

func sum(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left + right
}

func subtract(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left - right
}

func multiply(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left * right
}

func divide(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left / right
}

func remainder(other: Long): Long {
    var left = _value()
    var right = other._value()
    return left % right
}

func minimum(other: Long): Long {
    var left = _value()
    var right = other._value()
    if left < right {
        return left
    }
    return right
}

func maximum(other: Long): Long {
    var left = _value()
    var right = other._value()
    if left > right {
        return left
    }
    return right
}

func equals(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left == right
}

func less_than(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left < right
}

func greater_than(other: Long): Boolean {
    var left = _value()
    var right = other._value()
    return left > right
}

func to_string(): String {
    var value = _value()
    if value == 0 {
        return "0"
    }
    var negative = value < 0
    var digits = Buffer(20)
    while value != 0 {
        var left_over = value % 10
        var code: Integer = left_over
        if code < 0 {
            code = 0 - code
        }
        digits.append(code + 48)
        value = value / 10
    }
    var made = ""
    if negative {
        made.append_code(45)
    }
    var index = digits.count() - 1
    while index >= 0 {
        var digit = digits._read_byte_at(index)
        made.append_code(digit)
        index = index - 1
    }
    return made
}

func to_debug(): String {
    return to_string()
}

func set_bit_count(): Integer {
    var count = 0
    var index = 0
    while index < 64 {
        if _bit_at(index) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func leading_zero_count(): Integer {
    var count = 0
    var index = 63
    while index >= 0 and not _bit_at(index) {
        count = count + 1
        index = index - 1
    }
    return count
}

func trailing_zero_count(): Integer {
    var count = 0
    while count < 64 and not _bit_at(count) {
        count = count + 1
    }
    return count
}

func _bit_at(index: Integer): Boolean {
    var moved = _shifted_right(index)
    var lowest = moved._bits_and(1)
    return lowest == 1
}
