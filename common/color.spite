var red: Float = 0.0
var green: Float = 0.0
var blue: Float = 0.0
var alpha: Float = 1.0

func Color(new_red: Float, new_green: Float, new_blue: Float, new_alpha: Float) {
    red = new_red
    green = new_green
    blue = new_blue
    alpha = new_alpha
}

func equals(other: Color): Boolean {
    return red == other.red and green == other.green and blue == other.blue and alpha == other.alpha
}

func linear_interpolate(target: Color, amount: Float): Color {
    var red_part = red + (target.red - red) * amount
    var green_part = green + (target.green - green) * amount
    var blue_part = blue + (target.blue - blue) * amount
    var alpha_part = alpha + (target.alpha - alpha) * amount
    return Color(red_part, green_part, blue_part, alpha_part)
}

func to_linear(): Color {
    var linear_red = _channel_to_linear(red)
    var linear_green = _channel_to_linear(green)
    var linear_blue = _channel_to_linear(blue)
    return Color(linear_red, linear_green, linear_blue, alpha)
}

func to_standard_rgb(): Color {
    var standard_red = _channel_to_standard(red)
    var standard_green = _channel_to_standard(green)
    var standard_blue = _channel_to_standard(blue)
    return Color(standard_red, standard_green, standard_blue, alpha)
}

func _channel_to_linear(channel: Float): Float {
    if channel <= 0.04045 {
        return channel / 12.92
    }
    var shifted = (channel + 0.055) / 1.055
    return shifted.power(2.4)
}

func _channel_to_standard(channel: Float): Float {
    if channel <= 0.0031308 {
        return channel * 12.92
    }
    var raised = channel.power(0.41666666)
    return 1.055 * raised - 0.055
}

func to_hexadecimal_string(): String {
    var red_text = _byte_hex(red)
    var green_text = _byte_hex(green)
    var blue_text = _byte_hex(blue)
    var text = "#{red_text}{green_text}{blue_text}"
    var alpha_byte = _byte_of(alpha)
    if alpha_byte == 255 {
        return text
    }
    var alpha_text = _byte_hex(alpha)
    return "{text}{alpha_text}"
}

func to_rgb_string(): String {
    var red_byte = _byte_of(red)
    var green_byte = _byte_of(green)
    var blue_byte = _byte_of(blue)
    var alpha_byte = _byte_of(alpha)
    if alpha_byte == 255 {
        return "rgb({red_byte}, {green_byte}, {blue_byte})"
    }
    var alpha_rounded = _rounded(alpha, 1000.0)
    return "rgba({red_byte}, {green_byte}, {blue_byte}, {alpha_rounded})"
}

func to_hsl_string(): String {
    var highest = red.maximum(green)
    highest = highest.maximum(blue)
    var lowest = red.minimum(green)
    lowest = lowest.minimum(blue)
    var lightness = (highest + lowest) * 0.5
    var spread = highest - lowest
    var saturation = 0.0
    var hue = 0.0
    if spread > 0.0 {
        var centered = 2.0 * lightness - 1.0
        var centered_size = centered.absolute()
        var denominator = 1.0 - centered_size
        saturation = spread / denominator
        hue = _hue_of(highest, spread)
    }
    var hue_text = _rounded(hue, 10.0)
    var saturation_text = _rounded(saturation * 100.0, 10.0)
    var lightness_text = _rounded(lightness * 100.0, 10.0)
    var alpha_byte = _byte_of(alpha)
    if alpha_byte == 255 {
        return "hsl({hue_text}, {saturation_text}%, {lightness_text}%)"
    }
    var alpha_rounded = _rounded(alpha, 1000.0)
    return "hsla({hue_text}, {saturation_text}%, {lightness_text}%, {alpha_rounded})"
}

func _hue_of(highest: Float, spread: Float): Float {
    var sector = 0.0
    if highest == red {
        sector = (green - blue) / spread
        if sector < 0.0 {
            sector = sector + 6.0
        }
    } else if highest == green {
        sector = (blue - red) / spread + 2.0
    } else {
        sector = (red - green) / spread + 4.0
    }
    return sector * 60.0
}

func _byte_of(channel: Float): Integer {
    crash channel == channel
    var held = channel.clamp(0.0, 1.0)
    var scaled = held * 255.0
    var rounded = scaled.round()
    return rounded.to_integer()
}

func _byte_hex(channel: Float): String {
    var digits = "0123456789abcdef"
    var whole = _byte_of(channel)
    var high = whole / 16
    var low = whole % 16
    var high_digit = digits[high]
    var low_digit = digits[low]
    crash high_digit and low_digit
    return "{high_digit}{low_digit}"
}

func _rounded(value: Float, steps: Float): Float {
    var scaled = value * steps
    var whole = scaled.round()
    return whole / steps + 0.0
}

func to_string(): String {
    return to_hexadecimal_string()
}

func _four(first: Float, second: Float, third: Float, fourth: Float): List<Float> {
    var channels = List<Float>()
    channels.append(first)
    channels.append(second)
    channels.append(third)
    channels.append(fourth)
    return channels
}

func _channels_of(text: String): List<Float>? {
    var trimmed = text.trim()
    var cleaned = trimmed.lower_case()
    if cleaned.starts_with("#") {
        return _read_hex(cleaned)
    }
    if cleaned.starts_with("rgb") or cleaned.starts_with("hsl") {
        return _read_function(cleaned)
    }
    var named = named_hex(cleaned)
    var unnamed = named.is_empty()
    assert not unnamed
    return _read_hex(named)
}

func _read_hex(text: String): List<Float>? {
    var text_length = text.length()
    var digits = text.slice(1, text_length)
    crash digits
    var count = digits.length()
    assert count == 3 or count == 4 or count == 6 or count == 8
    var valid = _all_hex(digits)
    assert valid
    if count <= 4 {
        var short_red = _hex_value(digits, 0) * 17
        var short_green = _hex_value(digits, 1) * 17
        var short_blue = _hex_value(digits, 2) * 17
        var short_alpha = 255
        if count == 4 {
            short_alpha = _hex_value(digits, 3) * 17
        }
        return _from_bytes(short_red, short_green, short_blue, short_alpha)
    }
    var long_red = _hex_pair(digits, 0)
    var long_green = _hex_pair(digits, 2)
    var long_blue = _hex_pair(digits, 4)
    var long_alpha = 255
    if count == 8 {
        long_alpha = _hex_pair(digits, 6)
    }
    return _from_bytes(long_red, long_green, long_blue, long_alpha)
}

func _hex_pair(digits: String, position: Integer): Integer {
    var high = _hex_value(digits, position)
    var low = _hex_value(digits, position + 1)
    return high * 16 + low
}

func _all_hex(digits: String): Boolean {
    var index = 0
    var valid = true
    var digit_count = digits.length()
    while valid and index < digit_count {
        var value = _hex_value(digits, index)
        valid = value >= 0
        index = index + 1
    }
    return valid
}

func _hex_value(digits: String, position: Integer): Integer {
    var code = digits.byte_at(position)
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    return -1
}

func _from_bytes(red_byte: Integer, green_byte: Integer, blue_byte: Integer, alpha_byte: Integer): List<Float> {
    var red_share: Float = red_byte
    var green_share: Float = green_byte
    var blue_share: Float = blue_byte
    var alpha_share: Float = alpha_byte
    return _four(red_share / 255.0, green_share / 255.0, blue_share / 255.0, alpha_share / 255.0)
}

func _read_function(text: String): List<Float>? {
    var open = text.index_of("(")
    assert open
    var closed = text.ends_with(")")
    assert closed
    var function_name = text.slice(0, open)
    crash function_name
    var is_hue = function_name == "hsl" or function_name == "hsla"
    assert is_hue or function_name == "rgb" or function_name == "rgba"
    var text_length = text.length()
    var inside = text.slice(open + 1, text_length - 1)
    crash inside
    var commas_removed = inside.replace(",", " ")
    var spaced = commas_removed.replace("/", " ")
    var parts = _pieces(spaced)
    var part_count = parts.count()
    assert part_count == 3 or part_count == 4
    var first = parts[0]
    var second = parts[1]
    var third = parts[2]
    crash first
    crash second
    crash third
    var alpha_read = 1.0
    if part_count == 4 {
        var fourth = parts[3]
        crash fourth
        var alpha_share = _fraction(fourth, 1.0)
        assert alpha_share
        var alpha_value: Float = alpha_share
        alpha_read = alpha_value
    }
    if is_hue {
        var hue = _number_of(first)
        var saturation = _fraction(second, 100.0)
        var lightness = _fraction(third, 100.0)
        assert hue
        assert saturation
        assert lightness
        var hue_degrees: Float = hue
        var saturation_share: Float = saturation
        var lightness_share: Float = lightness
        return _from_hue(hue_degrees, saturation_share, lightness_share, alpha_read)
    }
    var red_read = _fraction(first, 255.0)
    var green_read = _fraction(second, 255.0)
    var blue_read = _fraction(third, 255.0)
    assert red_read
    assert green_read
    assert blue_read
    var red_share: Float = red_read
    var green_share: Float = green_read
    var blue_share: Float = blue_read
    return _four(red_share, green_share, blue_share, alpha_read)
}

func _pieces(spaced: String): List<String> {
    var split_pieces = spaced.split(" ")
    var kept = List<String>()
    var index = 0
    while index < split_pieces.count() {
        var piece = split_pieces[index]
        var empty = piece.is_empty()
        if not empty {
            kept.append(piece)
        }
        index = index + 1
    }
    return kept
}

func _without_unit(part: String): String {
    var part_length = part.length()
    if part.ends_with("%") {
        var sliced = part.slice(0, part_length - 1)
        crash sliced
        return sliced
    }
    if part.ends_with("deg") {
        var sliced = part.slice(0, part_length - 3)
        crash sliced
        return sliced
    }
    return part
}

func _number_of(part: String): Float? {
    var body = _without_unit(part)
    return body.to_float()
}

func _fraction(part: String, whole: Float): Float? {
    var value = _number_of(part)
    assert value
    var share = value / whole
    if part.ends_with("%") {
        share = value / 100.0
    }
    return share.clamp(0.0, 1.0)
}

func _from_hue(hue: Float, saturation: Float, lightness: Float, alpha_part: Float): List<Float> {
    var turns = hue / 360.0
    var whole_turns = turns.floor()
    var sector = (turns - whole_turns) * 6.0
    var centered = 2.0 * lightness - 1.0
    var centered_size = centered.absolute()
    var lightness_share = 1.0 - centered_size
    var chroma = lightness_share * saturation
    var half_sector = sector * 0.5
    var half_floor = half_sector.floor()
    var within_pair = (half_sector - half_floor) * 2.0
    var sector_share = within_pair - 1.0
    var sector_size = sector_share.absolute()
    var middle = chroma * (1.0 - sector_size)
    var red_part = 0.0
    var green_part = 0.0
    var blue_part = 0.0
    if sector < 1.0 {
        red_part = chroma
        green_part = middle
    } else if sector < 2.0 {
        red_part = middle
        green_part = chroma
    } else if sector < 3.0 {
        green_part = chroma
        blue_part = middle
    } else if sector < 4.0 {
        green_part = middle
        blue_part = chroma
    } else if sector < 5.0 {
        red_part = middle
        blue_part = chroma
    } else {
        red_part = chroma
        blue_part = middle
    }
    var lift = lightness - chroma * 0.5
    return _four(red_part + lift, green_part + lift, blue_part + lift, alpha_part)
}

