singleton

type Printable {
    to_string(): String
}

type Debuggable {
    to_debug(): String
}

var library = DynamicLibrary("ucrtbase.dll")

func print(...values: List<Printable>) {
    _write_values(values, 1)
    _write_to("\n", 1)
}

func write(...values: List<Printable>) {
    _write_values(values, 1)
}

func error(...values: List<Printable>) {
    _write_values(values, 2)
    _write_to("\n", 2)
}

func debug(...values: List<Debuggable>) {
    var index = 0
    while index < values.count() {
        if index > 0 {
            _write_to(" ", 1)
        }
        var value = values[index]
        var text = value.to_debug()
        _write_to(text, 1)
        index = index + 1
    }
    _write_to("\n", 1)
}

func _write_values(values: List<Printable>, stream: Integer) {
    var index = 0
    while index < values.count() {
        if index > 0 {
            _write_to(" ", stream)
        }
        var value = values[index]
        var text = value.to_string()
        _write_to(text, stream)
        index = index + 1
    }
}

func _write_to(text: String, stream: Integer) {
    var length = text.length()
    library._write(stream, text, length)
}
