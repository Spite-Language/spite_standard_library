singleton

type Printable {
    to_string(): String
}

type Debuggable {
    to_debug(): String
}

var library = DynamicLibrary("ucrtbase.dll", 'identity', "")

func print(...values: List<Printable>) {
    var line = _line_of(values)
    _write_to("{line}\n", 1)
}

func write(...values: List<Printable>) {
    var line = _line_of(values)
    _write_to(line, 1)
}

func error(...values: List<Printable>) {
    var line = _line_of(values)
    _write_to("{line}\n", 2)
}

func debug(...values: List<Debuggable>) {
    var line = ""
    var index = 0
    while index < values.count() {
        var value = values[index]
        var text = value.to_debug()
        if index > 0 {
            line = "{line} {text}"
        } else {
            line = text
        }
        index = index + 1
    }
    _write_to("{line}\n", 1)
}

func _line_of(values: List<Printable>): String {
    var line = ""
    var index = 0
    while index < values.count() {
        var value = values[index]
        var text = value.to_string()
        if index > 0 {
            line = "{line} {text}"
        } else {
            line = text
        }
        index = index + 1
    }
    return line
}

func _write_to(text: String, stream: Integer) {
    var length = text.length()
    library._write(stream, text, length)
}
