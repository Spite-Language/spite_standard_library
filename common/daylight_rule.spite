var _standard_offset = 0
var _daylight_offset = 0
var _start = DaylightChange('day_of_year', 0, 0)
var _end = DaylightChange('day_of_year', 0, 0)
var _has_daylight = false

func DaylightRule(standard_offset: Integer) {
    _standard_offset = standard_offset
    _daylight_offset = standard_offset
}

func observe_daylight(daylight_offset: Integer, start: DaylightChange, end: DaylightChange) {
    _daylight_offset = daylight_offset
    _start = start
    _end = end
    _has_daylight = true
}

func offset_seconds_at(unix_seconds: Long): Integer {
    if not _has_daylight {
        return _standard_offset
    }
    var standard_offset: Long = _standard_offset
    var daylight_offset: Long = _daylight_offset
    var local_seconds = unix_seconds + standard_offset
    var second_of_day = local_seconds % 86400
    if second_of_day < 0 {
        second_of_day = second_of_day + 86400
    }
    var first_day = Date(1970, 1, 1)
    var days_long = (local_seconds - second_of_day) / 86400
    var days = days_long.to_integer()
    var date = first_day + Period(days, 'days')
    var year = date.year
    var start_local = _start.local_seconds_in(year)
    var end_local = _end.local_seconds_in(year)
    var start = start_local - standard_offset
    var end = end_local - daylight_offset
    var in_daylight = unix_seconds >= start and unix_seconds < end
    if end < start {
        in_daylight = unix_seconds < end or unix_seconds >= start
    }
    if in_daylight {
        return _daylight_offset
    }
    return _standard_offset
}
