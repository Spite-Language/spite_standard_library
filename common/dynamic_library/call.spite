# https://github.com/Spite-Language/spite_documentation/blob/master/foreign_libraries.md#calling-a-declared-function
var _declaration: DynamicLibrary.FunctionDeclaration

func Call(starting_declaration: DynamicLibrary.FunctionDeclaration) {
    _declaration = starting_declaration
}

func call()

func get_declaration(): DynamicLibrary.FunctionDeclaration {
    return _declaration
}
