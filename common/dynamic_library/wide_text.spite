# https://github.com/Spite-Language/spite_documentation/blob/master/foreign_libraries.md#rooms
var text: String

func WideText(room: Buffer, count: Integer) {
    room._take_written(count * 2)
    var read = room._read_wide_string_at(0, count)
    crash read
    text = read
}

func to_string(): String {
    return text
}
