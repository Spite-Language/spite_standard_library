singleton

# https://github.com/Spite-Language/spite_documentation/blob/master/foreign_libraries.md#rooms
enum Sizing {
    'answer_is_the_size_needed'
    'doubled_until_it_fits'
    'asked_with_no_room_first'
    'answer_is_what_arrived'
    'fixed_size'
}

# https://github.com/Spite-Language/spite_documentation/blob/master/foreign_libraries.md#declaring-a-foreign-function
var handle: Long = 0
var file_name: String
var header_file_name: String

func DynamicLibrary(library_file_name: String, header: String) {
    file_name = library_file_name
    header_file_name = header
    handle = open_library(library_file_name)
}

func open_library(library_file_name: String): Long

func close_library(library_handle: Long)

func drop() {
    close_library(handle)
}

func to_debug(): String {
    return "DynamicLibrary {file_name}"
}
