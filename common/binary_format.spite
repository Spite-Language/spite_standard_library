singleton


generic $value_type

func write(value: $value_type, output: BinaryWriterCursor) {
    if $value_type == Null {
        write_present(value, output)
    } else if $value_type == Boolean {
        var flag = 0
        if value {
            flag = 1
        }
        output.write_byte(flag)
    } else if $value_type == Byte or $value_type == Tiny {
        output.write_byte(value)
    } else if $value_type == Short or $value_type == UnsignedShort {
        output.write_short(value)
    } else if $value_type == Integer {
        output.write_integer(value)
    } else if $value_type == UnsignedInteger {
        var bits = value.bits_as_signed()
        output.write_integer(bits)
    } else if $value_type == Long {
        output.write_long(value)
    } else if $value_type == UnsignedLong {
        var bits = value.bits_as_signed()
        output.write_long(bits)
    } else if $value_type == Float {
        output.write_float(value)
    } else if $value_type == Double {
        output.write_double(value)
    } else if $value_type == String {
        output.write_text(value)
    } else if $value_type == Symbol {
        write_symbol(value, output)
    } else if $value_type == List {
        write_list(value, output)
    } else if $value_type == Dictionary {
        write_dictionary(value, output)
    } else {
        write_attributes(value, output)
    }
}


func write_symbol(shown: $value_type, output: BinaryWriterCursor) {
    if $value_type == Enum {
        var values = $value_type.values
        var place = values.index_of(shown)
        crash place
        output.walked = values.count()
        output.found = place
        output.write_index()
        return
    }
    var name: String = shown
    output.write_text(name)
}

func write_list(value: $value_type, output: BinaryWriterCursor) {
    var count = value.count()
    output.write_count(count)
    var element = BinaryFormat<$value_type.element_type>()
    var index = 0
    while index < count {
        var item = value[index]
        element.write(item, output)
        index = index + 1
    }
}

func write_dictionary(value: $value_type, output: BinaryWriterCursor) {
    var keys = value.keys()
    var entries = value.values()
    var count = keys.count()
    output.write_count(count)
    var entry = BinaryFormat<$value_type.value_type>()
    var key_format = BinaryFormat<$value_type.key_type>()
    var index = 0
    while index < keys.count() and index < entries.count() {
        var key = keys[index]
        key_format.write(key, output)
        var item = entries[index]
        entry.write(item, output)
        index = index + 1
    }
}

func write_attribute(attribute: Spite.AttributeDeclaration, value: $value_type, output: BinaryWriterCursor) {
    var name = attribute.name
    assert not name.starts_with("_")
    assert not attribute.class.is_singleton
    var format = BinaryFormat<attribute.class>()
    format.write(value[attribute], output)
}

func write_present(value: $value_type, output: BinaryWriterCursor) {
    if value {
        output.write_byte(1)
        var inner = BinaryFormat<$value_type.value_type>()
        inner.write(value, output)
        return
    }
    output.write_byte(0)
}

func read(input: BinaryCursor): $value_type {
    if $value_type == Null {
        return read_present(input)
    } else if $value_type == Boolean {
        var flag = input.read_byte()
        if flag > 1 {
            input.fail()
        }
        return flag == 1
    } else if $value_type == Byte {
        var stored = input.read_byte()
        return stored.to_byte()
    } else if $value_type == Tiny {
        var stored = input.read_byte()
        if stored > 127 {
            stored = stored - 256
        }
        return stored.to_tiny()
    } else if $value_type == Short {
        var stored = input.read_short()
        return stored.to_short()
    } else if $value_type == UnsignedShort {
        var stored = input.read_unsigned_short()
        return stored.to_unsigned_short()
    } else if $value_type == Integer {
        return input.read_integer()
    } else if $value_type == UnsignedInteger {
        var whole = input.read_integer()
        return whole.bits_as_unsigned()
    } else if $value_type == Long {
        return input.read_long()
    } else if $value_type == UnsignedLong {
        var long = input.read_long()
        return long.bits_as_unsigned()
    } else if $value_type == Float {
        return input.read_float()
    } else if $value_type == Double {
        return input.read_double()
    } else if $value_type == String {
        return input.read_text()
    } else if $value_type == Symbol {
        return read_symbol(input)
    } else if $value_type == List {
        return read_list(input)
    } else if $value_type == Dictionary {
        return read_dictionary(input)
    } else {
        var created = made()
        read_attributes(created, input)
        return created
    }
}

func read_present(input: BinaryCursor): $value_type {
    var flag = input.read_byte()
    if flag != 1 {
        if flag != 0 {
            input.fail()
        }
        return null
    }
    var inner = BinaryFormat<$value_type.value_type>()
    return inner.read(input)
}

func read_symbol(input: BinaryCursor): $value_type {
    if $value_type == Enum {
        var values = $value_type.values
        input.walked = values.count()
        input.read_index()
        var chosen = values[input.found]
        if chosen and not input.failed {
            return chosen
        }
        input.fail()
        return $value_type()
    }
    var name = input.read_text()
    var found = Symbol(name)
    if not found {
        input.fail()
        return input.class.name
    }
    return found
}

func read_list(input: BinaryCursor): $value_type {
    var list = $value_type()
    var count = input.read_count()
    var element = BinaryFormat<$value_type.element_type>()
    var index = 0
    while index < count and not input.failed {
        var item = element.read(input)
        list.append(item)
        index = index + 1
    }
    return list
}

func read_dictionary(input: BinaryCursor): $value_type {
    var dictionary = $value_type()
    var count = input.read_count()
    var entry = BinaryFormat<$value_type.value_type>()
    var key_format = BinaryFormat<$value_type.key_type>()
    var index = 0
    while index < count and not input.failed {
        var key = key_format.read(input)
        var item = entry.read(input)
        dictionary[key] = item
        index = index + 1
    }
    return dictionary
}

func read_attribute(attribute: Spite.AttributeDeclaration, created: $value_type, input: BinaryCursor) {
    var name = attribute.name
    assert not name.starts_with("_")
    assert not attribute.class.is_singleton
    var format = BinaryFormat<attribute.class>()
    created[attribute] = format.read(input)
}

func made(): $value_type {
    return $value_type()
}
