var _bytes = Buffer(0)

func MappedFile(bytes: Buffer) {
    _bytes = bytes
}

func size(): Long {
    return _bytes.count()
}

func get_at(position: Long): Byte? {
    assert _holds(position, 1)
    var index = position.to_integer()
    return _bytes[index]
}

func read_short_little_endian_at(position: Long): Short? {
    assert _holds(position, 2)
    var index = position.to_integer()
    return _bytes.read_short_little_endian_at(index)
}

func read_integer_little_endian_at(position: Long): Integer? {
    assert _holds(position, 4)
    var index = position.to_integer()
    return _bytes.read_integer_little_endian_at(index)
}

func read_long_little_endian_at(position: Long): Long? {
    assert _holds(position, 8)
    var index = position.to_integer()
    return _bytes.read_long_little_endian_at(index)
}

func read_float_little_endian_at(position: Long): Float? {
    assert _holds(position, 4)
    var index = position.to_integer()
    return _bytes.read_float_little_endian_at(index)
}

func read_double_little_endian_at(position: Long): Double? {
    assert _holds(position, 8)
    var index = position.to_integer()
    return _bytes.read_double_little_endian_at(index)
}

func read_bytes_at(position: Long, count: Integer): Buffer? {
    crash count >= 0
    assert _holds(position, count)
    var index = position.to_integer()
    return _bytes.read_bytes_at(index, count)
}

func text(position: Long, count: Integer): String? {
    crash count >= 0
    assert _holds(position, count)
    var index = position.to_integer()
    return _bytes.text(index, count)
}

func _holds(position: Long, width: Long): Boolean {
    var size_now: Long = _bytes.count()
    return position >= 0 and position <= size_now - width
}
