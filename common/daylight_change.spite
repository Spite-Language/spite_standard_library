enum Kind {
    'day_of_year'
    'day_of_year_without_leap_day'
    'weekday_of_month'
}

var _kind: Kind = 'day_of_year'
var _month = 1
var _week = 1
var _weekday = 0
var _day = 0
var _time_seconds = 7200

func DaylightChange(kind: Kind, day: Integer, time_seconds: Integer) {
    _kind = kind
    _day = day
    _time_seconds = time_seconds
}

func on_weekday_of_month(month: Integer, week: Integer, weekday: Integer) {
    _kind = 'weekday_of_month'
    _month = month
    _week = week
    _weekday = weekday
}

func local_seconds_in(year: Integer): Long {
    var day = _day_since_1970(year)
    var time_seconds: Long = _time_seconds
    return day * 86400 + time_seconds
}

func _day_since_1970(year: Integer): Long {
    if _kind == 'weekday_of_month' {
        var first = Date(year, _month, 1)
        var first_since_1970 = first.days_since_1970
        var first_weekday_long = (first_since_1970 % 7 + 11) % 7
        var first_weekday = first_weekday_long.to_integer()
        var day = 1 + (_weekday - first_weekday + 7) % 7 + (_week - 1) * 7
        var days_in_month = first.days_in_month
        while day > days_in_month {
            day = day - 7
        }
        var day_long: Long = day
        return first_since_1970 + day_long - 1
    }
    var january = Date(year, 1, 1)
    var since_1970 = january.days_since_1970
    var day_of_year: Long = _day
    if _kind == 'day_of_year_without_leap_day' and january.is_leap_year and _day >= 60 {
        return since_1970 + day_of_year
    }
    if _kind == 'day_of_year_without_leap_day' {
        return since_1970 + day_of_year - 1
    }
    return since_1970 + day_of_year
}
